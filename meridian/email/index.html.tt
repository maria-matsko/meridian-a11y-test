[% WRAPPER '_assets/master.html.tt'
    page_title = 'Email'
    page_id    = 'email'
%]
<style>
/* ===================================================================
   EMAIL PAGE -- SPECIFIC STYLES
   =================================================================== */

/* Page header, stats, filter bar, filter chips — all in meridian.css */

/* Email-specific stat card icon colors */
.stat-card-icon.accounts { background: var(--feature-bg); color: var(--feature-color); }
.stat-card-icon.storage { background: var(--accent-subtle); color: var(--text-brand); }
.stat-card-icon.forwarders { background: var(--status-info-bg); color: var(--status-info); }
.stat-card-icon.autoresponders { background: var(--status-success-bg); color: var(--status-success); }

/* Email table */
.email-table {
  width: 100%; border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-surface);
}
.email-table-head {
  display: grid;
  grid-template-columns: 36px 1fr 140px 180px 90px 90px;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
  background: var(--bg-muted);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide);
  color: var(--text-tertiary); text-transform: uppercase;
}
.email-table-head .sortable {
  cursor: pointer; user-select: none;
  display: flex; align-items: center; gap: var(--space-1);
  transition: color var(--duration-fast) var(--ease-out);
}
.email-table-head .sortable:hover { color: var(--text-secondary); }
.email-table-head .sort-icon { font-size: var(--text-xs); opacity: 0.4; transition: opacity var(--duration-fast) var(--ease-out); }
.email-table-head .sort-icon.active { opacity: 1; color: var(--accent); }
.email-row {
  display: grid;
  grid-template-columns: 36px 1fr 140px 180px 90px 90px;
  gap: var(--space-4);
  align-items: center;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  transition: background var(--duration-fast) var(--ease-out);
  cursor: pointer;
}
.email-row:last-child { border-bottom: none; }
.email-row:hover { background: var(--bg-hover); }

.email-name {
  display: flex; align-items: center; gap: var(--space-3); min-width: 0;
}
.email-icon {
  width: 36px; height: 36px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--text-md); flex-shrink: 0;
  background: var(--feature-bg); color: var(--feature-color);
}
.email-name-text {
  font-weight: var(--weight-semibold); font-size: var(--text-sm);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.email-cell {
  font-size: var(--text-sm); color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.email-actions { display: flex; justify-content: flex-end; }

/* Storage progress bar */
/* .storage-bar is in meridian.css */
.storage-text {
  font-size: var(--text-xs); color: var(--text-tertiary);
}

/* Pagination, detail views, site-info, settings, list-items — all in meridian.css */

/* ===================================================================
   RESPONSIVE (email-specific)
   =================================================================== */

@media (max-width: 1024px) {
  .email-table-head, .email-row {
    grid-template-columns: 36px 1fr 180px 90px 90px;
  }
  .email-table-head > *:nth-child(3),
  .email-row > *:nth-child(3) { display: none; }
}

@media (max-width: 768px) {
  .email-table-head, .email-row {
    grid-template-columns: 36px 1fr 90px 90px;
  }
  .email-table-head > *:nth-child(4),
  .email-row > *:nth-child(4) { display: none; }
}

/* Modern Email Grid */
.email-grid-modern .data-list-head,
.email-grid-modern .data-list-row {
  grid-template-columns: 1fr 120px 90px 80px 80px;
  gap: var(--space-4);
}
.storage-mini { display: flex; align-items: center; gap: var(--space-2); }
.storage-mini-bar { width: 40px; height: 4px; background: var(--bg-muted); border-radius: var(--radius-full); overflow: hidden; flex-shrink: 0; }
.storage-mini-fill { height: 100%; border-radius: var(--radius-full); background: var(--accent); }
.btn-manage { padding: 3px 10px; font-size: var(--text-xs); font-weight: var(--weight-medium); background: transparent; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-secondary); cursor: pointer; font-family: var(--font-body); transition: all var(--duration-fast) var(--ease-out); }
.btn-manage:hover { border-color: var(--border-default); color: var(--text-primary); background: var(--bg-hover); }
.account-detail { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-4); }
.account-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
.account-field-label { font-size: var(--text-xs); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: var(--tracking-wide); font-weight: var(--weight-semibold); margin-bottom: var(--space-1); }
.account-field-value { font-size: var(--text-sm); }

@media (max-width: 768px) {
  .email-grid-modern .data-list-head { display: none; }
  .email-grid-modern .data-list-row { grid-template-columns: 1fr auto; }
  .account-detail-grid { grid-template-columns: 1fr; }
}

/* Filter editor */
.filter-rule-row select,
.filter-action-row select { font-size: var(--text-sm); }
@media (max-width: 768px) {
  .filter-rule-row, .filter-action-row { flex-direction: column; align-items: stretch; }
  .filter-rule-row select, .filter-action-row select { width: 100%; }
}
</style>


<a href="#main-content" class="sr-only">Skip to main content</a>

<div class="layout-shell">

  <!-- Header -->
  <meridian-header></meridian-header>

  <!-- Sidebar -->
  <meridian-sidebar active="email"></meridian-sidebar>

  <!-- Main Content -->
  <main class="layout-main" id="main-content">
    <div class="main-content">

      <!-- All page content hidden until data is ready -->
      <div id="pageContent" style="display:none;">

        <!-- Page header -->
        <div class="page-header animate-in stagger-1" id="pageHeader">
          <div class="page-header-left">
            <div>
              <h1 class="page-title" data-t>Email Accounts</h1>
              <div class="page-subtitle" data-t>Manage email accounts, forwarders, and settings</div>
            </div>
          </div>
          <div class="page-header-right">
            <button type="button" class="btn btn-primary" id="createAccountBtn">
              <i class="ri-add-line" aria-hidden="true"></i> <span data-t>Create Account</span>
            </button>
          </div>
        </div>

        <!-- Email List (modern domain-grouped view) -->
        <div class="filter-bar animate-in stagger-2" style="margin-bottom:var(--space-4);">
          <div class="filter-search">
            <i class="ri-search-line" aria-hidden="true"></i>
            <input type="search" placeholder="Filter by domain or email..." id="modernEmailSearch" aria-label="Filter email accounts" data-t-placeholder>
          </div>
          <button type="button" class="filter-chip" id="toggleAllEmailGroups" onclick="modernToggleAllEmailGroups()">
            <i class="ri-expand-up-down-line" aria-hidden="true"></i> <span data-t>Expand All</span>
          </button>
        </div>
        <div class="data-list email-grid-modern" id="modernEmailList" role="table"></div>

        <div id="modernAccountView" style="display:none;">
          <button class="detail-back" id="modernBackToEmail" type="button">
            <i class="ri-arrow-left-s-line" aria-hidden="true"></i> <span data-t>Email</span>
          </button>
          <div id="modernAccountDetail"></div>
        </div>

      </div><!-- /pageContent -->

      <!-- Detail View -->
      <div class="detail-view" id="detailView" style="display:none;">
        <button class="detail-back" onclick="closeDetail()" type="button">
          <i class="ri-arrow-left-line" aria-hidden="true"></i> <span data-t>Back to Email Accounts</span>
        </button>

        <div class="detail-hero">
          <div class="detail-hero-left">
            <div class="email-icon detail-hero-icon" id="detailIcon"><i class="ri-mail-line" aria-hidden="true"></i></div>
            <div>
              <h1 class="detail-hero-title" id="detailTitle">info@example.com</h1>
              <div class="detail-hero-badges" id="detailBadges"></div>
            </div>
          </div>
          <div class="detail-hero-actions" id="detailActions"></div>
        </div>

        <div class="detail-tabs-bar" id="detailTabsBar" role="tablist"></div>
        <div id="detailTabContent"></div>
      </div>

    </div>
  </main>
</div>

<!-- Filter Editor Modal -->
<div class="modal-overlay" id="filterEditorOverlay" role="dialog" aria-modal="true" aria-labelledby="filterEditorTitle">
  <div class="modal" style="max-width: 640px;">
    <div class="modal-header">
      <h2 class="t-heading t-heading-md" id="filterEditorTitle" data-t>Add Filter</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeFilterEditor()">
        <i class="ri-close-line" aria-hidden="true"></i>
      </button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label" for="filterName" data-t>Filter Name</label>
        <input type="text" id="filterName" class="form-input" placeholder="e.g. Block spam senders" required>
      </div>

      <div style="margin-bottom:var(--space-4);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-2);">
          <div class="form-label" style="margin-bottom:0;" data-t>Rules</div>
          <button type="button" class="btn btn-ghost btn-sm" onclick="addFilterRule()"><i class="ri-add-line" aria-hidden="true"></i> <span data-t>Add Rule</span></button>
        </div>
        <div id="filterRules"></div>
      </div>

      <div>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-2);">
          <div class="form-label" style="margin-bottom:0;" data-t>Actions</div>
          <button type="button" class="btn btn-ghost btn-sm" onclick="addFilterAction()"><i class="ri-add-line" aria-hidden="true"></i> <span data-t>Add Action</span></button>
        </div>
        <div id="filterActions"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeFilterEditor()" data-t>Cancel</button>
      <button type="button" class="btn btn-primary" id="filterSaveBtn" onclick="saveFilter()" data-t>Save Filter</button>
    </div>
  </div>
</div>

<div id="confirmContainer"></div>

<script src="../_assets/wizard-modal.js"></script>
<script>
// Page-specific API helpers (delegates to global CpanelAPI)
const EmailAPI = {
  async listEmailAccounts() {
    // Returns accounts with disk usage: { login, email, domain, _diskquota, _diskused, suspended_login, ... }
    return CpanelAPI.call('Email', 'list_pops_with_disk');
  },

  async listMailDomains() {
    // Returns array of { domain } objects
    return CpanelAPI.call('Email', 'list_mail_domains');
  },

  async getResourceUsage() {
    // Returns resource limits including email account count
    return CpanelAPI.call('ResourceUsage', 'get_usages');
  },

  async createEmailAccount(prefix, domain, password, quota, sendWelcome = 0) {
    // quota: MB value, or 0 for unlimited
    return CpanelAPI.call('Email', 'add_pop', {
      email: prefix,
      domain: domain,
      password: password,
      quota: quota,
      send_welcome_email: sendWelcome ? 1 : 0
    });
  },

  async deleteEmailAccount(email, domain) {
    return CpanelAPI.call('Email', 'delete_pop', { email, domain });
  },

  async changeEmailPassword(email, domain, password) {
    return CpanelAPI.call('Email', 'passwd_pop', { email, password, domain });
  },

  async changeEmailQuota(email, domain, quota) {
    // quota in MB, 0 = unlimited
    return CpanelAPI.call('Email', 'edit_pop_quota', { email, domain, quota });
  },

  async suspendLogin(email) {
    return CpanelAPI.call('Email', 'suspend_login', { email });
  },

  async unsuspendLogin(email) {
    return CpanelAPI.call('Email', 'unsuspend_login', { email });
  },

  async suspendIncoming(email) {
    return CpanelAPI.call('Email', 'suspend_incoming', { email });
  },

  async unsuspendIncoming(email) {
    return CpanelAPI.call('Email', 'unsuspend_incoming', { email });
  },

  async holdOutgoing(email) {
    return CpanelAPI.call('Email', 'hold_outgoing', { email });
  },

  async releaseOutgoing(email) {
    return CpanelAPI.call('Email', 'release_outgoing', { email });
  },

  async listForwarders(domain) {
    return CpanelAPI.call('Email', 'list_forwarders', domain ? { domain } : {});
  },

  async addForwarder(domain, email, fwdemail) {
    return CpanelAPI.call('Email', 'add_forwarder', {
      domain, email, fwdopt: 'fwd', fwdemail
    });
  },

  async deleteForwarder(address, dest) {
    return CpanelAPI.call('Email', 'delete_forwarder', { address, forwarder: dest });
  },

  async listAutoresponders(domain) {
    return CpanelAPI.call('Email', 'list_auto_responders', domain ? { domain } : {});
  },

  async listFilters(account) {
    return CpanelAPI.call('Email', 'list_filters', account ? { account } : {});
  },

  async getClientSettings(domain) {
    return CpanelAPI.call('Email', 'get_client_settings', { domain });
  },

  async getHeldMessageCount(email) {
    return CpanelAPI.call('Email', 'get_held_message_count', { email });
  },

  async deleteHeldMessages(email, releaseAfterDelete = false) {
    return CpanelAPI.call('Email', 'delete_held_messages', {
      email,
      release_after_delete: releaseAfterDelete ? 1 : 0
    });
  },

  async getPlusAddressing(email) {
    return CpanelAPI.call('Email', 'get_mailbox_autocreate', { email });
  },

  async enablePlusAddressing(email) {
    return CpanelAPI.call('Email', 'enable_mailbox_autocreate', { email });
  },

  async disablePlusAddressing(email) {
    return CpanelAPI.call('Email', 'disable_mailbox_autocreate', { email });
  },

  async createUserWithInvite(email, domain, quota, alternateEmail) {
    // Jupiter uses UserManager::create_user with send_invite=1
    // This sends a password reset link to the alternate email — no password needed
    return CpanelAPI.call('UserManager', 'create_user', {
      username: email,
      domain: domain,
      alternate_email: alternateEmail || '',
      send_invite: 1,
      'services.email.enabled': 1,
      'services.email.quota': quota,
      'services.email.send_welcome_email': 1
    });
  },

  async getSharedAddressBook() {
    return CpanelAPI.call('DAV', 'has_shared_global_addressbook');
  },

  async enableSharedAddressBook() {
    return CpanelAPI.call('DAV', 'enable_shared_global_addressbook');
  },

  async disableSharedAddressBook() {
    return CpanelAPI.call('DAV', 'disable_shared_global_addressbook');
  },

  async getUtf8Mailbox() {
    // UAPI Mailboxes::has_utf8_mailbox_names — checks if UTF-8 mailbox names are enabled
    return CpanelAPI.call('Mailboxes', 'has_utf8_mailbox_names');
  },

  getConnectDevicesUrl(email) {
    const token = CpanelAPI.getToken();
    const base = token ? `/${token}/frontend/jupiter` : '';
    return `${base}/mail/clientconf.html?acct=${encodeURIComponent(email)}`;
  },

  getWebmailUrl(email) {
    const token = CpanelAPI.getToken();
    const base = token ? `/${token}/frontend/jupiter` : '';
    return `${base}/mail/webmailform.html?user=${encodeURIComponent(email)}&return_request_uri=${encodeURIComponent(window.location.pathname)}`;
  }
};


// ===================================================================
// DATA DECORATION
// Transforms raw UAPI response into our internal format.
// Jupiter pattern: bytes → MB, 0 quota = unlimited, suspension states.
// ===================================================================

function decorateEmailAccount(raw) {
  // raw fields: login, email (full), domain, _diskquota (bytes), _diskused (bytes),
  //   suspended_login (0/1), suspended_incoming (0/1), hold_outgoing (0/1),
  //   humandiskquota, humandiskused, txtdiskquota, txtdiskused, has_suspend

  const rawQuota = raw._diskquota || raw.diskquota || '0';
  const diskQuotaBytes = (rawQuota === 'unlimited' || rawQuota === 'none') ? 0 : parseInt(rawQuota, 10);
  const diskUsedBytes  = parseInt(raw._diskused  || raw.diskused  || '0', 10);

  // Convert bytes to MB (Jupiter rounds to 2 decimal places)
  // Guard against NaN from unparseable quota values
  const quotaMB = (!diskQuotaBytes || isNaN(diskQuotaBytes)) ? 0 : Math.round((diskQuotaBytes / (1024 * 1024)) * 100) / 100;
  const usedMB  = isNaN(diskUsedBytes) ? 0 : Math.round((diskUsedBytes / (1024 * 1024)) * 100) / 100;

  const isUnlimited = !diskQuotaBytes || isNaN(diskQuotaBytes);
  const login = raw.login || raw.email?.split('@')[0] || '';
  const email = raw.email || `${login}@${raw.domain}`;
  const isMainAccount = login === 'Main Account' || login === raw.domain;

  // Suspension state: check all three dimensions
  const suspendedLogin    = raw.suspended_login === 1 || raw.suspended_login === '1';
  const suspendedIncoming = raw.suspended_incoming === 1 || raw.suspended_incoming === '1';
  const suspendedOutgoing = raw.suspended_outgoing === 1 || raw.suspended_outgoing === '1';
  const holdOutgoing      = raw.hold_outgoing === 1 || raw.hold_outgoing === '1';
  const isSuspended = suspendedLogin || suspendedIncoming || suspendedOutgoing || holdOutgoing;

  return {
    email,
    login,
    domain: raw.domain || email.split('@')[1],
    used: usedMB,
    quota: isUnlimited ? 0 : quotaMB,
    isUnlimited,
    status: isSuspended ? 'suspended' : 'active',
    suspendedLogin,
    suspendedIncoming,
    suspendedOutgoing,
    holdOutgoing,
    isMainAccount,
    _raw: raw
  };
}


// ===================================================================
// STATE
// ===================================================================

let emails = [];
let mailDomains = [];   // Domains available for creating email accounts
let mainDomain = '';    // Main domain — emails on this domain sort first
let isLive = true;      // True when connected to live cPanel
let searchQuery = '';
let domainFilter = 'all';
let statusFilter = 'all';
let currentPage = 1;
let pageSize = 10;
const PAGE_SIZES = [5, 10, 25, 50];
let detailEmail = null;
let emailLimit = null;  // Max email accounts allowed (null = no limit info)
let sortField = 'email';
let sortDirection = 'asc';
let selectedEmails = new Set();
let createMode = 'password'; // 'password' or 'invite'
let forwarderCache = {};  // Runtime cache: email -> forwarder array
let filterCache = {};     // Runtime cache: email -> filter array


// ===================================================================
// INITIALIZATION
// ===================================================================

async function init() {
  await CpanelAPI.loadFeatures();
  if (typeof applyFeatureGating === 'function') applyFeatureGating();

  if (!CpanelAPI.hasFeature('popaccts')) {
    var main = document.querySelector('.main-content') || document.querySelector('main');
    if (main) {
      main.innerHTML = '<div style="text-align:center;padding:var(--space-10);"><div style="font-size:var(--text-lg);font-weight:var(--weight-semibold);color:var(--text-secondary);margin-bottom:var(--space-3);">' + t('Email is not enabled') + '</div><div style="color:var(--text-tertiary);">' + t('Email is not enabled on your account. Contact your hosting provider for access.') + '</div></div>';
    }
    return;
  }

  try {
    await loadLiveData();
  } catch (err) {
    console.error('Failed to load email data:', err);
  }

  populateDomainFilter();
  updateStats();
  renderList();
  bindEvents();

  document.getElementById('pageContent').style.display = '';
  initAnimations();

  // Handle deep-link: #account=user@domain.com (from Websites page cross-link)
  var hashAccount = (location.hash.match(/account=([^&]+)/) || [])[1];
  if (hashAccount) {
    var decoded = decodeURIComponent(hashAccount);
    if (emails.find(function(x) { return x.email === decoded; })) {
      openDetail(decoded);
    }
    history.replaceState(null, '', location.pathname + location.search);
  }
}


async function loadLiveData() {
  try {
    const [accountsResult, domainsResult, usageResult] = await Promise.all([
      EmailAPI.listEmailAccounts(),
      EmailAPI.listMailDomains().catch(() => ({ data: [] })),
      EmailAPI.getResourceUsage().catch(() => ({ data: [] }))
    ]);

    // Decorate email accounts
    const rawAccounts = accountsResult.data || [];
    emails = rawAccounts.map(decorateEmailAccount);

    // Mail domains for create dropdown
    const rawDomains = domainsResult.data || [];
    mailDomains = rawDomains.map(d => d.domain || d).filter(Boolean);
    if (!mailDomains.length) {
      mailDomains = [...new Set(emails.map(e => e.domain))];
    }

    // Determine main domain — fetch from DomainInfo for accurate ordering
    try {
      const domainInfo = await CpanelAPI.call('DomainInfo', 'list_domains');
      if (domainInfo.data && domainInfo.data.main_domain) {
        mainDomain = domainInfo.data.main_domain;
      }
    } catch (e) {
      // Fallback: first mail domain or first email's domain
      mainDomain = mailDomains[0] || (emails[0] && emails[0].domain) || '';
    }

    // Resource usage — find email account limit
    if (usageResult.data && Array.isArray(usageResult.data)) {
      const emailUsage = usageResult.data.find(u => u.id === 'email_accounts' || u.id === 'emailaccounts');
      if (emailUsage) {
        emailLimit = emailUsage.maximum === null || emailUsage.maximum === 'unlimited' ? null : parseInt(emailUsage.maximum, 10);
      }
    }

    isLive = true;

    // Re-render modern list after live data loads
    var s = document.getElementById('modernEmailSearch');
    modernRenderEmailList(s ? s.value : '');
    modernUpdateToggleAllLabel();

  } catch (err) {
    console.error('Failed to load live data:', err);
  }
}

function populateDomainFilter() {
  // Use mailDomains from API or derive from accounts
  const domainSet = mailDomains.length
    ? new Set(mailDomains)
    : new Set(emails.map(e => e.domain));

  // Classic filter dropdown (may not exist in modern view)
  const sel = document.getElementById('domainFilter');
  if (sel) {
    sel.innerHTML = '<option value="all">' + t('All Domains') + '</option>';
    domainSet.forEach(d => {
      sel.innerHTML += `<option value="${d}">${escapeHtml(d)}</option>`;
    });
  }

  // Note: create modal domain dropdown is populated dynamically by getCreateEmailFormHtml()
}

function updateStats() {
  const totalUsed = emails.reduce((s, e) => s + e.used, 0);
  const hasUnlimited = emails.some(e => e.isUnlimited);
  const totalQuota = hasUnlimited ? 0 : emails.reduce((s, e) => s + e.quota, 0);

  // Show/hide limit warning and disable create button if at limit
  const atLimit = emailLimit !== null && emails.length >= emailLimit;
  const limitEl = document.getElementById('limitWarning');
  const createBtn = document.getElementById('createAccountBtn');
  if (limitEl) {
    limitEl.style.display = atLimit ? 'flex' : 'none';
    if (atLimit) {
      const limitWarningText = document.getElementById('limitWarningText');
      if (limitWarningText) {
        limitWarningText.textContent =
          t('You have reached the maximum number of email accounts ({0}). Remove an account or upgrade your plan to create more.', emailLimit);
      }
    }
  }
  if (createBtn) {
    createBtn.disabled = atLimit;
    createBtn.title = atLimit ? t('Email account limit reached') : '';
  }

  // Stat card elements (classic view — may not exist in modern view)
  const statAccounts = document.getElementById('statAccounts');
  if (statAccounts) statAccounts.textContent = emails.length;

  const statAccountsLabel = document.getElementById('statAccountsLabel');
  if (statAccountsLabel) {
    statAccountsLabel.textContent = emailLimit !== null
      ? t('{0} of {1} allowed', emails.length, emailLimit)
      : t('Active accounts');
  }

  const statStorage = document.getElementById('statStorage');
  if (statStorage) statStorage.textContent = formatStorage(totalUsed);

  const storageLabel = document.querySelector('#statStorage + .stat-card-label');
  if (storageLabel) {
    storageLabel.textContent = hasUnlimited ? t('Unlimited storage') : t('{0} of {1} allocated', formatStorage(totalUsed), formatStorage(totalQuota));
  }

  // Forwarders & autoresponders — update async if live
  const statForwarders = document.getElementById('statForwarders');
  const statAutoresponders = document.getElementById('statAutoresponders');

  if (!isLive) {
    const forwarderCount = Object.values(forwarderCache).reduce((s, arr) => s + arr.length, 0);
    if (statForwarders) statForwarders.textContent = forwarderCount;
    if (statAutoresponders) statAutoresponders.textContent = '2';
  } else {
    // Fetch counts asynchronously
    if (statForwarders) {
      EmailAPI.listForwarders().then(result => {
        statForwarders.textContent = (result.data || []).length;
      }).catch(() => { statForwarders.textContent = '—'; });
    }

    if (statAutoresponders) {
      EmailAPI.listAutoresponders().then(result => {
        statAutoresponders.textContent = (result.data || []).length;
      }).catch(() => { statAutoresponders.textContent = '—'; });
    }
  }
}

function bindEvents() {
  // Classic search (may not exist in modern view)
  const emailSearch = document.getElementById('emailSearch');
  if (emailSearch) {
    emailSearch.addEventListener('input', e => {
      searchQuery = e.target.value;
      currentPage = 1;
      renderList();
    });
  }

  // Classic domain filter dropdown (may not exist in modern view)
  const domainFilterEl = document.getElementById('domainFilter');
  if (domainFilterEl) {
    domainFilterEl.addEventListener('change', e => {
      domainFilter = e.target.value;
      currentPage = 1;
      renderList();
    });
  }

  document.querySelectorAll('.filter-chip[data-status]').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.filter-chip[data-status]').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      statusFilter = chip.dataset.status;
      currentPage = 1;
      renderList();
    });
  });

  const createAccountBtn = document.getElementById('createAccountBtn');
  if (createAccountBtn) createAccountBtn.addEventListener('click', openModal);

  // Password strength meter
  const newPassword = document.getElementById('newPassword');
  if (newPassword) newPassword.addEventListener('input', updatePasswordStrength);
}


// ===================================================================
// HELPERS
// ===================================================================

// escapeHtml() provided globally by shell.js

// confirmAction() — delegates to shared window.confirmAction from shell.js
function confirmAction(opts) {
  return window.confirmAction({
    title: opts.title,
    message: opts.message,
    danger: (opts.variant || 'danger') === 'danger',
    confirmLabel: opts.confirmText || t('Confirm')
  });
}

function formatStorage(mb) {
  if (mb === 0 && arguments.length === 0) return '0 MB';
  if (mb >= 1000) return (mb / 1000).toFixed(1) + ' GB';
  return Math.round(mb) + ' MB';
}

function formatQuota(e) {
  if (e.isUnlimited || e.quota === 0) return '∞';
  return formatStorage(e.quota);
}

function storageColor(used, quota) {
  if (quota === 0) return 'success'; // unlimited
  const pct = (used / quota) * 100;
  // Jupiter thresholds: <60% success, 60-79% warning, 80%+ danger
  if (pct >= 80) return 'danger';
  if (pct >= 60) return 'warning';
  return 'success';
}

function storagePct(used, quota) {
  if (quota === 0) return Math.min(used / 10, 30); // low bar for unlimited
  return Math.min((used / quota) * 100, 100);
}

function generatePasswordAndFill() {
  const pw = window.generatePassword(16);
  const inp = document.getElementById('newPassword');
  inp.type = 'text';
  inp.value = pw;
  updatePasswordStrength();
}


// ===================================================================
// RENDER LIST
// ===================================================================

function getFiltered() {
  let result = emails.filter(e => {
    if (searchQuery && !e.email.toLowerCase().includes(searchQuery.toLowerCase())) return false;
    if (domainFilter !== 'all' && e.domain !== domainFilter) return false;
    if (statusFilter === 'active' && e.status !== 'active') return false;
    if (statusFilter === 'suspended' && e.status !== 'suspended') return false;
    if (statusFilter === 'restricted' && !(e.suspendedLogin || e.suspendedIncoming || e.suspendedOutgoing || e.holdOutgoing)) return false;
    if (statusFilter === 'overquota' && (e.isUnlimited || e.quota === 0 || (e.used / e.quota) < 0.8)) return false;
    return true;
  });

  // Sort — main domain emails always first
  result.sort((a, b) => {
    const aIsMain = mainDomain && a.domain === mainDomain ? 1 : 0;
    const bIsMain = mainDomain && b.domain === mainDomain ? 1 : 0;
    if (aIsMain !== bIsMain) return bIsMain - aIsMain;

    let va = a[sortField] || '';
    let vb = b[sortField] || '';
    if (typeof va === 'string') va = va.toLowerCase();
    if (typeof vb === 'string') vb = vb.toLowerCase();
    if (va < vb) return sortDirection === 'asc' ? -1 : 1;
    if (va > vb) return sortDirection === 'asc' ? 1 : -1;
    return 0;
  });

  return result;
}

function toggleSort(field) {
  if (sortField === field) {
    sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
  } else {
    sortField = field;
    sortDirection = 'asc';
  }
  currentPage = 1;
  renderList();
  updateSortIndicators();
}

function updateSortIndicators() {
  document.querySelectorAll('.email-table-head .sortable').forEach(el => {
    const icon = el.querySelector('.sort-icon');
    const field = el.onclick.toString().match(/toggleSort\('(\w+)'\)/)?.[1];
    if (field === sortField) {
      icon.className = sortDirection === 'asc' ? 'ri-arrow-up-line sort-icon active' : 'ri-arrow-down-line sort-icon active';
      el.setAttribute('aria-sort', sortDirection === 'asc' ? 'ascending' : 'descending');
    } else {
      icon.className = 'ri-arrow-up-down-line sort-icon';
      el.setAttribute('aria-sort', 'none');
    }
  });
}

function renderList() {
  const list = document.getElementById('emailList');
  if (!list) return; // Classic list container removed; modern view uses modernRenderEmailList()
  const filtered = getFiltered();


  if (filtered.length === 0) {
    list.innerHTML = `
      <div style="padding: var(--space-12) var(--space-8); text-align: center;">
        <i class="ri-mail-line" style="font-size: var(--text-2xl); color: var(--text-disabled); margin-bottom: var(--space-3); display: block;" aria-hidden="true"></i>
        <div class="t-body-sm t-muted" style="margin-bottom: var(--space-2);">${t('No email accounts found')}</div>
        <div class="t-caption t-dimmed">${searchQuery ? t('Try a different search term') : t('Create your first email account to get started')}</div>
      </div>`;
    const paginationEl = document.getElementById('pagination');
    if (paginationEl) paginationEl.innerHTML = '';
    return;
  }

  // Pagination
  const totalItems = filtered.length;
  const totalPages = Math.ceil(totalItems / pageSize);
  if (currentPage > totalPages) currentPage = totalPages || 1;
  const startIdx = (currentPage - 1) * pageSize;
  const pageItems = filtered.slice(startIdx, startIdx + pageSize);

  let html = '';
  pageItems.forEach(e => {
    const pct = storagePct(e.used, e.quota);
    const color = storageColor(e.used, e.quota);
    const statusBadge = e.status === 'active'
      ? '<span class="badge badge-success">' + t('Active') + '</span>'
      : '<span class="badge badge-warning">' + t('Suspended') + '</span>';
    const quotaLabel = (e.isUnlimited || e.quota === 0) ? '∞' : formatStorage(e.quota);
    const mainTag = e.isMainAccount ? ' <span class="badge badge-neutral badge-xs">' + t('System') + '</span>' : '';

    const isChecked = selectedEmails.has(e.email) ? 'checked' : '';
    const canSelect = !e.isMainAccount;

    html += `
      <div class="email-row" role="row" tabindex="0" onclick="openDetail('${escapeHtml(e.email)}')">
        <div style="display:flex;align-items:center;" onclick="event.stopPropagation()">
          ${canSelect ? `<input type="checkbox" class="table-checkbox" ${isChecked} aria-label="Select ${escapeHtml(e.email)}" onchange="toggleRowSelect('${escapeHtml(e.email)}', this.checked)">` : '<span style="width:18px;"></span>'}
        </div>
        <div class="email-name">
          <div class="email-icon" aria-hidden="true"><i class="ri-mail-line" aria-hidden="true"></i></div>
          <div>
            <div class="email-name-text">${escapeHtml(e.email)}${mainTag}</div>
          </div>
        </div>
        <div class="email-cell">${escapeHtml(e.domain)}</div>
        <div class="email-cell">
          <div class="storage-bar-wrap">
            <div class="storage-bar"><div class="storage-bar-fill ${color}" style="width:${pct}%"></div></div>
            <div class="storage-text">${formatStorage(e.used)} / ${quotaLabel}</div>
          </div>
        </div>
        <div class="email-cell">${statusBadge}</div>
        <div class="email-actions" onclick="event.stopPropagation()">
          <button type="button" class="btn btn-ghost btn-sm" onclick="openDetail('${escapeHtml(e.email)}')" aria-label="${t('Manage')} ${escapeHtml(e.email)}">${t('Manage')}</button>
        </div>
      </div>`;
  });

  list.innerHTML = html;
  renderPagination(totalItems, totalPages);
}

function renderPagination(totalItems, totalPages) {
  const el = document.getElementById('pagination');
  if (!el) return; // Classic pagination container removed
  if (totalPages <= 1) { el.innerHTML = ''; return; }

  const start = (currentPage - 1) * pageSize + 1;
  const end = Math.min(currentPage * pageSize, totalItems);

  let pageButtons = '';
  const maxVisible = 5;
  let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
  let endPage = Math.min(totalPages, startPage + maxVisible - 1);
  if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);

  for (let i = startPage; i <= endPage; i++) {
    pageButtons += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
  }

  el.innerHTML = `
    <div class="pagination-info">
      <span>${t('Showing {0}-{1} of {2}', start, end, totalItems)}</span>
      <select class="form-select-sm" onchange="changePageSize(this.value)" aria-label="${t('Items per page')}">
        ${PAGE_SIZES.map(s => `<option value="${s}" ${s === pageSize ? 'selected' : ''}>${t('{0} per page', s)}</option>`).join('')}
      </select>
    </div>
    <div class="pagination-controls">
      <button class="pagination-btn" onclick="goToPage(${currentPage - 1})" ${currentPage <= 1 ? 'disabled' : ''} aria-label="Previous page">
        <i class="ri-arrow-left-s-line" aria-hidden="true"></i>
      </button>
      ${pageButtons}
      <button class="pagination-btn" onclick="goToPage(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''} aria-label="Next page">
        <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
      </button>
    </div>`;
}

function goToPage(page) {
  const totalPages = Math.ceil(getFiltered().length / pageSize);
  if (page < 1 || page > totalPages) return;
  currentPage = page;
  renderList();
}

function changePageSize(size) {
  pageSize = parseInt(size, 10);
  currentPage = 1;
  renderList();
}


// ===================================================================
// DETAIL VIEW
// ===================================================================

function openDetail(emailAddr) {
  const e = emails.find(x => x.email === emailAddr);
  if (!e) return;
  detailEmail = e;

  document.getElementById('detailTitle').textContent = e.email;

  // Badges
  const statusBadge = e.status === 'active'
    ? '<span class="badge badge-success">' + t('Active') + '</span>'
    : '<span class="badge badge-warning">' + t('Suspended') + '</span>';
  document.getElementById('detailBadges').innerHTML =
    `${statusBadge} <span class="badge badge-neutral">${escapeHtml(e.domain)}</span>`;

  // Actions
  const webmailAction = isLive
    ? `<a href="${EmailAPI.getWebmailUrl(e.email)}" target="_blank" class="btn btn-secondary btn-sm"><i class="ri-mail-open-line" aria-hidden="true"></i> ${t('Check Email')}</a>`
    : `<button class="btn btn-secondary btn-sm" onclick="showToast('${t('Webmail not available in mock mode')}', 'error')"><i class="ri-mail-open-line" aria-hidden="true"></i> ${t('Check Email')}</button>`;
  const connectDevicesAction = isLive
    ? `<a href="${EmailAPI.getConnectDevicesUrl(e.email)}" class="btn btn-secondary btn-sm"><i class="ri-smartphone-line" aria-hidden="true"></i> ${t('Connect Devices')}</a>`
    : `<button class="btn btn-secondary btn-sm" onclick="showToast('${t('Connect Devices not available in mock mode')}', 'error')"><i class="ri-smartphone-line" aria-hidden="true"></i> ${t('Connect Devices')}</button>`;
  document.getElementById('detailActions').innerHTML = `
    ${webmailAction}
    ${connectDevicesAction}
    <button class="btn btn-secondary btn-sm" onclick="promptChangePassword()"><i class="ri-lock-password-line" aria-hidden="true"></i> ${t('Change Password')}</button>
  `;

  // Tabs
  const tabs = [
    { id: 'overview', icon: 'ri-dashboard-line', label: t('Overview') },
    { id: 'forwarders', icon: 'ri-share-forward-line', label: t('Forwarders') },
    { id: 'autoresponder', icon: 'ri-reply-all-line', label: t('Auto-Responder') },
    { id: 'filters', icon: 'ri-filter-3-line', label: t('Filters') },
    { id: 'settings', icon: 'ri-settings-3-line', label: t('Settings') },
  ];
  document.getElementById('detailTabsBar').innerHTML = tabs.map((t, i) =>
    `<button class="detail-tab ${i === 0 ? 'active' : ''}" onclick="switchDetailTab('${t.id}', this)" type="button"><i class="${t.icon}"></i> ${t.label}</button>`
  ).join('');

  renderDetailTab('overview');

  // Show detail, hide list (only hide elements that actually exist)
  document.querySelectorAll('#pageHeader, #statsRow, #filterBar, #emailTable, #pageContent').forEach(el => { if (el) el.style.display = 'none'; });
  document.getElementById('detailView').style.display = 'block';
}

function closeDetail() {
  document.getElementById('detailView').style.display = 'none';
  // Restore elements that may exist (classic or modern)
  document.querySelectorAll('#pageHeader, #statsRow, #filterBar, #emailTable').forEach(el => { if (el) el.style.display = ''; });
  const pageContent = document.getElementById('pageContent');
  if (pageContent) pageContent.style.display = '';
  detailEmail = null;
  renderList(); // Refresh list with any changes
}

function switchDetailTab(tabId, btn) {
  document.querySelectorAll('.detail-tabs-bar .detail-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  renderDetailTab(tabId);
}

function renderDetailTab(tabId) {
  const el = document.getElementById('detailTabContent');
  const e = detailEmail;
  const pct = storagePct(e.used, e.quota);
  const color = storageColor(e.used, e.quota);

  if (tabId === 'overview') {
    const quotaLabel = (e.isUnlimited || e.quota === 0) ? t('Unlimited') : formatStorage(e.quota);
    const pctLabel = (e.isUnlimited || e.quota === 0) ? '' : `<div class="t-caption t-dimmed" style="margin-top: var(--space-2);">${t('{0}% used', pct.toFixed(1))}</div>`;

    el.innerHTML = `
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6);">
        <div class="site-info">
          <div class="site-info-title">${t('Storage Usage')}</div>
          <div style="margin-bottom: var(--space-4);">
            <div style="display:flex; justify-content:space-between; margin-bottom: var(--space-2);">
              <span class="t-body-sm">${t('{0} used', formatStorage(e.used))}</span>
              <span class="t-body-sm t-muted">${t('{0} quota', quotaLabel)}</span>
            </div>
            <div class="storage-bar" style="height: 8px;">
              <div class="storage-bar-fill ${color}" style="width:${pct}%"></div>
            </div>
            ${pctLabel}
          </div>
        </div>
        <div class="site-info" id="connectionSettings">
          <div class="site-info-title">${t('Connection Settings')}</div>
          <div class="site-info-grid" style="grid-template-columns: 1fr;">
            <div class="site-info-item">
              <div class="site-info-label">${t('Incoming Mail (IMAP)')}</div>
              <div class="site-info-value mono">${isLive ? '<span class="text-tertiary">' + t('Loading...') + '</span>' : `mail.${escapeHtml(e.domain)} : 993 (SSL)`}</div>
            </div>
            <div class="site-info-item">
              <div class="site-info-label">${t('Incoming Mail (POP3)')}</div>
              <div class="site-info-value mono">${isLive ? '<span class="text-tertiary">' + t('Loading...') + '</span>' : `mail.${escapeHtml(e.domain)} : 995 (SSL)`}</div>
            </div>
            <div class="site-info-item">
              <div class="site-info-label">${t('Outgoing Mail (SMTP)')}</div>
              <div class="site-info-value mono">${isLive ? '<span class="text-tertiary">' + t('Loading...') + '</span>' : `mail.${escapeHtml(e.domain)} : 465 (SSL)`}</div>
            </div>
            <div class="site-info-item">
              <div class="site-info-label">${t('Username')}</div>
              <div class="site-info-value mono">${escapeHtml(e.email)}</div>
            </div>
          </div>
        </div>
      </div>
      ${e.suspendedLogin || e.suspendedIncoming || e.suspendedOutgoing || e.holdOutgoing ? `
      <div class="site-info" style="border-color: var(--status-warning-border); margin-bottom: var(--space-4);">
        <div class="site-info-title" style="color: var(--status-warning);"><i class="ri-alert-line" aria-hidden="true"></i> ${t('Restrictions')}</div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-3);">
          ${e.suspendedLogin ? '<span class="badge badge-warning">' + t('Login Suspended') + '</span>' : ''}
          ${e.suspendedIncoming ? '<span class="badge badge-warning">' + t('Incoming Suspended') + '</span>' : ''}
          ${e.suspendedOutgoing ? '<span class="badge badge-warning">' + t('Outgoing Suspended') + '</span>' : ''}
          ${e.holdOutgoing ? '<span class="badge badge-warning">' + t('Outgoing Held') + '</span>' : ''}
        </div>
      </div>` : ''}
    `;

    // If live, fetch real connection settings from API
    if (isLive) {
      EmailAPI.getClientSettings(e.domain).then(result => {
        if (result.data) {
          const settings = result.data;
          const settingsEl = document.getElementById('connectionSettings');
          if (settingsEl) {
            const items = [];
            if (settings.imap_host || settings.imap_ssl_host) {
              const host = settings.imap_ssl_host || settings.imap_host;
              const port = settings.imap_ssl_port || settings.imap_port || '993';
              items.push({ label: t('Incoming Mail (IMAP)'), value: `${host} : ${port} (SSL)` });
            }
            if (settings.pop3_host || settings.pop3_ssl_host) {
              const host = settings.pop3_ssl_host || settings.pop3_host;
              const port = settings.pop3_ssl_port || settings.pop3_port || '995';
              items.push({ label: t('Incoming Mail (POP3)'), value: `${host} : ${port} (SSL)` });
            }
            if (settings.smtp_host || settings.smtp_ssl_host) {
              const host = settings.smtp_ssl_host || settings.smtp_host;
              const port = settings.smtp_ssl_port || settings.smtp_port || '465';
              items.push({ label: t('Outgoing Mail (SMTP)'), value: `${host} : ${port} (SSL)` });
            }
            items.push({ label: t('Username'), value: e.email });
            if (items.length) {
              settingsEl.querySelector('.site-info-grid').innerHTML = items.map(i =>
                `<div class="site-info-item"><div class="site-info-label">${escapeHtml(i.label)}</div><div class="site-info-value mono">${escapeHtml(i.value)}</div></div>`
              ).join('');
            }
          }
        }
      }).catch(() => {}); // Fallback to defaults shown above
    }
  }

  else if (tabId === 'forwarders') {
    // Show loading state while fetching
    el.innerHTML = `
      <div class="site-info">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('Forwarding Rules')}</div>
          <button class="btn btn-primary btn-sm" onclick="promptAddForwarder()"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Forwarder')}</button>
        </div>
        <div class="t-body-sm t-muted" style="padding: var(--space-4) 0;"><i class="ri-loader-4-line" aria-hidden="true" style="animation: spin 1s linear infinite; margin-right: var(--space-1);"></i> ${t('Loading forwarders...')}</div>
      </div>`;

    loadForwarders(e);
  }

  else if (tabId === 'autoresponder') {
    // UAPI: Email::list_auto_responders / get_auto_responder / add_auto_responder / delete_auto_responder
    const today = new Date().toISOString().split('T')[0];
    const nextWeek = new Date(Date.now() + 7 * 86400000).toISOString().split('T')[0];
    el.innerHTML = `
      <div class="site-info">
        <div class="site-info-title">${t('Auto-Responder')}</div>
        <div class="settings-row">
          <div class="settings-row-label"><i class="ri-toggle-line" aria-hidden="true"></i> ${t('Enable Auto-Responder')}</div>
          <input type="checkbox" class="toggle" id="arToggle" onchange="toggleAutoResponder(this.checked)">
        </div>
        <div id="arForm" style="display:none;">
          <div class="form-group" style="margin-top: var(--space-4);">
            <label class="form-label">${t('Subject')}</label>
            <input type="text" class="form-input" id="arSubject" placeholder="${t('Re: Your message')}" value="${t('I am currently out of office')}">
          </div>
          <div class="form-group">
            <label class="form-label">${t('Message Body')}</label>
            <textarea class="form-textarea" id="arBody" placeholder="${t('Enter your auto-reply message...')}">${t('Thank you for your email. I am currently out of the office and will respond upon my return.')}</textarea>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
            <div class="form-group">
              <label class="form-label">${t('Repeat Interval (hours)')}</label>
              <input type="number" class="form-input" id="arInterval" value="8" min="0">
            </div>
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
            <div class="form-group">
              <label class="form-label">${t('Start Date')}</label>
              <input type="date" class="form-input" id="arStart" value="${today}">
            </div>
            <div class="form-group">
              <label class="form-label">${t('Stop Date')}</label>
              <input type="date" class="form-input" id="arStop" value="${nextWeek}">
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: var(--space-2); margin-top: var(--space-4);">
            <button class="btn btn-secondary btn-sm" id="arDeleteBtn" style="display:none;" onclick="deleteAutoResponder()"><i class="ri-delete-bin-line" aria-hidden="true"></i> ${t('Delete')}</button>
            <button class="btn btn-primary btn-sm" id="arSaveBtn" onclick="saveAutoResponder()"><i class="ri-save-line" aria-hidden="true"></i> ${t('Save Changes')}</button>
          </div>
        </div>
      </div>
    `;
    loadAutoResponder(e);
  }

  else if (tabId === 'filters') {
    el.innerHTML = `
      <div class="site-info">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('Email Filters')}</div>
          <button class="btn btn-primary btn-sm" onclick="openFilterEditor(null, '${escapeHtml(e.email)}')"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Filter')}</button>
        </div>
        <div id="filterList" class="t-body-sm t-muted" style="padding: var(--space-4) 0;">
          <i class="ri-loader-4-line" aria-hidden="true" style="animation: spin 1s linear infinite; margin-right: var(--space-1);"></i> ${t('Loading filters...')}
        </div>
      </div>`;

    loadFilters(e);
  }

  else if (tabId === 'settings') {
    const quotaValue = (e.isUnlimited || e.quota === 0) ? '' : e.quota;
    const isUnlimitedChecked = (e.isUnlimited || e.quota === 0) ? 'checked' : '';
    const quotaDisabled = (e.isUnlimited || e.quota === 0) ? 'disabled' : '';

    el.innerHTML = `
      <div class="site-info" style="margin-bottom: var(--space-4);">
        <div class="settings-section">
          <div class="settings-section-title">${t('Change Password')}</div>
          <div style="display: flex; gap: var(--space-2); align-items: flex-end;">
            <div style="flex:1;">
              <label class="form-label">${t('New Password')}</label>
              <div class="form-row">
                <input type="password" class="form-input" id="settingsPassword" placeholder="Enter new password">
                <button type="button" class="btn btn-secondary btn-sm" onclick="generateSettingsPassword()" style="flex-shrink:0;">${t('Generate')}</button>
              </div>
            </div>
            <button class="btn btn-primary btn-sm" id="changePwBtn" onclick="changePassword()" style="margin-bottom:1px;">${t('Update')}</button>
          </div>
        </div>
        <div class="settings-section">
          <div class="settings-section-title">${t('Storage Quota')}</div>
          <div style="display: flex; gap: var(--space-2); align-items: flex-end;">
            <div style="flex:1;">
              <label class="form-label">${t('Quota (MB)')}</label>
              <div style="display:flex; align-items:center; gap: var(--space-3);">
                <input type="number" class="form-input" id="settingsQuota" value="${quotaValue}" min="1" ${quotaDisabled} style="flex:1;">
                <label class="form-check">
                  <input type="checkbox" id="settingsUnlimited" ${isUnlimitedChecked} onchange="document.getElementById('settingsQuota').disabled = this.checked; if(this.checked) document.getElementById('settingsQuota').value = '';">
                  ${t('Unlimited')}
                </label>
              </div>
            </div>
            <button class="btn btn-primary btn-sm" id="changeQuotaBtn" onclick="changeQuota()" style="margin-bottom:1px;">${t('Update')}</button>
          </div>
        </div>
        <div class="settings-section">
          <div class="settings-section-title">${t('Plus Addressing')}</div>
          <div class="settings-row">
            <div>
              <div class="settings-row-label"><i class="ri-add-circle-line" aria-hidden="true"></i> ${t('Auto-create folders')}</div>
              <div class="form-hint" style="margin-top: var(--space-1);">${t('Automatically create mail folders for user+tag@domain patterns')}</div>
            </div>
            <input type="checkbox" class="toggle" id="plusAddressingToggle" onchange="togglePlusAddressing(this.checked)">
          </div>
        </div>
        <div class="settings-section" id="heldMessagesSection" style="display:none;">
          <div class="settings-section-title">${t('Held Messages')}</div>
          <div class="settings-row">
            <div>
              <div class="settings-row-label"><i class="ri-mail-lock-line" aria-hidden="true"></i> <span id="heldMessageCount">0</span> ${t('messages held')}</div>
              <div class="form-hint" style="margin-top: var(--space-1);">${t('Outgoing messages held for review')}</div>
            </div>
            <div style="display: flex; gap: var(--space-2);">
              <button class="btn btn-secondary btn-sm" id="releaseHeldBtn" onclick="deleteHeldMessages(true)"><i class="ri-mail-send-line" aria-hidden="true"></i> ${t('Release & Delete')}</button>
              <button class="btn btn-danger btn-sm" id="deleteHeldBtn" onclick="deleteHeldMessages(false)"><i class="ri-delete-bin-line" aria-hidden="true"></i> ${t('Delete')}</button>
            </div>
          </div>
        </div>
        <div class="settings-section">
          <div class="settings-section-title">${t('Account Status')}</div>
          <div class="settings-row" style="margin-bottom: var(--space-2);">
            <div class="settings-row-label"><i class="ri-login-box-line" aria-hidden="true"></i> ${t('Login Access')}</div>
            <button class="btn ${e.suspendedLogin ? 'btn-primary' : 'btn-secondary'} btn-sm" id="toggleLoginBtn" onclick="toggleSuspendLogin()">
              ${e.suspendedLogin ? t('Unsuspend Login') : t('Suspend Login')}
            </button>
          </div>
          <div class="settings-row" style="margin-bottom: var(--space-2);">
            <div class="settings-row-label"><i class="ri-mail-download-line" aria-hidden="true"></i> ${t('Incoming Mail')}</div>
            <button class="btn ${e.suspendedIncoming ? 'btn-primary' : 'btn-secondary'} btn-sm" id="toggleIncomingBtn" onclick="toggleSuspendIncoming()">
              ${e.suspendedIncoming ? t('Unsuspend Incoming') : t('Suspend Incoming')}
            </button>
          </div>
          <div class="settings-row">
            <div class="settings-row-label"><i class="ri-mail-send-line" aria-hidden="true"></i> ${t('Outgoing Mail')}</div>
            <div style="display: flex; gap: var(--space-2);">
              <button class="btn ${!e.suspendedOutgoing && !e.holdOutgoing ? 'btn-primary' : 'btn-secondary'} btn-sm" onclick="setOutgoingState('allow')">${t('Allow')}</button>
              <button class="btn ${e.suspendedOutgoing ? 'btn-primary' : 'btn-secondary'} btn-sm" onclick="setOutgoingState('suspend')">${t('Suspend')}</button>
              <button class="btn ${e.holdOutgoing ? 'btn-primary' : 'btn-secondary'} btn-sm" onclick="setOutgoingState('hold')">${t('Hold')}</button>
            </div>
          </div>
        </div>
      </div>
      ${!e.isMainAccount ? `
      <div class="danger-zone">
        <div class="danger-zone-title"><i class="ri-error-warning-line" aria-hidden="true" style="margin-right: var(--space-1);"></i> ${t('Danger Zone')}</div>
        <div class="danger-zone-desc">${t('Permanently delete this email account and all its data. This action cannot be undone.')}</div>
        <button class="btn btn-danger btn-sm" id="deleteAccountBtn" onclick="deleteAccount()"><i class="ri-delete-bin-line" aria-hidden="true"></i> ${t('Delete Account')}</button>
      </div>` : `
      <div class="site-info" style="margin-bottom: var(--space-4);">
        <div class="settings-section-title">${t('Default Account Settings')}</div>
        <div class="settings-row">
          <div>
            <div class="settings-row-label"><i class="ri-contacts-book-line" aria-hidden="true"></i> ${t('Shared Address Book')}</div>
            <div class="form-hint" style="margin-top: var(--space-1);">${t('Share contacts with all email accounts via CardDAV')}</div>
          </div>
          <input type="checkbox" class="toggle" id="sharedAddressBookToggle" onchange="toggleSharedAddressBook(this.checked)">
        </div>
        <div class="settings-row">
          <div>
            <div class="settings-row-label"><i class="ri-translate-2" aria-hidden="true"></i> ${t('UTF-8 Mailbox Names')}</div>
            <div class="form-hint" style="margin-top: var(--space-1);">${t('Allow international characters in folder names')}</div>
          </div>
          <input type="checkbox" class="toggle" id="utf8MailboxToggle" onchange="toggleUtf8Mailbox(this.checked)">
        </div>
      </div>
      <div class="site-info" style="border-color: var(--status-info-border);">
        <div class="t-body-sm t-muted"><i class="ri-information-line" aria-hidden="true" style="margin-right: var(--space-1);"></i> ${t('This is the system account and cannot be deleted.')}</div>
      </div>`}
    `;

    // Load plus addressing state
    loadPlusAddressingState(e);

    // Load held messages if outgoing is held
    if (e.holdOutgoing) {
      loadHeldMessageCount(e);
    }

    // Load default account settings if system account
    if (e.isMainAccount) {
      loadDefaultAccountSettings();
    }
  }
}


// ===================================================================
// MULTI-SELECT & BULK ACTIONS
// ===================================================================

function toggleRowSelect(emailAddr, checked) {
  if (checked) {
    selectedEmails.add(emailAddr);
  } else {
    selectedEmails.delete(emailAddr);
  }
  updateBulkBar();
}

function toggleSelectAll(checked) {
  const filtered = getFiltered();
  const totalPages = Math.ceil(filtered.length / pageSize);
  const startIdx = (currentPage - 1) * pageSize;
  const pageItems = filtered.slice(startIdx, startIdx + pageSize);

  selectedEmails.clear();
  if (checked) {
    pageItems.forEach(e => {
      if (!e.isMainAccount) selectedEmails.add(e.email);
    });
  }
  renderList();
  updateBulkBar();
}

function clearSelection() {
  selectedEmails.clear();
  const selectAll = document.getElementById('selectAllCheckbox');
  if (selectAll) selectAll.checked = false;
  renderList();
  updateBulkBar();
}

function updateBulkBar() {
  const bar = document.getElementById('bulkBar');
  if (!bar) return; // Bulk bar removed in modern view
  const count = selectedEmails.size;
  if (count > 0) {
    bar.style.display = 'flex';
    const bulkCount = document.getElementById('bulkCount');
    if (bulkCount) bulkCount.textContent = t('{0} selected', count);
  } else {
    bar.style.display = 'none';
  }
}

async function bulkDelete() {
  if (selectedEmails.size === 0) return;

  const count = selectedEmails.size;
  const emailList = [...selectedEmails].slice(0, 5).join(', ') + (count > 5 ? ' ' + t('and {0} more', count - 5) : '');

  const confirmed = await confirmAction({
    title: t('Delete {0} Email Accounts', count),
    message: t('Are you sure you want to delete <strong>{0}</strong> email accounts?', count) + `<br><br><span style="font-size:var(--text-xs);color:var(--text-tertiary);">${escapeHtml(emailList)}</span><br><br>` + t('All emails, forwarders, and filters for these accounts will be permanently removed.'),
    confirmText: t('Delete {0} Accounts', count),
    variant: 'danger'
  });
  if (!confirmed) return;

  let deleted = 0;
  let failed = 0;

  for (const emailAddr of selectedEmails) {
    const acct = emails.find(e => e.email === emailAddr);
    if (!acct || acct.isMainAccount) continue;

    try {
      if (isLive) {
        const login = acct.login || acct.email.split('@')[0];
        await EmailAPI.deleteEmailAccount(login, acct.domain);
      }
      emails = emails.filter(e => e.email !== emailAddr);
      deleted++;
    } catch (err) {
      console.error(`Failed to delete ${emailAddr}:`, err);
      failed++;
    }
  }

  selectedEmails.clear();
  updateStats();
  populateDomainFilter();
  renderList();
  updateBulkBar();

  if (failed > 0) {
    showToast(t('Deleted {0} accounts, {1} failed', deleted, failed), 'error');
  } else {
    showToast(t('{0} accounts deleted', deleted));
  }
}


// ===================================================================
// PASSWORD STRENGTH
// ===================================================================

function getPasswordStrength(pw) {
  if (!pw) return { score: 0, label: '', strength: '' };
  let score = 0;
  if (pw.length >= 8) score++;
  if (pw.length >= 12) score++;
  if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
  if (/[0-9]/.test(pw)) score++;
  if (/[^a-zA-Z0-9]/.test(pw)) score++;
  if (pw.length >= 16) score++;

  if (score <= 2) return { score: 1, label: t('Weak'), strength: 'weak' };
  if (score <= 3) return { score: 2, label: t('Fair'), strength: 'fair' };
  if (score <= 4) return { score: 3, label: t('Good'), strength: 'good' };
  return { score: 4, label: t('Strong'), strength: 'strong' };
}

function updatePasswordStrength() {
  const pw = document.getElementById('newPassword')?.value || '';
  const meter = document.getElementById('passwordStrength');
  const label = document.getElementById('passwordStrengthLabel');
  if (!meter || !label) return;

  const result = getPasswordStrength(pw);
  meter.setAttribute('data-strength', result.strength);
  const segments = meter.querySelectorAll('.password-strength-segment');
  segments.forEach((seg, i) => {
    seg.classList.toggle('filled', i < result.score);
  });
  label.textContent = pw ? result.label : '';
}


// ===================================================================
// CREATE MODE (PASSWORD vs INVITE)
// ===================================================================

function setCreateMode(mode, btn) {
  createMode = mode;
  document.querySelectorAll('.tab-switcher-btn').forEach(b => {
    b.classList.remove('active');
    b.setAttribute('aria-selected', 'false');
  });
  btn.classList.add('active');
  btn.setAttribute('aria-selected', 'true');

  const pwSection = document.getElementById('createModePassword');
  const inviteSection = document.getElementById('createModeInvite');
  const pwInput = document.getElementById('newPassword');

  if (mode === 'password') {
    pwSection.style.display = '';
    inviteSection.style.display = 'none';
    pwInput.required = true;
  } else {
    pwSection.style.display = 'none';
    inviteSection.style.display = '';
    pwInput.required = false;
  }
}


// ===================================================================
// PLUS ADDRESSING, HELD MESSAGES, DEFAULT ACCOUNT SETTINGS
// ===================================================================

async function loadPlusAddressingState(e) {
  const toggle = document.getElementById('plusAddressingToggle');
  if (!toggle) return;

  if (isLive) {
    try {
      const result = await EmailAPI.getPlusAddressing(e.email);
      toggle.checked = result.data === 1 || result.data === '1' || result.data === true;
    } catch {
      toggle.checked = false;
    }
  }
}

async function togglePlusAddressing(enabled) {
  if (!detailEmail) return;
  try {
    if (isLive) {
      if (enabled) {
        await EmailAPI.enablePlusAddressing(detailEmail.email);
      } else {
        await EmailAPI.disablePlusAddressing(detailEmail.email);
      }
    }
    showToast(enabled ? t('Plus addressing enabled') : t('Plus addressing disabled'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
    const toggle = document.getElementById('plusAddressingToggle');
    if (toggle) toggle.checked = !enabled;
  }
}

async function loadHeldMessageCount(e) {
  const section = document.getElementById('heldMessagesSection');
  if (!section) return;

  section.style.display = '';

  if (isLive) {
    try {
      const result = await EmailAPI.getHeldMessageCount(e.email);
      const count = result.data || 0;
      document.getElementById('heldMessageCount').textContent = count;
    } catch {
      document.getElementById('heldMessageCount').textContent = '?';
    }
  } else {
    document.getElementById('heldMessageCount').textContent = '3';
  }
}

async function deleteHeldMessages(release) {
  if (!detailEmail) return;

  const action = release ? t('release and delete') : t('delete');
  const confirmed = await confirmAction({
    title: t('Delete Held Messages'),
    message: t('Are you sure you want to {0} all held messages for', action) + ` <strong>${escapeHtml(detailEmail.email)}</strong>?`,
    confirmText: release ? t('Release & Delete') : t('Delete Messages'),
    variant: 'warning',
    icon: 'ri-mail-lock-line'
  });
  if (!confirmed) return;

  try {
    if (isLive) {
      await EmailAPI.deleteHeldMessages(detailEmail.email, release);
    }
    document.getElementById('heldMessageCount').textContent = '0';
    showToast(release ? t('Held messages released and deleted') : t('Held messages deleted'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function loadDefaultAccountSettings() {
  if (!isLive) return;

  // Shared address book
  try {
    const result = await EmailAPI.getSharedAddressBook();
    const toggle = document.getElementById('sharedAddressBookToggle');
    if (toggle) toggle.checked = result.data === 1 || result.data === '1' || result.data === true;
  } catch {}

  // UTF-8 mailbox names — UAPI Mailboxes::has_utf8_mailbox_names
  try {
    const result = await EmailAPI.getUtf8Mailbox();
    const toggle = document.getElementById('utf8MailboxToggle');
    if (toggle && result.data !== undefined) {
      toggle.checked = result.data === 1 || result.data === '1' || result.data === true;
    }
  } catch {}
}

async function toggleSharedAddressBook(enabled) {
  try {
    if (isLive) {
      if (enabled) await EmailAPI.enableSharedAddressBook();
      else await EmailAPI.disableSharedAddressBook();
    }
    showToast(enabled ? t('Shared address book enabled') : t('Shared address book disabled'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
    const toggle = document.getElementById('sharedAddressBookToggle');
    if (toggle) toggle.checked = !enabled;
  }
}

async function toggleUtf8Mailbox(enabled) {
  try {
    if (isLive) {
      // UAPI Mailboxes::set_utf8_mailbox_names
      await CpanelAPI.call('Mailboxes', 'set_utf8_mailbox_names', { enabled: enabled ? 1 : 0 });
    }
    showToast(enabled ? t('UTF-8 mailbox names enabled') : t('UTF-8 mailbox names disabled'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
    const toggle = document.getElementById('utf8MailboxToggle');
    if (toggle) toggle.checked = !enabled;
  }
}


// ===================================================================
// ACTIONS
// ===================================================================

function promptChangePassword() {
  // Switch to settings tab
  const settingsBtn = document.querySelector('.detail-tab:last-child');
  if (settingsBtn) {
    document.querySelectorAll('.detail-tabs-bar .detail-tab').forEach(t => t.classList.remove('active'));
    settingsBtn.classList.add('active');
    renderDetailTab('settings');
    setTimeout(() => document.getElementById('settingsPassword')?.focus(), 100);
  }
}

async function changePassword() {
  const pw = document.getElementById('settingsPassword').value;
  if (!pw) { showToast(t('Please enter a password'), 'error'); return; }

  const btn = document.getElementById('changePwBtn');
  if (btn) { btn.disabled = true; btn.textContent = t('Updating...'); }

  try {
    if (isLive) {
      const login = detailEmail.login || detailEmail.email.split('@')[0];
      await EmailAPI.changeEmailPassword(login, detailEmail.domain, pw);
    }
    showToast(t('Password changed successfully'));
    document.getElementById('settingsPassword').value = '';
  } catch (err) {
    showToast(t('Failed to change password: {0}', err.message), 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = t('Update'); }
  }
}

function generateSettingsPassword() {
  const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%';
  let pw = '';
  for (let i = 0; i < 16; i++) pw += chars[Math.floor(Math.random() * chars.length)];
  const inp = document.getElementById('settingsPassword');
  inp.type = 'text';
  inp.value = pw;
}

async function changeQuota() {
  const unlimited = document.getElementById('settingsUnlimited')?.checked;
  const q = unlimited ? 0 : parseInt(document.getElementById('settingsQuota').value, 10);
  if (!unlimited && (!q || q < 1)) { showToast(t('Please enter a valid quota'), 'error'); return; }

  const btn = document.getElementById('changeQuotaBtn');
  if (btn) { btn.disabled = true; btn.textContent = t('Updating...'); }

  try {
    if (isLive) {
      const login = detailEmail.login || detailEmail.email.split('@')[0];
      await EmailAPI.changeEmailQuota(login, detailEmail.domain, q);
    }
    detailEmail.quota = q;
    detailEmail.isUnlimited = q === 0;
    updateStats();
    renderList();
    showToast(unlimited ? t('Quota set to unlimited') : t('Quota updated to {0}', formatStorage(q)));
  } catch (err) {
    showToast(t('Failed to update quota: {0}', err.message), 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = t('Update'); }
  }
}

async function toggleSuspendLogin() {
  const btn = document.getElementById('toggleLoginBtn');
  if (btn) { btn.disabled = true; btn.textContent = t('Updating...'); }

  try {
    if (detailEmail.suspendedLogin) {
      if (isLive) await EmailAPI.unsuspendLogin(detailEmail.email);
      detailEmail.suspendedLogin = false;
      showToast(t('Login access restored'));
    } else {
      if (isLive) await EmailAPI.suspendLogin(detailEmail.email);
      detailEmail.suspendedLogin = true;
      showToast(t('Login suspended'));
    }
    updateSuspensionStatus();
    renderList();
    renderDetailTab('settings');
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function toggleSuspendIncoming() {
  const btn = document.getElementById('toggleIncomingBtn');
  if (btn) { btn.disabled = true; btn.textContent = t('Updating...'); }

  try {
    if (detailEmail.suspendedIncoming) {
      if (isLive) await EmailAPI.unsuspendIncoming(detailEmail.email);
      detailEmail.suspendedIncoming = false;
      showToast(t('Incoming mail restored'));
    } else {
      if (isLive) await EmailAPI.suspendIncoming(detailEmail.email);
      detailEmail.suspendedIncoming = true;
      showToast(t('Incoming mail suspended'));
    }
    updateSuspensionStatus();
    renderList();
    renderDetailTab('settings');
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function setOutgoingState(state) {
  // state: 'allow', 'suspend', 'hold'
  // Note: UAPI only has Email::hold_outgoing / release_outgoing
  // 'suspend' and 'hold' both map to hold_outgoing in practice
  try {
    if (isLive) {
      // First release any existing hold
      if (detailEmail.holdOutgoing || detailEmail.suspendedOutgoing) {
        await EmailAPI.releaseOutgoing(detailEmail.email);
      }

      // Then apply new state — both 'suspend' and 'hold' use hold_outgoing
      if (state === 'suspend' || state === 'hold') {
        await EmailAPI.holdOutgoing(detailEmail.email);
      }
    }

    detailEmail.suspendedOutgoing = state === 'suspend';
    detailEmail.holdOutgoing = state === 'hold';

    const msg = state === 'allow' ? t('Outgoing mail allowed') :
                state === 'suspend' ? t('Outgoing mail suspended') : t('Outgoing mail held');
    showToast(msg);
    updateSuspensionStatus();
    renderList();
    renderDetailTab('settings');
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

function updateSuspensionStatus() {
  const isSuspended = detailEmail.suspendedLogin || detailEmail.suspendedIncoming || detailEmail.suspendedOutgoing || detailEmail.holdOutgoing;
  detailEmail.status = isSuspended ? 'suspended' : 'active';
  // Update badges in header
  const statusBadge = detailEmail.status === 'active'
    ? '<span class="badge badge-success">' + t('Active') + '</span>'
    : '<span class="badge badge-warning">' + t('Suspended') + '</span>';
  document.getElementById('detailBadges').innerHTML =
    `${statusBadge} <span class="badge badge-neutral">${escapeHtml(detailEmail.domain)}</span>`;
}

async function deleteAccount() {
  if (detailEmail.isMainAccount) {
    showToast(t('Cannot delete the system account'), 'error');
    return;
  }

  const confirmed = await confirmAction({
    title: t('Delete Email Account'),
    message: t('Are you sure you want to delete') + ` <strong>${escapeHtml(detailEmail.email)}</strong>? ` + t('All emails, forwarders, and filters for this account will be permanently removed.'),
    confirmText: t('Delete Account'),
    variant: 'danger'
  });
  if (!confirmed) return;

  const btn = document.getElementById('deleteAccountBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line" aria-hidden="true" style="animation: spin 1s linear infinite;"></i> ' + t('Deleting...'); }

  try {
    if (isLive) {
      const login = detailEmail.login || detailEmail.email.split('@')[0];
      await EmailAPI.deleteEmailAccount(login, detailEmail.domain);
    }
    emails = emails.filter(e => e.email !== detailEmail.email);
    updateStats();
    populateDomainFilter();
    renderList();
    closeDetail();
    showToast(t('Email account deleted'));
  } catch (err) {
    showToast(t('Failed to delete account: {0}', err.message), 'error');
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ri-delete-bin-line" aria-hidden="true"></i> ' + t('Delete Account'); }
  }
}

// ── Auto-Responder functions ──

async function loadAutoResponder(e) {
  const toggle = document.getElementById('arToggle');
  const form = document.getElementById('arForm');
  const deleteBtn = document.getElementById('arDeleteBtn');
  if (!toggle || !form) return;

  if (isLive) {
    try {
      const domain = e.email.split('@')[1];
      const result = await CpanelAPI.call('Email', 'list_auto_responders', { domain });
      const responders = result.data || [];
      const existing = responders.find(r => r.email === e.email || r.email === e.login);
      if (existing) {
        toggle.checked = true;
        form.style.display = '';
        if (deleteBtn) deleteBtn.style.display = '';
        // Fetch full details
        try {
          const detail = await CpanelAPI.call('Email', 'get_auto_responder', { email: e.email });
          const d = detail.data || {};
          const subjectEl = document.getElementById('arSubject');
          const bodyEl = document.getElementById('arBody');
          const intervalEl = document.getElementById('arInterval');
          const startEl = document.getElementById('arStart');
          const stopEl = document.getElementById('arStop');
          if (subjectEl && d.subject) subjectEl.value = d.subject;
          if (bodyEl && d.body) bodyEl.value = d.body;
          if (intervalEl && d.interval != null) intervalEl.value = d.interval;
          if (startEl && d.start) startEl.value = new Date(d.start * 1000).toISOString().split('T')[0];
          if (stopEl && d.stop) stopEl.value = new Date(d.stop * 1000).toISOString().split('T')[0];
        } catch {}
      }
    } catch (err) {
      console.warn('Failed to load auto-responder:', err);
    }
  }
}

function toggleAutoResponder(enabled) {
  const form = document.getElementById('arForm');
  if (form) form.style.display = enabled ? '' : 'none';
  if (!enabled && isLive) {
    // If disabling, delete the auto-responder
    const e = selectedEmail;
    if (e) {
      CpanelAPI.call('Email', 'delete_auto_responder', { email: e.email }).catch(() => {});
      showToast(t('Auto-responder disabled'));
    }
  }
}

async function saveAutoResponder() {
  const e = selectedEmail;
  if (!e) return;

  const subject = document.getElementById('arSubject')?.value || '';
  const body = document.getElementById('arBody')?.value || '';
  const interval = parseInt(document.getElementById('arInterval')?.value || '8', 10);
  const startDate = document.getElementById('arStart')?.value;
  const stopDate = document.getElementById('arStop')?.value;

  // Convert dates to unix timestamps
  const start = startDate ? Math.floor(new Date(startDate).getTime() / 1000) : Math.floor(Date.now() / 1000);
  const stop = stopDate ? Math.floor(new Date(stopDate + 'T23:59:59').getTime() / 1000) : 0;

  const btn = document.getElementById('arSaveBtn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line" aria-hidden="true" style="animation: spin 1s linear infinite;"></i> ' + t('Saving...'); }

  try {
    if (isLive) {
      // UAPI Email::add_auto_responder — also used for updates (overwrites existing)
      await CpanelAPI.call('Email', 'add_auto_responder', {
        email: e.login,
        domain: e.email.split('@')[1],
        from: e.email,
        subject: subject,
        body: body,
        is_html: 0,
        charset: 'UTF-8',
        interval: interval,
        start: start,
        stop: stop
      });
    }
    const deleteBtn = document.getElementById('arDeleteBtn');
    if (deleteBtn) deleteBtn.style.display = '';
    showToast(t('Auto-responder saved'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ri-save-line" aria-hidden="true"></i> ' + t('Save Changes'); }
  }
}

async function deleteAutoResponder() {
  const e = selectedEmail;
  if (!e) return;

  try {
    if (isLive) {
      await CpanelAPI.call('Email', 'delete_auto_responder', { email: e.email });
    }
    const toggle = document.getElementById('arToggle');
    if (toggle) toggle.checked = false;
    toggleAutoResponder(false);
    showToast(t('Auto-responder deleted'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function loadForwarders(e) {
  try {
    let fwds = [];
    if (isLive) {
      const result = await EmailAPI.listForwarders(e.domain);
      const allFwds = result.data || [];
      // UAPI Email::list_forwarders returns { dest: "source@domain", forward: "target@domain" }
      // Filter to forwarders where dest matches this account's email
      fwds = allFwds
        .filter(f => f.dest === e.email)
        .map(f => ({ dest: f.forward || f.uri || '', address: f.dest, enabled: true }));
    } else {
      fwds = (forwarderCache[e.email] || []).map(f => ({ ...f, address: e.email }));
    }

    const el = document.getElementById('detailTabContent');
    const currentTab = document.querySelector('.detail-tab.active');
    if (!currentTab || !currentTab.textContent.includes('Forwarder')) return; // Tab changed

    let fwdHtml = fwds.map((f, i) => `
      <div class="list-item">
        <div class="list-item-left">
          <div class="list-item-icon"><i class="ri-share-forward-line" aria-hidden="true"></i></div>
          <div>
            <div class="list-item-text">${escapeHtml(f.dest)}</div>
          </div>
        </div>
        <div class="list-item-right">
          <button class="btn btn-ghost btn-sm" onclick="removeForwarder('${escapeHtml(e.email)}', '${escapeHtml(f.dest)}')" aria-label="Remove forwarder"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
        </div>
      </div>
    `).join('');

    if (!fwds.length) {
      fwdHtml = `<div class="t-body-sm t-muted" style="padding: var(--space-4) 0;">${t('No forwarders configured.')}</div>`;
    }

    el.innerHTML = `
      <div class="site-info">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('Forwarding Rules')}</div>
          <button class="btn btn-primary btn-sm" onclick="promptAddForwarder()"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Forwarder')}</button>
        </div>
        ${fwdHtml}
      </div>`;
  } catch (err) {
    console.error('Failed to load forwarders:', err);
    const el = document.getElementById('detailTabContent');
    el.innerHTML = `
      <div class="site-info">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('Forwarding Rules')}</div>
          <button class="btn btn-primary btn-sm" onclick="promptAddForwarder()"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Forwarder')}</button>
        </div>
        <div class="t-body-sm" style="color: var(--status-error); padding: var(--space-4) 0;">${t('Failed to load forwarders: {0}', escapeHtml(err.message))}</div>
      </div>`;
  }
}

async function loadFilters(emailAccount) {
  const listEl = document.getElementById('filterList');
  if (!listEl) return;
  let filters = [];

  if (isLive) {
    try {
      const result = await EmailAPI.listFilters(emailAccount.email);
      filters = result.data || [];
    } catch (err) {
      listEl.innerHTML = `<div class="t-body-sm t-muted">${t('Failed to load filters: {0}', err.message)}</div>`;
      return;
    }
  } else {
    // Mock data for non-live mode
    filters = filterCache[emailAccount.email] || [
      {
        filtername: 'Block spam senders',
        enabled: 1,
        rules: [{ part: '$header_from:', match: 'contains', val: 'spam@evil.com', opt: '' }],
        actions: [{ action: 'fail', dest: '' }]
      },
      {
        filtername: 'Sort newsletters',
        enabled: 1,
        rules: [{ part: '$h_List-Id:', match: 'is not', val: '', opt: '' }],
        actions: [{ action: 'save', dest: '/.Newsletters' }]
      },
      {
        filtername: 'Forward invoices',
        enabled: 0,
        rules: [{ part: '$header_subject:', match: 'contains', val: 'invoice', opt: '' }],
        actions: [{ action: 'deliver', dest: 'billing@company.com' }]
      }
    ];
  }

  // Verify we're still on the filters tab
  const currentTab = document.querySelector('.detail-tab.active');
  if (!currentTab || !currentTab.textContent.includes('Filter')) return;

  if (filters.length === 0) {
    listEl.innerHTML = `<div class="t-body-sm t-muted" style="text-align:center; padding:var(--space-6) 0;">
      <i class="ri-filter-off-line" style="font-size:32px; display:block; margin-bottom:var(--space-2); color:var(--text-tertiary);" aria-hidden="true"></i>
      ${t('No filters configured')}
    </div>`;
    return;
  }

  // Store filters for editing
  window._currentFilters = filters;
  window._currentFilterAccount = emailAccount.email;

  listEl.innerHTML = filters.map((f, i) => `
    <div class="list-item" style="padding:var(--space-3) 0;">
      <div class="list-item-left" style="gap:var(--space-3);">
        <label style="display:flex; align-items:center; cursor:pointer;" title="${f.enabled ? t('Enabled') : t('Disabled')}">
          <input type="checkbox" class="toggle" ${f.enabled ? 'checked' : ''} onchange="toggleFilter('${escapeHtml(f.filtername)}', this.checked)">
        </label>
        <div>
          <div class="list-item-text">${escapeHtml(f.filtername)}</div>
          <div class="list-item-sub">${summarizeFilter(f)}</div>
        </div>
      </div>
      <div class="list-item-right" style="gap:var(--space-1);">
        <button class="btn btn-ghost btn-sm btn-icon" onclick="openFilterEditor(${i}, '${escapeHtml(emailAccount.email)}')" title="${t('Edit')}"><i class="ri-edit-line" aria-hidden="true"></i></button>
        <button class="btn btn-ghost btn-sm btn-icon" style="color:var(--status-error);" onclick="deleteFilter('${escapeHtml(f.filtername)}')" title="${t('Delete')}"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
      </div>
    </div>
  `).join('');
}

function summarizeFilter(f) {
  const partLabels = {
    '$header_from:': 'From', '$header_to:': 'To', '$header_subject:': 'Subject',
    '$message_body': 'Body', '$reply_address:': 'Reply', '$message_headers': 'Headers',
    '$h_X-Spam-Status:': 'Spam Status', '$h_X-Spam-Score:': 'Spam Score',
    '$h_X-Spam-Bar:': 'Spam Bar', '$h_List-Id:': 'List ID',
    'foranyaddress $h_to:,$h_cc:,$h_bcc:': 'Any Recipient'
  };
  const actionLabels = { deliver: 'Forward to', save: 'Save to', fail: 'Discard', finish: 'Stop', pipe: 'Pipe to' };

  const rule = f.rules && f.rules[0];
  const action = f.actions && f.actions[0];

  let summary = '';
  if (rule) {
    const field = partLabels[rule.part] || rule.part;
    summary += t('If {0} {1} "{2}"', field, rule.match, rule.val || '');
    if (f.rules.length > 1) summary += ' (+' + (f.rules.length - 1) + ')';
  }
  if (action) {
    const act = actionLabels[action.action] || action.action;
    summary += ' \u2192 ' + act;
    if (action.dest) summary += ' ' + escapeHtml(action.dest);
  }
  return summary;
}


// ===================================================================
// FILTER EDITOR
// ===================================================================

let _editingFilterName = null;
let _filterAccount = '';

function openFilterEditor(filterIndex, account) {
  _filterAccount = account;
  const overlay = document.getElementById('filterEditorOverlay');

  if (filterIndex !== null && window._currentFilters && window._currentFilters[filterIndex]) {
    const f = window._currentFilters[filterIndex];
    _editingFilterName = f.filtername;
    document.getElementById('filterEditorTitle').textContent = t('Edit Filter');
    document.getElementById('filterName').value = f.filtername;

    document.getElementById('filterRules').innerHTML = '';
    f.rules.forEach(r => addFilterRule(r));

    document.getElementById('filterActions').innerHTML = '';
    f.actions.forEach(a => addFilterAction(a));
  } else {
    _editingFilterName = null;
    document.getElementById('filterEditorTitle').textContent = t('Add Filter');
    document.getElementById('filterName').value = '';
    document.getElementById('filterRules').innerHTML = '';
    document.getElementById('filterActions').innerHTML = '';
    addFilterRule();
    addFilterAction();
  }

  overlay.classList.add('show');
}

function closeFilterEditor() {
  document.getElementById('filterEditorOverlay').classList.remove('show');
}

// Close filter editor on backdrop click
document.getElementById('filterEditorOverlay').addEventListener('click', function(ev) {
  if (ev.target === this) closeFilterEditor();
});

function addFilterRule(data) {
  const container = document.getElementById('filterRules');
  const row = document.createElement('div');
  row.className = 'filter-rule-row';
  row.style.cssText = 'display:flex; gap:var(--space-2); align-items:center; margin-bottom:var(--space-2); flex-wrap:wrap;';

  const partOptions = [
    ['$header_from:', 'From'],
    ['$header_to:', 'To'],
    ['$header_subject:', 'Subject'],
    ['$reply_address:', 'Reply Address'],
    ['$message_body', 'Body'],
    ['$message_headers', 'Any Header'],
    ['foranyaddress $h_to:,$h_cc:,$h_bcc:', 'Any Recipient'],
    ['$h_X-Spam-Status:', 'Spam Status'],
    ['$h_X-Spam-Score:', 'Spam Score'],
    ['$h_X-Spam-Bar:', 'Spam Bar'],
    ['$h_List-Id:', 'List ID']
  ];

  const matchOptions = [
    'begins', 'contains', 'does not begin', 'does not contain',
    'does not end', 'does not match', 'ends',
    'is', 'matches',
    'is above', 'is below', 'is not above', 'is not below'
  ];

  row.innerHTML = `
    <select class="form-select-sm rule-part" style="min-width:120px;" aria-label="${t('Filter field')}">
      ${partOptions.map(([val, label]) => `<option value="${escapeHtml(val)}" ${data && data.part === val ? 'selected' : ''}>${t(label)}</option>`).join('')}
    </select>
    <select class="form-select-sm rule-match" style="min-width:120px;" aria-label="${t('Match condition')}">
      ${matchOptions.map(m => `<option value="${m}" ${data && data.match === m ? 'selected' : ''}>${m}</option>`).join('')}
    </select>
    <input type="text" class="form-input rule-val" placeholder="${t('Value')}" value="${data ? escapeHtml(data.val || '') : ''}" style="flex:1; min-width:120px;">
    <select class="form-select-sm rule-opt" style="width:70px;" aria-label="${t('Logical operator')}">
      <option value="and" ${data && data.opt === 'and' ? 'selected' : ''}>${t('AND')}</option>
      <option value="or" ${data && data.opt === 'or' ? 'selected' : ''}>${t('OR')}</option>
    </select>
    <button type="button" class="btn btn-ghost btn-sm btn-icon" onclick="this.closest('.filter-rule-row').remove()" title="${t('Remove')}" style="color:var(--status-error); flex-shrink:0;">
      <i class="ri-close-line" aria-hidden="true"></i>
    </button>
  `;
  container.appendChild(row);
}

function addFilterAction(data) {
  const container = document.getElementById('filterActions');
  const row = document.createElement('div');
  row.className = 'filter-action-row';
  row.style.cssText = 'display:flex; gap:var(--space-2); align-items:center; margin-bottom:var(--space-2); flex-wrap:wrap;';

  const actionOptions = [
    ['deliver', 'Forward to Email'],
    ['save', 'Deliver to Folder'],
    ['pipe', 'Pipe to Program'],
    ['fail', 'Discard Message'],
    ['finish', 'Stop Processing']
  ];

  const needsDest = !data || !['fail', 'finish'].includes(data.action);

  row.innerHTML = `
    <select class="form-select-sm action-type" style="min-width:160px;" onchange="toggleActionDest(this)" aria-label="${t('Action type')}">
      ${actionOptions.map(([val, label]) => `<option value="${val}" ${data && data.action === val ? 'selected' : ''}>${t(label)}</option>`).join('')}
    </select>
    <input type="text" class="form-input action-dest" placeholder="${t('Destination')}" value="${data ? escapeHtml(data.dest || '') : ''}" style="flex:1; min-width:140px; ${needsDest ? '' : 'display:none;'}">
    <button type="button" class="btn btn-ghost btn-sm btn-icon" onclick="this.closest('.filter-action-row').remove()" title="${t('Remove')}" style="color:var(--status-error); flex-shrink:0;">
      <i class="ri-close-line" aria-hidden="true"></i>
    </button>
  `;
  container.appendChild(row);
}

function toggleActionDest(select) {
  const dest = select.closest('.filter-action-row').querySelector('.action-dest');
  const needsDest = !['fail', 'finish'].includes(select.value);
  dest.style.display = needsDest ? '' : 'none';
  if (!needsDest) dest.value = '';
}

async function saveFilter() {
  const name = document.getElementById('filterName').value.trim();
  if (!name) { showToast(t('Please enter a filter name'), 'error'); return; }

  const rules = document.querySelectorAll('.filter-rule-row');
  const actions = document.querySelectorAll('.filter-action-row');

  if (rules.length === 0) { showToast(t('Add at least one rule'), 'error'); return; }
  if (actions.length === 0) { showToast(t('Add at least one action'), 'error'); return; }

  const params = {
    account: _filterAccount,
    filtername: name
  };
  if (_editingFilterName && _editingFilterName !== name) {
    params.oldfiltername = _editingFilterName;
  }

  rules.forEach((row, i) => {
    params['part' + i] = row.querySelector('.rule-part').value;
    params['match' + i] = row.querySelector('.rule-match').value;
    params['val' + i] = row.querySelector('.rule-val').value;
    params['opt' + i] = row.querySelector('.rule-opt').value;
  });

  actions.forEach((row, i) => {
    params['action' + i] = row.querySelector('.action-type').value;
    params['dest' + i] = row.querySelector('.action-dest').value;
  });

  const btn = document.getElementById('filterSaveBtn');
  btn.disabled = true;
  btn.textContent = t('Saving...');

  try {
    if (isLive) {
      await CpanelAPI.call('Email', 'store_filter', params);
    }
    showToast(_editingFilterName ? t('Filter updated') : t('Filter created'));
    closeFilterEditor();
    // Reload the filter list
    const email = { email: _filterAccount };
    loadFilters(email);
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = t('Save Filter');
  }
}

async function toggleFilter(filtername, enabled) {
  const fn = enabled ? 'enable_filter' : 'disable_filter';
  try {
    if (isLive) {
      await CpanelAPI.call('Email', fn, { account: window._currentFilterAccount, filtername });
    }
    showToast(enabled ? t('Filter enabled') : t('Filter disabled'));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function deleteFilter(filtername) {
  const confirmed = await confirmAction({
    title: t('Delete Filter'),
    message: t('Are you sure you want to delete the filter "{0}"?', filtername),
    confirmText: t('Delete'),
    variant: 'danger'
  });
  if (!confirmed) return;

  try {
    if (isLive) {
      await CpanelAPI.call('Email', 'delete_filter', { account: window._currentFilterAccount, filtername });
    }
    showToast(t('Filter deleted'));
    if (window._currentFilterAccount) {
      loadFilters({ email: window._currentFilterAccount });
    }
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

async function removeForwarder(emailAddr, dest) {
  try {
    if (isLive) {
      await EmailAPI.deleteForwarder(emailAddr, dest);
    } else {
      if (forwarderCache[emailAddr]) {
        forwarderCache[emailAddr] = forwarderCache[emailAddr].filter(f => f.dest !== dest);
      }
    }
    renderDetailTab('forwarders');
    showToast(t('Forwarder removed'));
  } catch (err) {
    showToast(t('Failed to remove forwarder: {0}', err.message), 'error');
  }
}

async function promptAddForwarder() {
  const dest = prompt(t('Forward to email address:'));
  if (!dest || !dest.includes('@')) return;

  try {
    if (isLive) {
      await EmailAPI.addForwarder(detailEmail.domain, detailEmail.email, dest);
    } else {
      if (!forwarderCache[detailEmail.email]) forwarderCache[detailEmail.email] = [];
      forwarderCache[detailEmail.email].push({ dest, enabled: true });
    }
    renderDetailTab('forwarders');
    showToast(t('Forwarder added'));
  } catch (err) {
    showToast(t('Failed to add forwarder: {0}', err.message), 'error');
  }
}


// ===================================================================
// CREATE ACCOUNT MODAL
// ===================================================================

function getCreateEmailFormHtml() {
  const domainSet = mailDomains.length
    ? new Set(mailDomains)
    : new Set(emails.map(e => e.domain));
  let domainOptions = '';
  domainSet.forEach(d => { domainOptions += '<option value="' + escapeHtml(d) + '">' + escapeHtml(d) + '</option>'; });

  return '<form id="createForm" onsubmit="handleCreate(event); return false;">' +
    '<div class="form-group">' +
      '<label class="form-label" for="newEmailPrefix">' + t('Email Address') + '</label>' +
      '<div class="form-row">' +
        '<input type="text" id="newEmailPrefix" class="form-input" placeholder="username" required autocomplete="off">' +
        '<span class="form-at">@</span>' +
        '<select id="newEmailDomain" class="form-select" aria-label="' + t('Email domain') + '">' + domainOptions + '</select>' +
      '</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label class="form-label">' + t('Authentication') + '</label>' +
      '<div class="tab-switcher" role="tablist">' +
        '<button type="button" class="tab-switcher-btn active" onclick="setCreateMode(\'password\', this)" role="tab" aria-selected="true">' + t('Set Password') + '</button>' +
        '<button type="button" class="tab-switcher-btn" onclick="setCreateMode(\'invite\', this)" role="tab" aria-selected="false">' + t('Send Login Link') + '</button>' +
      '</div>' +
      '<div id="createModePassword">' +
        '<div class="form-row">' +
          '<input type="password" id="newPassword" class="form-input" placeholder="' + t('Enter password') + '" required autocomplete="new-password" aria-describedby="passwordStrengthLabel">' +
          '<button type="button" class="btn btn-secondary btn-sm" onclick="generatePasswordAndFill()" style="flex-shrink:0;">' + t('Generate') + '</button>' +
        '</div>' +
        '<div class="password-strength" id="passwordStrength" data-strength="">' +
          '<div class="password-strength-segment"></div>' +
          '<div class="password-strength-segment"></div>' +
          '<div class="password-strength-segment"></div>' +
          '<div class="password-strength-segment"></div>' +
        '</div>' +
        '<div class="password-strength-label" id="passwordStrengthLabel" aria-live="polite"></div>' +
      '</div>' +
      '<div id="createModeInvite" style="display:none;">' +
        '<div class="form-hint" style="padding: var(--space-3) 0; color: var(--text-secondary);">' +
          '<i class="ri-mail-send-line" aria-hidden="true" style="margin-inline-end: var(--space-1);"></i> ' +
          t('A password reset link will be sent so the user can set their own password.') +
        '</div>' +
        '<label for="inviteAlternateEmail" class="form-label">' + t('Recovery Email') + '</label>' +
        '<input type="email" id="inviteAlternateEmail" class="form-input" placeholder="user@example.com" style="margin-top: var(--space-1);">' +
        '<div class="form-hint" style="font-size: var(--text-xs); color: var(--text-tertiary); margin-top: var(--space-1);">' +
          t('The invite link will be sent to this address.') +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label for="newQuota" class="form-label">' + t('Storage Quota (MB)') + '</label>' +
      '<div style="display:flex; align-items:center; gap: var(--space-3);">' +
        '<input type="number" id="newQuota" class="form-input" value="500" min="1" style="flex:1;">' +
        '<label class="form-check">' +
          '<input type="checkbox" id="unlimitedQuota" onchange="document.getElementById(\'newQuota\').disabled = this.checked;"> ' + t('Unlimited') +
        '</label>' +
      '</div>' +
    '</div>' +
    '<div class="form-group" style="border-top: 1px solid var(--border-subtle); padding-top: var(--space-4);">' +
      '<label class="form-label" style="margin-bottom: var(--space-3);">' + t('Options') + '</label>' +
      '<label class="form-check" style="margin-bottom: var(--space-2);">' +
        '<input type="checkbox" id="createPlusAddressing"> ' + t('Enable Plus Addressing (auto-create folders for user+tag@domain)') +
      '</label>' +
      '<label class="form-check">' +
        '<input type="checkbox" id="createWelcomeEmail" checked> ' + t('Send welcome email with login details') +
      '</label>' +
    '</div>' +
  '</form>';
}

function openModal() {
  createMode = 'password';
  modalWizard.openContent({
    title: t('Create Email Account'),
    size: 'md',
    body: getCreateEmailFormHtml(),
    footer: '<button type="button" class="btn btn-secondary" onclick="modalWizard.close()">' + t('Cancel') + '</button>' +
            '<button type="submit" form="createForm" class="btn btn-primary" id="createSubmitBtn">' +
            '<i class="ri-add-line" aria-hidden="true"></i> ' + t('Create Account') + '</button>',
    onMount: function(body) {
      updatePasswordStrength();
      setTimeout(function() {
        var el = document.getElementById('newEmailPrefix');
        if (el) el.focus();
      }, 100);
    },
    onClose: function() {}
  });
}

function closeModal() {
  modalWizard.close();
}

async function handleCreate(event) {
  event.preventDefault();
  const prefix = document.getElementById('newEmailPrefix').value.trim().toLowerCase();
  const domain = document.getElementById('newEmailDomain').value;
  const password = document.getElementById('newPassword').value;
  const unlimited = document.getElementById('unlimitedQuota').checked;
  const quota = unlimited ? 0 : parseInt(document.getElementById('newQuota').value, 10);
  const plusAddressing = document.getElementById('createPlusAddressing')?.checked;
  const welcomeEmail = document.getElementById('createWelcomeEmail')?.checked;

  if (!prefix) {
    showToast(t('Please enter a username'), 'error');
    return false;
  }

  if (createMode === 'password' && !password) {
    showToast(t('Please enter a password'), 'error');
    return false;
  }

  const fullEmail = `${prefix}@${domain}`;
  if (emails.find(e => e.email === fullEmail)) {
    showToast(t('Email account already exists'), 'error');
    return false;
  }

  const submitBtn = document.getElementById('createSubmitBtn');
  if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = '<i class="ri-loader-4-line" aria-hidden="true" style="animation: spin 1s linear infinite;"></i> ' + t('Creating...'); }

  try {
    if (isLive) {
      if (createMode === 'invite') {
        const altEmail = document.getElementById('inviteAlternateEmail')?.value?.trim() || '';
        await EmailAPI.createUserWithInvite(prefix, domain, quota, altEmail);
      } else {
        await EmailAPI.createEmailAccount(prefix, domain, password, quota, welcomeEmail);
      }

      // Enable plus addressing if requested
      if (plusAddressing) {
        try {
          await EmailAPI.enablePlusAddressing(fullEmail);
        } catch {} // Non-critical
      }
    }

    emails.push({
      email: fullEmail,
      login: prefix,
      domain: domain,
      used: 0,
      quota: quota,
      isUnlimited: quota === 0,
      status: 'active',
      suspendedLogin: false,
      suspendedIncoming: false,
      suspendedOutgoing: false,
      holdOutgoing: false,
      isMainAccount: false
    });

    updateStats();
    populateDomainFilter();
    renderList();
    closeModal();
    showToast(createMode === 'invite' ? t('Login link sent to {0}', fullEmail) : t('Account {0} created', fullEmail));
  } catch (err) {
    showToast(t('Failed to create account: {0}', err.message), 'error');
  } finally {
    if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = '<i class="ri-add-line" aria-hidden="true"></i> ' + t('Create Account'); }
  }
  return false;
}


// ===================================================================
// MODERN EMAIL VIEW — Domain-grouped data-list
// ===================================================================

function modernBuildEmailDomains() {
  // Group live emails by domain
  var domainMap = {};
  var domainOrder = [];

  for (var i = 0; i < emails.length; i++) {
    var e = emails[i];
    if (!domainMap[e.domain]) {
      domainMap[e.domain] = { domain: e.domain, domainType: 'main', accounts: [] };
      domainOrder.push(e.domain);
    }
    domainMap[e.domain].accounts.push(modernAdaptAccount(e));
  }

  // Try to get domain type info from the global domains array if available
  if (typeof domains !== 'undefined' && Array.isArray(domains)) {
    for (var j = 0; j < domains.length; j++) {
      var d = domains[j];
      if (domainMap[d.domain]) {
        domainMap[d.domain].domainType = d.type || 'main';
      }
    }
  }

  // Only show domains that have email accounts — skip empty ones

  var result = [];
  for (var m = 0; m < domainOrder.length; m++) {
    result.push(domainMap[domainOrder[m]]);
  }
  return result;
}

function modernAdaptAccount(e) {
  // Convert live email object to the shape the modern renderer expects
  var usedMB = Math.round(e.used || 0);
  var quotaMB = Math.round(e.quota || 0);
  var usedStr = usedMB >= 1024 ? (usedMB / 1024).toFixed(1) + ' GB' : usedMB + ' MB';
  var quotaStr = e.isUnlimited ? 'Unlimited' : (quotaMB >= 1024 ? (quotaMB / 1024).toFixed(1) + ' GB' : quotaMB + ' MB');
  var statusStr = e.status === 'suspended' ? 'Suspended' : 'Active';

  return {
    address: e.email,
    used: usedStr,
    usedMB: usedMB,
    quota: quotaStr,
    quotaMB: quotaMB,
    status: statusStr,
    lastAccess: ''
  };
}

function modernGetDomainTypeLabel(t) {
  return { main: 'Main Domain', addon: 'Addon Domain', subdomain: 'Subdomain', alias: 'Alias' }[t] || t;
}
function modernGetDomainIconClass(t) {
  return { main: 'icon-main', addon: 'icon-addon', subdomain: 'icon-subdomain', alias: 'icon-alias' }[t] || 'icon-main';
}

function modernGetTotalStorage(accounts) {
  var total = 0;
  for (var i = 0; i < accounts.length; i++) total += accounts[i].usedMB || 0;
  if (total >= 1024) return (total / 1024).toFixed(1) + ' GB';
  return Math.round(total) + ' MB';
}

function modernGetTotalQuota(accounts) {
  var total = 0;
  for (var i = 0; i < accounts.length; i++) total += accounts[i].quotaMB || 0;
  if (total >= 1024) return (total / 1024).toFixed(1) + ' GB';
  return Math.round(total) + ' MB';
}

function modernGetAllAccounts() {
  var emailDomains = modernBuildEmailDomains();
  var all = [];
  for (var i = 0; i < emailDomains.length; i++) {
    var d = emailDomains[i];
    for (var j = 0; j < d.accounts.length; j++) {
      all.push({ domain: d.domain, domainType: d.domainType, account: d.accounts[j] });
    }
  }
  return all;
}

var modernSortField = 'address';
var modernSortDir = 'asc';

function modernSortAccounts(accounts) {
  return accounts.slice().sort(function(a, b) {
    var va, vb;
    if (modernSortField === 'address') { va = a.account.address; vb = b.account.address; }
    else if (modernSortField === 'storage') { va = a.account.usedMB; vb = b.account.usedMB; }
    else if (modernSortField === 'quota') { va = a.account.quotaMB; vb = b.account.quotaMB; }
    else if (modernSortField === 'status') { va = a.account.status; vb = b.account.status; }
    else { va = a.account.address; vb = b.account.address; }
    if (typeof va === 'string') { va = va.toLowerCase(); vb = vb.toLowerCase(); }
    if (va < vb) return modernSortDir === 'asc' ? -1 : 1;
    if (va > vb) return modernSortDir === 'asc' ? 1 : -1;
    return 0;
  });
}

function modernToggleSort(field) {
  if (modernSortField === field) {
    modernSortDir = modernSortDir === 'asc' ? 'desc' : 'asc';
  } else {
    modernSortField = field;
    modernSortDir = 'asc';
  }
  var s = document.getElementById('modernEmailSearch');
  modernRenderEmailList(s ? s.value : '');
}

function modernSortIcon(field) {
  if (modernSortField !== field) return '<i class="ri-arrow-up-down-line sort-icon" aria-hidden="true"></i>';
  var icon = modernSortDir === 'asc' ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line';
  return '<i class="' + icon + ' sort-icon active" aria-hidden="true"></i>';
}

var modernExpandedDomains = {};
var modernAllEmailExpanded = false;
var modernEmailUserToggled = false;

function modernToggleDomainGroup(domain, badge) {
  modernExpandedDomains[domain] = !modernExpandedDomains[domain];
  badge.classList.toggle('open');
  var container = document.querySelector('.group-children[data-parent="' + domain + '"]');
  if (container) container.classList.toggle('open');
}

function modernToggleAllEmailGroups() {
  modernEmailUserToggled = true;
  modernAllEmailExpanded = !modernAllEmailExpanded;
  var emailDomains = modernBuildEmailDomains();
  for (var i = 0; i < emailDomains.length; i++) {
    if (emailDomains[i].accounts.length > 0) {
      modernExpandedDomains[emailDomains[i].domain] = modernAllEmailExpanded;
    }
  }
  var btn = document.getElementById('toggleAllEmailGroups');
  if (btn) {
    var span = btn.querySelector('span');
    var icon = btn.querySelector('i');
    if (span) span.textContent = modernAllEmailExpanded ? 'Minimize All' : 'Expand All';
    if (icon) icon.className = modernAllEmailExpanded ? 'ri-contract-up-down-line' : 'ri-expand-up-down-line';
  }
  var s = document.getElementById('modernEmailSearch');
  modernRenderEmailList(s ? s.value : '');
}

function modernRenderEmailList(filter) {
  var list = document.getElementById('modernEmailList');
  if (!list) return;
  var q = filter ? filter.toLowerCase() : '';

  var all = modernGetAllAccounts();
  if (q) {
    all = all.filter(function(item) {
      return item.account.address.toLowerCase().indexOf(q) !== -1
        || item.domain.toLowerCase().indexOf(q) !== -1;
    });
  }
  var sorted = modernSortAccounts(all);

  var domainOrder = [];
  var domainMap = {};
  for (var i = 0; i < sorted.length; i++) {
    var d = sorted[i].domain;
    if (!domainMap[d]) {
      domainMap[d] = { domain: d, domainType: sorted[i].domainType, accounts: [] };
      domainOrder.push(d);
    }
    domainMap[d].accounts.push(sorted[i].account);
  }

  // Only show domains that have email accounts (no empty domain rows)

  var totalAccounts = sorted.length;
  var useTreeMode = !modernEmailUserToggled && totalAccounts <= 10;

  var html = '';

  html += '<div class="data-list-head" role="row">'
    + '<div class="sortable" onclick="modernToggleSort(\'address\')" role="columnheader" tabindex="0">Account ' + modernSortIcon('address') + '</div>'
    + '<div class="sortable" onclick="modernToggleSort(\'storage\')" role="columnheader" tabindex="0">Storage ' + modernSortIcon('storage') + '</div>'
    + '<div class="sortable" onclick="modernToggleSort(\'quota\')" role="columnheader" tabindex="0">Quota ' + modernSortIcon('quota') + '</div>'
    + '<div class="sortable" onclick="modernToggleSort(\'status\')" role="columnheader" tabindex="0">Status ' + modernSortIcon('status') + '</div>'
    + '<div role="columnheader"></div>'
    + '</div>';

  if (domainOrder.length === 0) {
    html += '<div style="text-align:center;padding:var(--space-12);color:var(--text-tertiary);">'
      + '<i class="ri-search-line" style="font-size:2rem;display:block;margin-bottom:var(--space-3);" aria-hidden="true"></i>'
      + 'No results match your search'
      + '</div>';
    list.innerHTML = html;
    return;
  }

  for (var i = 0; i < domainOrder.length; i++) {
    var group = domainMap[domainOrder[i]];
    var count = group.accounts.length;
    var totalUsed = modernGetTotalStorage(group.accounts);
    var totalQuota = modernGetTotalQuota(group.accounts);

    html += '<div class="data-list-row domain-parent-row" data-domain="' + esc(group.domain) + '" role="row">'
      + '<div class="cell-name" role="cell">'
      + '<span class="domain-icon icon-' + esc(group.domainType) + '"><i class="ri-global-line" aria-hidden="true"></i></span>'
      + '<span style="display:flex;flex-direction:column;min-width:0;">'
      + '<span class="domain-name-text">' + esc(group.domain) + '</span>'
      + '<span class="domain-type-label">' + esc(modernGetDomainTypeLabel(group.domainType));

    if (count > 0) {
      html += ' <span class="badge-toggle" data-toggle="' + esc(group.domain) + '" onclick="event.stopPropagation(); modernToggleDomainGroup(\'' + esc(group.domain) + '\', this)">'
        + count + ' <i class="ri-arrow-down-s-line" aria-hidden="true"></i></span>';
    }

    html += '</span></span>'
      + '</div>'
      + '<div class="cell" role="cell">' + (count > 0 ? esc(totalUsed) : '') + '</div>'
      + '<div class="cell" role="cell">' + (count > 0 ? esc(totalQuota) : '') + '</div>'
      + '<div class="cell status-ok" role="cell">' + (count > 0 ? 'Delivering' : '') + '</div>'
      + '<div class="cell" role="cell"><button class="btn-manage" onclick="event.stopPropagation()"><i class="ri-mail-add-line" aria-hidden="true"></i> Create</button></div>'
      + '</div>';

    // Default expanded when ≤10, collapsed when >10; user toggle overrides
    var isExpanded = useTreeMode || !!modernExpandedDomains[group.domain];
    html += '<div class="group-children' + (isExpanded ? ' open' : '') + '" data-parent="' + esc(group.domain) + '" role="rowgroup">';
    for (var j = 0; j < group.accounts.length; j++) {
      html += modernRenderAccountRow(group.accounts[j], false);
    }
    html += '</div>';
  }

  list.innerHTML = html;
  modernBindEmailEvents(list);
}

function modernRenderAccountRow(account, isTree) {
  var pct = account.quotaMB > 0 ? Math.round((account.usedMB / account.quotaMB) * 100) : 0;
  var rowClass = 'data-list-row' + (isTree ? ' tree-row' : ' child-row');

  return '<div class="' + rowClass + '" data-account="' + esc(account.address) + '" tabindex="0" role="row">'
    + '<div class="cell-name" role="cell"><span class="domain-icon icon-subdomain icon-sm"><i class="ri-mail-line" aria-hidden="true"></i></span> <span>' + esc(account.address) + '</span></div>'
    + '<div class="cell" role="cell"><div class="storage-mini"><span class="storage-mini-bar"><span class="storage-mini-fill" style="width:' + Math.min(pct, 100) + '%"></span></span> ' + esc(account.used) + '</div></div>'
    + '<div class="cell" role="cell">' + esc(account.quota) + '</div>'
    + '<div class="cell status-ok" role="cell">' + esc(account.status) + '</div>'
    + '<div class="cell" role="cell"><button class="btn-manage" onclick="event.stopPropagation(); modernShowAccount(\'' + esc(account.address) + '\')">Manage</button></div>'
    + '</div>';
}

function modernBindEmailEvents(list) {
  var rows = list.querySelectorAll('.data-list-row');
  for (var j = 0; j < rows.length; j++) {
    rows[j].addEventListener('click', function() {
      var addr = this.getAttribute('data-account');
      if (addr) modernShowAccount(addr);
    });
    rows[j].addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
    });
  }
}

function modernShowAccount(address) {
  var account = null;
  var domainName = '';
  var emailDomains = modernBuildEmailDomains();
  for (var i = 0; i < emailDomains.length; i++) {
    var d = emailDomains[i];
    for (var j = 0; j < d.accounts.length; j++) {
      if (d.accounts[j].address === address) {
        account = d.accounts[j];
        domainName = d.domain;
        break;
      }
    }
    if (account) break;
  }
  if (!account) return;

  var pct = account.quotaMB > 0 ? Math.round((account.usedMB / account.quotaMB) * 100) : 0;

  document.getElementById('modernEmailList').style.display = 'none';
  var fb = document.querySelector('.filter-bar');
  if (fb) fb.style.display = 'none';
  document.getElementById('modernAccountView').style.display = '';

  var html = '<div class="module-header">'
    + '<span class="module-header-icon" style="background:rgba(56,189,248,0.08);color:var(--status-info);"><i class="ri-mail-line" aria-hidden="true"></i></span>'
    + '<div class="module-header-info">'
    + '<h2 class="module-header-title">' + esc(account.address) + '</h2>'
    + '<p class="module-header-meta">on ' + esc(domainName) + ' \xB7 ' + esc(account.status) + '</p>'
    + '</div>'
    + '</div>';

  html += '<div class="account-detail"><div class="account-detail-grid">'
    + '<div><div class="account-field-label">Storage Used</div><div class="account-field-value">' + esc(account.used) + ' of ' + esc(account.quota) + ' (' + pct + '%)</div></div>'
    + '<div><div class="account-field-label">Last Access</div><div class="account-field-value">' + esc(account.lastAccess || 'Never') + '</div></div>'
    + '<div><div class="account-field-label">Status</div><div class="account-field-value status-ok">' + esc(account.status) + '</div></div>'
    + '<div><div class="account-field-label">Domain</div><div class="account-field-value">' + esc(domainName) + '</div></div>'
    + '</div></div>';

  html += '<div style="display:flex;gap:var(--space-2);margin-top:var(--space-6);flex-wrap:wrap;">'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-lock-password-line" aria-hidden="true"></i> Change Password</button>'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-corner-up-right-line" aria-hidden="true"></i> Forwarding</button>'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-reply-line" aria-hidden="true"></i> Autoresponder</button>'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-filter-3-line" aria-hidden="true"></i> Filters</button>'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-smartphone-line" aria-hidden="true"></i> Connect to Device</button>'
    + '<button class="btn btn-sm btn-ghost"><i class="ri-mail-open-line" aria-hidden="true"></i> Open Webmail</button>'
    + '<button class="btn btn-sm" style="background:var(--status-error-bg);color:var(--status-error);border:none;"><i class="ri-delete-bin-line" aria-hidden="true"></i> Delete Account</button>'
    + '</div>';

  document.getElementById('modernAccountDetail').innerHTML = html;
  window.scrollTo(0, 0);
}

// ── Modern view wiring ──

(function() {
  // Back button: hide account detail, reveal list
  var backBtn = document.getElementById('modernBackToEmail');
  if (backBtn) {
    backBtn.addEventListener('click', function() {
      document.getElementById('modernAccountView').style.display = 'none';
      document.getElementById('modernEmailList').style.display = '';
      var fb = document.querySelector('.filter-bar');
      if (fb) fb.style.display = '';
    });
  }

  // Wire search
  var modernSearchEl = document.getElementById('modernEmailSearch');
  if (modernSearchEl) {
    modernSearchEl.addEventListener('input', function() {
      modernRenderEmailList(this.value);
    });
  }

  // Render on init
  modernRenderEmailList();
  modernUpdateToggleAllLabel();
})();

function modernUpdateToggleAllLabel() {
  var allAccounts = modernGetAllAccounts();
  var startExpanded = allAccounts.length <= 10;
  var btn = document.getElementById('toggleAllEmailGroups');
  if (btn) {
    var span = btn.querySelector('span');
    var icon = btn.querySelector('i');
    if (!modernEmailUserToggled && startExpanded) {
      if (span) span.textContent = 'Minimize All';
      if (icon) icon.className = 'ri-contract-up-down-line';
      modernAllEmailExpanded = true;
    }
  }
}


// Init
init();
</script>
[% END %]
