[%
  USE EasyApache;
  SET ea_conf = EasyApache.get_ea_conf();
  SET oldest_supported_php = ea_conf.oldest_supported_version || '8.1';
%]
[% WRAPPER '_assets/master.html.tt'
    page_title = 'Websites'
    page_id    = 'websites'
%]
<style>
/* ═══════════════════════════════════════════════════════════════
   DOMAIN PAGE — SPECIFIC STYLES
   ═══════════════════════════════════════════════════════════════ */

/* page-header, filter-bar, filter-chip are in meridian.css */

/* Domain list table */
.domain-table {
  width: 100%;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-surface);
}

.domain-table-head {
  display: grid;
  grid-template-columns: 1fr 160px 110px 90px 90px;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
  background: var(--bg-muted);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide);
  color: var(--text-tertiary); text-transform: uppercase;
}

/* ── Domain group (hierarchical parent) ── */
.domain-group { border-bottom: 1px solid var(--border-subtle); }
.domain-group:last-child { border-bottom: none; }

.domain-group-header {
  display: grid;
  grid-template-columns: 1fr 160px 110px 90px 90px;
  gap: var(--space-4);
  align-items: center;
  padding: var(--space-4) var(--space-5);
  transition: background var(--duration-fast) var(--ease-out);
  cursor: pointer;
}
.domain-group-header:hover { background: var(--bg-hover); }
.domain-group-header.expanded { background: var(--bg-raised); }

.domain-group-toggle {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: var(--radius-sm);
  font-size: var(--text-xs); color: var(--text-tertiary);
  transition: transform var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out);
  flex-shrink: 0;
}
.domain-group-header.group-open .domain-group-toggle {
  transform: rotate(90deg); color: var(--text-secondary);
}
.domain-group-children-count {
  font-size: var(--text-xs); color: var(--text-tertiary);
  background: var(--bg-muted); border-radius: var(--radius-full);
  padding: 1px 8px; margin-inline-start: var(--space-2);
  font-weight: var(--weight-medium);
}

/* ── Nested children (subdomains/aliases under a parent) ── */
.domain-group-children {
  max-height: 0; overflow: hidden; opacity: 0;
  transition: max-height var(--duration-normal) var(--ease-out),
              opacity var(--duration-normal) var(--ease-out);
  background: var(--bg-muted);
}
.domain-group.group-open > .domain-group-children {
  max-height: 2000px; opacity: 1;
}

.domain-row {
  display: grid;
  grid-template-columns: 1fr 160px 110px 90px 90px;
  gap: var(--space-4);
  align-items: center;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  transition: background var(--duration-fast) var(--ease-out);
  cursor: pointer;
}
.domain-row:last-child { border-bottom: none; }
.domain-row:hover { background: var(--bg-hover); }
.domain-row.expanded { background: var(--bg-raised); }

/* Indented child rows */
.domain-group-children .domain-row {
  padding-inline-start: calc(var(--space-5) + 28px);
  border-bottom-color: var(--border-subtle);
}
.domain-group-children .domain-row:first-child {
  border-top: 1px solid var(--border-subtle);
}
.domain-group-children .domain-icon {
  width: 28px; height: 28px; font-size: var(--text-sm);
}

/* Standalone rows (aliases, domains with no children) */
.domain-row.standalone {
  border-bottom: 1px solid var(--border-subtle);
}
.domain-row.standalone:last-child { border-bottom: none; }

.domain-name {
  display: flex; align-items: center; gap: var(--space-3);
  min-width: 0;
}
.domain-name-text {
  font-weight: var(--weight-semibold); font-size: var(--text-sm);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.domain-name-type {
  font-size: var(--text-xs); color: var(--text-tertiary);
}
.domain-icon {
  width: 36px; height: 36px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--text-md); flex-shrink: 0;
  background: var(--accent-subtle); color: var(--text-brand);
}
.domain-icon.subdomain { background: var(--status-info-bg); color: var(--status-info); }
.domain-icon.addon { background: var(--feature-bg); color: var(--feature-color); }
.domain-icon.alias { background: var(--status-warning-bg); color: var(--status-warning); }

.domain-cell {
  font-size: var(--text-sm); color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.domain-actions {
  display: flex; justify-content: flex-end;
}

/* SSL status indicators */
.ssl-status { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); }
.ssl-dot {
  width: 8px; height: 8px; border-radius: var(--radius-full); flex-shrink: 0;
}
.ssl-dot.valid { background: var(--status-success); }
.ssl-dot.expiring { background: var(--status-warning); }
.ssl-dot.expired { background: var(--status-error); }
.ssl-dot.none { background: var(--text-disabled); }

/* (old inline detail panel removed — now using full-page detail view) */

/* DNS records table */
.dns-table {
  width: 100%; font-size: var(--text-sm);
  border-collapse: collapse;
}
.dns-table th {
  text-align: start;
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide); text-transform: uppercase;
  color: var(--text-tertiary);
  padding: var(--space-2) var(--space-3);
  border-bottom: 1px solid var(--border-subtle);
}
.dns-table td {
  padding: var(--space-3);
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  vertical-align: top;
}
.dns-table tr:last-child td { border-bottom: none; }
.dns-table .dns-type {
  font-family: var(--font-mono); font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  padding: 2px var(--space-2); border-radius: var(--radius-xs);
  background: var(--bg-muted);
}
.dns-table .dns-name {
  font-family: var(--font-mono); font-size: var(--text-xs);
  word-break: break-all;
}
.dns-table .dns-value {
  font-family: var(--font-mono); font-size: var(--text-xs);
  word-break: break-all; max-width: 400px;
}

/* Info grid for domain overview */
.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--space-4);
}
.info-item {}
.info-label {
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide); text-transform: uppercase;
  color: var(--text-tertiary); margin-bottom: var(--space-1);
}
.info-value {
  font-size: var(--text-sm); color: var(--text-primary);
  word-break: break-all;
}
.info-value.mono { font-family: var(--font-mono); font-size: var(--text-xs); }

/* Add domain modal */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(4px);
  z-index: var(--z-modal);
  display: none; align-items: center; justify-content: center;
  padding: var(--space-6);
}
.modal-overlay.show { display: flex; }
.modal {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  width: 100%; max-width: 520px;
  box-shadow: var(--shadow-xl);
  animation: fadeUp var(--duration-normal) var(--ease-out) both;
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--space-6);
}
.modal-close {
  width: 36px; height: 36px; border-radius: var(--radius-md);
  border: none; background: transparent; color: var(--text-tertiary);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: var(--text-lg);
  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
}
.modal-close:hover { background: var(--bg-hover); color: var(--text-primary); }

/* Confirm dialog — now in meridian.css */

/* form-group, form-label, form-input, form-hint, form-select are in meridian.css */

/* Loading spinner */
.spinner {
  width: 20px; height: 20px;
  border: 2px solid var(--border-default);
  border-top-color: var(--accent);
  border-radius: var(--radius-full);
  animation: spin 0.55s linear infinite;
  flex-shrink: 0;
}
.spinner-sm { width: 14px; height: 14px; border-width: 1.5px; }
.spinner-lg { width: 28px; height: 28px; border-width: 2.5px; }
.spinner-inline { display: inline-block; vertical-align: middle; margin-right: var(--space-2); }

/* Feature tags */
.domain-tags { display: flex; flex-wrap: wrap; gap: var(--space-1); }
.domain-tag {
  display: inline-flex; align-items: center; gap: 3px;
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  padding: 2px var(--space-2); border-radius: var(--radius-full);
  line-height: 1.4; letter-spacing: 0.02em; white-space: nowrap;
}
.domain-tag i { font-size: var(--text-xs); }
.domain-tag-wp { background: var(--status-info-bg); color: var(--status-info); }
.domain-tag-sitejet { background: var(--feature-bg); color: var(--feature-color); }
.domain-tag-git { background: var(--accent-subtle); color: var(--text-brand); }
.domain-tag-autossl { background: var(--status-success-bg); color: var(--status-success); }

/* pagination, form-select-sm, filter-select are in meridian.css */

/* detail-view, detail-back, detail-hero*, detail-tabs-bar, stats-row, stat-card are in meridian.css */
/* Page-specific stat-card icon variants */
.stat-card-icon.visitors { background: var(--status-info-bg); color: var(--status-info); }
.stat-card-icon.uptime { background: var(--status-success-bg); color: var(--status-success); }
.stat-card-icon.storage { background: var(--accent-subtle); color: var(--text-brand); }
/* site-info, settings-section, settings-row are in meridian.css */

/* Feature cards in settings panel */
.feature-card {
  display: flex; align-items: center; gap: var(--space-4);
  padding: var(--space-4);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-3);
  transition: background var(--duration-fast) var(--ease-out);
}
.feature-card:hover { background: var(--bg-hover); }
.feature-card-icon {
  width: 40px; height: 40px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--text-lg); flex-shrink: 0;
}
.feature-card-icon.wp { background: var(--status-info-bg); color: var(--status-info); }
.feature-card-icon.sitejet { background: var(--feature-bg); color: var(--feature-color); }
.feature-card-icon.git { background: var(--accent-subtle); color: var(--text-brand); }
.feature-card-body { flex: 1; min-width: 0; }
.feature-card-title { font-size: var(--text-sm); font-weight: var(--weight-semibold); }
.feature-card-desc { font-size: var(--text-xs); color: var(--text-tertiary); margin-top: var(--space-1); }
.feature-card-action { flex-shrink: 0; }

/* (manage button uses .btn .btn-secondary .btn-sm from design system) */

/* ═══════════════════════════════════════════════════════════════
   MODERN VIEW — PAGE-SPECIFIC STYLES FOR OVERVIEW TABS
   ═══════════════════════════════════════════════════════════════ */

/* DNS table (grid variant for modern overview) */
.modern-dns-table {
  width: 100%;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-surface);
}
.modern-dns-table-head {
  display: grid;
  grid-template-columns: 80px 1fr 1fr 80px auto;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
  background: var(--bg-muted);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide);
  color: var(--text-tertiary);
  text-transform: uppercase;
}
.modern-dns-table-row {
  display: grid;
  grid-template-columns: 80px 1fr 1fr 80px auto;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--text-sm);
  color: var(--text-primary);
  align-items: center;
}
.modern-dns-table-row:last-child { border-bottom: none; }
.modern-dns-type-badge {
  display: inline-flex;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  background: var(--bg-muted);
  color: var(--text-secondary);
}
.modern-dns-value {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: var(--text-xs);
  word-break: break-all;
}

/* Empty state within tab */
.tab-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-10) var(--space-6);
  text-align: center;
  color: var(--text-secondary);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
}
.tab-empty i {
  font-size: 2rem;
  color: var(--text-tertiary);
  margin-bottom: var(--space-3);
  display: block;
}
.tab-empty .tab-empty-title {
  font-weight: var(--weight-semibold);
  margin-bottom: 4px;
  color: var(--text-primary);
}
.tab-empty .tab-empty-desc {
  font-size: var(--text-sm);
  max-width: 360px;
  line-height: var(--leading-relaxed);
}

/* Overflow menu for modern view */
.overflow-menu {
  position: relative;
  display: inline-block;
}
.overflow-menu-dropdown {
  display: none;
  position: absolute;
  top: 100%;
  right: 0;
  z-index: 20;
  min-width: 180px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: var(--space-2) 0;
  box-shadow: var(--shadow-lg, 0 8px 24px rgba(0,0,0,.25));
}
.overflow-menu-dropdown.open { display: block; }
.overflow-menu-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  cursor: pointer;
  border: none;
  background: none;
  width: 100%;
  text-align: left;
}
.overflow-menu-item:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════════════════ */

@media (max-width: 1024px) {
  .domain-table-head, .domain-row, .domain-group-header {
    grid-template-columns: 1fr 110px 90px 90px;
  }
  /* Hide Features column on tablet */
  .domain-table-head > *:nth-child(2),
  .domain-row > *:nth-child(2),
  .domain-group-header > *:nth-child(2) { display: none; }
}

@media (max-width: 768px) {
  .domain-table-head, .domain-row, .domain-group-header {
    grid-template-columns: 1fr 90px 90px;
  }
  /* Hide SSL column on mobile */
  .domain-table-head > *:nth-child(3),
  .domain-row > *:nth-child(3),
  .domain-group-header > *:nth-child(3) { display: none; }
}

/* Sitejet publish modal */
.sj-overlay {
  position: fixed; inset: 0; z-index: var(--z-modal, 400);
  background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: opacity var(--duration-normal, 0.2s) var(--ease-out, ease-out);
  pointer-events: none;
}
.sj-overlay.show { opacity: 1; pointer-events: auto; }
.sj-modal {
  background: var(--bg-surface); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl, 16px); padding: var(--space-8);
  max-width: 480px; width: 90%; text-align: center;
  box-shadow: var(--shadow-xl);
  transform: translateY(12px) scale(0.97);
  transition: transform var(--duration-normal, 0.2s) var(--ease-out, ease-out);
}
.sj-overlay.show .sj-modal { transform: translateY(0) scale(1); }
.sj-icon {
  width: 64px; height: 64px; border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto var(--space-4); font-size: var(--text-2xl);
}
.sj-icon-progress { background: var(--feature-bg); color: var(--feature-color); }
.sj-icon-success  { background: var(--status-success-bg); color: var(--status-success); }
.sj-icon-error    { background: var(--status-error-bg); color: var(--status-error); }
.sj-title {
  font-size: var(--text-lg); font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-tight); margin-bottom: var(--space-2);
}
.sj-desc { font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.6; margin-bottom: var(--space-5); }
.sj-domain {
  display: inline-flex; align-items: center; gap: var(--space-2);
  padding: var(--space-1) var(--space-3); background: var(--bg-muted);
  border-radius: var(--radius-md); font-size: var(--text-xs);
  font-family: var(--font-mono); color: var(--text-primary); margin-bottom: var(--space-4);
}
.sj-progress-track {
  width: 100%; height: 6px; background: var(--bg-muted);
  border-radius: var(--radius-full); overflow: hidden; margin-bottom: var(--space-2);
}
.sj-progress-fill {
  height: 100%; background: var(--feature-color); border-radius: var(--radius-full);
  transition: width 0.4s var(--ease-out); width: 0%;
}
.sj-progress-fill.indeterminate {
  width: 30%; animation: sjPulse 1.5s var(--ease-out) infinite;
}
@keyframes sjPulse {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(400%); }
}
.sj-status { font-size: var(--text-xs); color: var(--text-tertiary); margin-bottom: var(--space-5); }
.sj-actions { display: flex; gap: var(--space-3); justify-content: center; }
</style>


<a href="#main-content" class="sr-only" data-t>Skip to main content</a>

<div class="layout-shell">

  <!-- Header -->
  <meridian-header></meridian-header>

  <!-- Sidebar -->
  <meridian-sidebar active="websites"></meridian-sidebar>

  <!-- Main Content -->
  <main class="layout-main" id="main-content">
    <div class="main-content">

      <!-- Page header -->
      <div class="page-header animate-in stagger-1">
        <div class="page-header-left">
          <div>
            <h1 class="page-title" data-t>Websites</h1>
            <div class="page-subtitle" data-t>Manage domains, subdomains, and website settings</div>
          </div>
        </div>
        <div class="page-header-right">
          <button type="button" class="btn btn-ghost btn-sm" id="refreshBtn" aria-label="Refresh domains">
            <i class="ri-refresh-line" aria-hidden="true"></i> <span data-t>Refresh</span>
          </button>
          <button type="button" class="btn btn-primary" id="addDomainBtn">
            <i class="ri-add-line" aria-hidden="true"></i> <span data-t>Add Website</span>
          </button>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar animate-in stagger-2" id="websiteFilterBar" style="margin-bottom:var(--space-4);">
        <div class="filter-search">
          <i class="ri-search-line" aria-hidden="true"></i>
          <input type="search" placeholder="Filter by domain..." id="modernSearch" aria-label="Filter websites" data-t-placeholder>
        </div>
        <button type="button" class="filter-chip" id="toggleAllGroups" onclick="modernToggleAllGroups()">
          <i class="ri-expand-up-down-line" aria-hidden="true"></i> <span data-t>Expand All</span>
        </button>
      </div>

      <!-- Data List with Hierarchy -->
      <div class="data-list websites-grid" id="websiteList" role="table"></div>

      <!-- Domain Detail View (shown when managing a domain) -->
      <div class="detail-view" id="detailView" style="display:none;">
        <button class="detail-back" onclick="closeSettings()" type="button">
          <i class="ri-arrow-left-line" aria-hidden="true"></i> <span data-t>Back to Websites</span>
        </button>

        <div class="detail-hero">
          <div class="detail-hero-left">
            <div class="domain-icon detail-hero-icon" id="detailIcon"><i class="ri-global-line" aria-hidden="true"></i></div>
            <div>
              <h1 class="detail-hero-title" id="detailTitle">example.com</h1>
              <div class="detail-hero-badges" id="detailBadges"></div>
            </div>
          </div>
          <div class="detail-hero-actions" id="detailActions"></div>
        </div>

        <div class="detail-tabs-bar" id="detailTabsBar" role="tablist"></div>

        <div id="detailTabContent"></div>
      </div>

    </div>
  </main>
</div>

<!-- Add Website Modal -->
<div class="modal-overlay" id="addDomainModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal">
    <div class="modal-header">
      <h2 class="t-heading t-heading-md" id="modalTitle" data-t>Add Website</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeModal()">
        <i class="ri-close-line" aria-hidden="true"></i>
      </button>
    </div>
    <form id="addDomainForm" onsubmit="return handleAddDomain(event)">
      <div class="form-group">
        <label for="newDomain" class="form-label" data-t>Domain Name</label>
        <input type="text" id="newDomain" class="form-input" placeholder="example.com" required autocomplete="off">
        <div class="form-hint" data-t>Enter a fully qualified domain name (e.g., example.com)</div>
      </div>
      <div class="form-group">
        <label for="domainType" class="form-label" data-t>Type</label>
        <select id="domainType" class="form-select">
          <option value="addon" data-t>Addon Domain</option>
          <option value="subdomain" data-t>Subdomain</option>
          <option value="alias" data-t>Alias (Parked)</option>
        </select>
      </div>
      <div class="form-group" id="docrootGroup">
        <label for="docroot" class="form-label" data-t>Document Root</label>
        <input type="text" id="docroot" class="form-input" placeholder="/home/user/public_html/example.com">
        <div class="form-hint" data-t>Leave blank to auto-generate based on domain name</div>
      </div>
      <div id="addDomainProgress" style="display:none; margin-top: var(--space-4);">
        <div class="progress-bar"></div>
        <div class="t-body-xs t-muted" style="margin-top: var(--space-2);" id="addDomainStatus" data-t>Setting up domain…</div>
      </div>
      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-6);">
        <button type="button" class="btn btn-secondary" onclick="closeModal()" id="addDomainCancelBtn" data-t>Cancel</button>
        <button type="submit" class="btn btn-primary" id="submitDomainBtn">
          <i class="ri-add-line" aria-hidden="true"></i> <span data-t>Add Website</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Confirm dialog (created dynamically by confirmAction()) -->
<div id="confirmContainer"></div>

<!-- Sitejet publish modal overlay -->
<div class="sj-overlay" id="sjOverlay">
  <div class="sj-modal" id="sjModal"></div>
</div>

<script>
// PHP outdated threshold from EasyApache config (injected by TT at render time)
var PHP_OLDEST_SUPPORTED = '[% oldest_supported_php | html %]' || '8.1';

// Page-specific API helpers (delegates to global CpanelAPI)
const DomainsAPI = {
  async listDomains() {
    // DomainInfo::list_domains returns { main_domain, addon_domains[], sub_domains[], parked_domains[] }
    return CpanelAPI.call('DomainInfo', 'list_domains');
  },

  async domainsData() {
    // DomainInfo::domains_data returns an array of domain objects (list format)
    return CpanelAPI.call('DomainInfo', 'domains_data', { format: 'list' });
  },

  async singleDomainData(domain) {
    return CpanelAPI.call('DomainInfo', 'single_domain_data', { domain });
  },

  async listSSL() {
    // SSL::installed_hosts returns SSL cert info per domain
    return CpanelAPI.call('SSL', 'installed_hosts');
  },

  async getZone(domain) {
    // DNS::parse_zone returns all DNS records for a zone
    return CpanelAPI.call('DNS', 'parse_zone', { zone: domain });
  },

  async addAddonDomain(domain, docroot) {
    return CpanelAPI.call2('AddonDomain', 'addaddondomain', {
      dir: docroot || domain,
      newdomain: domain,
      subdomain: domain.split('.')[0]
    });
  },

  async addSubdomain(subdomain, rootdomain, docroot) {
    return CpanelAPI.call2('SubDomain', 'addsubdomain', {
      domain: subdomain,
      rootdomain: rootdomain,
      dir: docroot || `${subdomain}.${rootdomain}`
    });
  },

  async addAlias(domain) {
    return CpanelAPI.call2('Park', 'park', { domain });
  },

  async removeDomain(domain, type, subdomainPrefix, mainDomain) {
    if (type === 'addon') {
      // Jupiter format: subdomain + "_" + mainDomain (underscore separator)
      // e.g. addon "shop.net" with subdomain prefix "shop" on main "example.com"
      //   → subdomain param = "shop_example.com"
      const subdomain = (subdomainPrefix || domain.split('.')[0]) + '_' + mainDomain;
      return CpanelAPI.call2('AddonDomain', 'deladdondomain', { domain, subdomain });
    }
    if (type === 'subdomain') return CpanelAPI.call2('SubDomain', 'delsubdomain', { domain });
    if (type === 'alias') return CpanelAPI.call2('Park', 'unpark', { domain });
    throw new Error(t('Cannot remove main domain'));
  },

  async getPhpVersions() {
    // LangPHP::php_get_vhost_versions — returns PHP version per vhost
    return CpanelAPI.call('LangPHP', 'php_get_vhost_versions');
  },

  async getInstalledPhpVersions() {
    // LangPHP::php_get_installed_versions — returns available PHP versions
    return CpanelAPI.call('LangPHP', 'php_get_installed_versions');
  },

  async setPhpVersion(vhost, version) {
    // LangPHP::php_set_vhost_versions — sets PHP version for a vhost
    // Jupiter uses indexed params: version + vhost-0, vhost-1, etc.
    return CpanelAPI.call('LangPHP', 'php_set_vhost_versions', {
      version: version,
      'vhost-0': vhost
    });
  },

  async toggleHttpsRedirect(domain, enable) {
    // Jupiter passes domains as comma-separated string
    return CpanelAPI.call('SSL', 'toggle_ssl_redirect_for_domains', {
      state: enable ? 1 : 0,
      domains: domain
    });
  },

  async startAutosslCheck() {
    return CpanelAPI.call('SSL', 'start_autossl_check');
  },

  async isAutosslInProgress() {
    return CpanelAPI.call('SSL', 'is_autossl_check_in_progress');
  },

  async getAutosslProblems(domain) {
    const params = {};
    if (domain) params.domain = domain;
    return CpanelAPI.call('SSL', 'get_autossl_problems', params);
  },

  async listEmailAccounts() {
    // Email::list_pops_with_disk — returns all email accounts with storage info
    return CpanelAPI.call('Email', 'list_pops_with_disk', {
      no_human_readable_keys: 1
    });
  },

  async getWordpressInstances() {
    return CpanelAPI.call('WordPressInstanceManager', 'get_instances');
  },

  async getStats() {
    // StatsBar::get_stats — returns disk, bandwidth, email, domains summary
    return CpanelAPI.call('StatsBar', 'get_stats', {
      display: 'diskusage|bandwidthusage|emailaccounts|addondomains|subdomains|parkeddomains'
    });
  },

  async getResourceUsage() {
    return CpanelAPI.call('ResourceUsage', 'get_usages');
  },

  async checkSitejetAvailable() {
    // Check via UAPI feature flag — avoids theme routing issues with HEAD requests
    try {
      return await CpanelAPI.checkFeature('cpanel-sitejet-plugin');
    } catch {
      return false;
    }
  },

  async getSitejetInfo() {
    return CpanelAPI.call('Sitejet', 'get_all_user_sitejet_info');
  },

  getSitejetUrl(domain, hasSite) {
    const token = CpanelAPI.getToken();
    const base = token ? `/${token}/frontend/jupiter/sitejet/index.html` : '/frontend/jupiter/sitejet/index.html';
    // If the domain already has a site, go to the editor; otherwise go to create
    return hasSite
      ? `${base}#/edit?site_id=${encodeURIComponent(domain)}`
      : `${base}#/create?site_id=${encodeURIComponent(domain)}`;
  },

  getSitejetListUrl() {
    const token = CpanelAPI.getToken();
    return token ? `/${token}/frontend/jupiter/sitejet/index.html#/list` : '/frontend/jupiter/sitejet/index.html#/list';
  },

  // Note: Sitejet restore points are managed within the Sitejet Builder itself.
  // The is_restore_point_available flag from get_all_user_sitejet_info tells us
  // if one exists, but creation/restoration happens inside the Sitejet plugin UI.

  async getQuotaInfo() {
    return CpanelAPI.call('Quota', 'get_local_quota_info');
  },

  async listBackups() {
    return CpanelAPI.call('Backup', 'list_backups');
  },

  async createFullBackup() {
    return CpanelAPI.call('Backup', 'fullbackup_to_homedir');
  },

  async listRedirects() {
    // UAPI Mime::list_redirects (not API2)
    return CpanelAPI.call('Mime', 'list_redirects');
  },

  async addRedirect(domain, src, type, destUrl) {
    // UAPI Mime::add_redirect
    return CpanelAPI.call('Mime', 'add_redirect', {
      domain,
      src,
      redirect: destUrl,
      type: type || 'permanent',
      redirect_wildcard: 0,
      redirect_www: 0
    });
  },

  async deleteRedirect(domain, src) {
    // UAPI Mime::delete_redirect
    return CpanelAPI.call('Mime', 'delete_redirect', {
      domain, src
    });
  },

  fileManagerUrl(dir) {
    const token = CpanelAPI.getToken();
    const base = token ? `/${token}` : '';
    return `${base}/frontend/jupiter/filemanager/index.html?dirselect=homedir&dir=${encodeURIComponent(dir || '')}`;
  }
};


// ═══════════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════════

let domains = [];
let sslMap = {};
let isLive = true;
let hasSitejetFeature = false; // Whether cpanel-sitejet-plugin is available for this user
let sitejetInfo = {}; // Per-domain Sitejet state from Sitejet::get_all_user_sitejet_info
let currentFilter = 'all';
let searchQuery = '';
let expandedGroups = new Set(); // Track which parent domains are expanded to show children
let settingsDomain = null; // Currently open settings panel domain
let installedPhpVersions = []; // Available PHP versions (e.g. [{raw:'ea-php82', display:'8.2'}, ...])
let systemPhpDefault = '';     // System default PHP version (e.g. 'ea-php82')

// Pagination
let currentPage = 1;
let pageSize = 25;
const PAGE_SIZES = [10, 25, 50, 100];


// ═══════════════════════════════════════════════════════════════
// INITIALIZATION
// ═══════════════════════════════════════════════════════════════

function openCpanelPage(page) {
  const token = CpanelAPI.getToken();
  window.open(`/${token}/frontend/jupiter/${page}`, '_blank');
}

async function init() {
  await CpanelAPI.loadFeatures();
  if (typeof applyFeatureGating === 'function') applyFeatureGating();

  try {
    await loadLiveData();
  } catch (err) {
    console.error('Failed to load websites data:', err);
  }

  renderAccountResources();
  renderDomains();
  initAnimations();

  // Feature-gate Add Website modal options
  var domainTypeSelect = document.getElementById('domainType');
  if (domainTypeSelect) {
    if (!CpanelAPI.hasFeature('addondomains')) {
      var addonOpt = domainTypeSelect.querySelector('option[value="addon"]');
      if (addonOpt) addonOpt.disabled = true;
    }
    if (!CpanelAPI.hasFeature('subdomains')) {
      var subOpt = domainTypeSelect.querySelector('option[value="subdomain"]');
      if (subOpt) subOpt.disabled = true;
    }
    if (!CpanelAPI.hasFeature('parkeddomains')) {
      var aliasOpt = domainTypeSelect.querySelector('option[value="alias"]');
      if (aliasOpt) aliasOpt.disabled = true;
    }
    // Select first enabled option
    var firstEnabled = domainTypeSelect.querySelector('option:not([disabled])');
    if (firstEnabled) domainTypeSelect.value = firstEnabled.value;
  }

  // Handle Sitejet callbacks via URL params:
  //   ?action=publish&site_id=domain  → open publish modal (from publish.tt redirect)
  //   ?published=domain               → show success + open domain detail (from modal completion)
  // Handle Sitejet callbacks and hash-based deep links
  (function handleRouting() {
    var params = new URLSearchParams(window.location.search);
    var publishAction = params.get('action');
    var publishSiteId = params.get('site_id');
    var publishedDomain = params.get('published');

    if (publishAction === 'publish' && publishSiteId) {
      // Came from publish.tt redirect — start the publish modal
      history.replaceState(null, '', window.location.pathname);
      sjStartPublish(publishSiteId);
    } else if (publishedDomain) {
      // Post-publish success (from modal "Back to" button)
      history.replaceState(null, '', window.location.pathname);
      showToast(esc(publishedDomain) + ' ' + t('published successfully!'));
      renderDomains();
      setTimeout(function() { navigateToDomain(publishedDomain, 'overview'); }, 200);
    } else if (window.location.hash.indexOf('#manage/') === 0) {
      // Direct deep-link to a domain detail view
      handleHashRoute();
    }
  })();
}

async function loadLiveData() {
  try {
    // Use DomainInfo::list which returns a clean structure:
    //   { main_domain: "example.com",
    //     addon_domains: ["shop.net"],
    //     sub_domains: ["blog.example.com"],
    //     parked_domains: ["alias.com"] }
    //
    // Also try domains_data (format=list) for docroot/IP details.
    // SSL::installed_hosts for certificate status.

    const [listResult, sslResult, phpResult, wpResult, emailResult, statsResult, sitejetAvailable, sitejetInfoResult, autosslProblemsResult, phpInstalledResult, phpDefaultResult] = await Promise.all([
      DomainsAPI.listDomains(),
      DomainsAPI.listSSL().catch(() => ({ data: [] })),
      DomainsAPI.getPhpVersions().catch(() => ({ data: [] })),
      DomainsAPI.getWordpressInstances().catch(() => ({ data: [] })),
      DomainsAPI.listEmailAccounts().catch(() => ({ data: [] })),
      DomainsAPI.getStats().catch(() => ({ data: [] })),
      DomainsAPI.checkSitejetAvailable().catch(() => false),
      DomainsAPI.getSitejetInfo().catch(() => ({ data: {} })),
      DomainsAPI.getAutosslProblems().catch(() => ({ data: [] })),
      DomainsAPI.getInstalledPhpVersions().catch(() => ({ data: { versions: [] } })),
      CpanelAPI.call('LangPHP', 'php_get_system_default_version').catch(() => ({ data: { version: '' } }))
    ]);

    hasSitejetFeature = !!sitejetAvailable;

    // Build per-domain sitejet info map from API response.
    // API returns an array: [{ domain, status: { is_sitejet, ... }, shared_doc_root, redirection_enabled, ... }]
    // We index it by domain name for O(1) lookups.
    sitejetInfo = {};
    const sjData = sitejetInfoResult?.data;
    if (Array.isArray(sjData)) {
      // Array format: [{ domain, status: { is_sitejet, ... }, ... }]
      sjData.forEach(item => {
        if (!item.domain) return;
        sitejetInfo[item.domain] = {
          is_sitejet: !!(item.status && item.status.is_sitejet),
          has_sitejet_website: !!(item.status && item.status.has_sitejet_website),
          has_sitejet_published: !!(item.status && item.status.has_sitejet_published),
          shared_doc_root: !!item.shared_doc_root,
          redirection_enabled: !!item.redirection_enabled,
          is_restore_point_available: !!item.is_restore_point_available
        };
      });
    } else if (sjData && typeof sjData === 'object') {
      // Object format: { "domain.com": { is_sitejet: 1, ... }, ... }
      Object.entries(sjData).forEach(([domain, info]) => {
        if (!domain || typeof info !== 'object') return;
        sitejetInfo[domain] = {
          is_sitejet: !!(info.is_sitejet || (info.status && info.status.is_sitejet)),
          has_sitejet_website: !!(info.has_sitejet_website || (info.status && info.status.has_sitejet_website)),
          has_sitejet_published: !!(info.has_sitejet_published || (info.status && info.status.has_sitejet_published)),
          shared_doc_root: !!info.shared_doc_root,
          redirection_enabled: !!info.redirection_enabled,
          is_restore_point_available: !!info.is_restore_point_available
        };
      });
    }

    const list = listResult.data;
    domains = [];

    if (list) {
      // Main domain
      if (list.main_domain) {
        domains.push({
          domain: list.main_domain,
          type: 'main',
          docroot: '',
          ip: '',
          serveralias: '',
          ssl: { status: 'none', active: false, daysLeft: null },
          features: []
        });
      }

      // Addon domains
      if (Array.isArray(list.addon_domains)) {
        list.addon_domains.forEach(d => {
          domains.push({
            domain: d,
            type: 'addon',
            docroot: '',
            ip: '',
            ssl: { status: 'none', active: false, daysLeft: null },
            features: []
          });
        });
      }

      // Subdomains
      if (Array.isArray(list.sub_domains)) {
        list.sub_domains.forEach(d => {
          domains.push({
            domain: d,
            type: 'subdomain',
            docroot: '',
            ip: '',
            ssl: { status: 'none', active: false, daysLeft: null },
            features: []
          });
        });
      }

      // Parked (alias) domains
      if (Array.isArray(list.parked_domains)) {
        list.parked_domains.forEach(d => {
          domains.push({
            domain: d,
            type: 'alias',
            docroot: '',
            ip: '',
            ssl: { status: 'none', active: false, daysLeft: null },
            features: []
          });
        });
      }
    }

    // Enrich with docroot/IP/HTTPS redirect from domains_data (best-effort)
    try {
      const detailResult = await CpanelAPI.call('DomainInfo', 'domains_data', {
        format: 'list',
        return_https_redirect_status: 1
      });
      const details = detailResult.data;
      const enrichDomain = (d, info) => {
        d.docroot = info.documentroot || info.dir || d.docroot;
        d.ip = info.ip || d.ip;
        d.serveralias = info.serveralias || d.serveralias || '';
        // Store servername for addon domain deletion — the subdomain prefix
        // is derived from servername (e.g. "shop.cpjesse.com" → subdomain "shop")
        if (info.servername) {
          d.servername = info.servername;
        }
        // HTTPS redirect status (included via return_https_redirect_status=1)
        d.httpsRedirect = !!parseInt(info.is_https_redirecting || '0');
      };
      if (Array.isArray(details)) {
        details.forEach(info => {
          const d = domains.find(d => d.domain === info.domain);
          if (d) enrichDomain(d, info);
        });
      } else if (details && typeof details === 'object') {
        Object.values(details).forEach(info => {
          if (info && info.domain) {
            const d = domains.find(d => d.domain === info.domain);
            if (d) enrichDomain(d, info);
          }
        });
      }
    } catch (e) {
      console.warn('Could not fetch domain details:', e);
      // Non-critical — we still have the domain list
    }

    // Map SSL certs to domains
    if (sslResult.data && Array.isArray(sslResult.data)) {
      sslResult.data.forEach(cert => {
        const servername = cert.servername || cert.domain || '';
        const d = domains.find(d => d.domain === servername);
        if (d) {
          // cert.certificate.not_after is a Unix timestamp (seconds)
          const notAfter = cert.certificate?.not_after || cert.not_after || 0;
          const expires = new Date(notAfter * 1000);
          const now = new Date();
          const daysLeft = Math.floor((expires - now) / 86400000);
          const isSelfSigned = !!(cert.certificate && (cert.certificate.is_self_signed === 1 || cert.certificate.is_self_signed === '1'));
          const validationType = (cert.certificate && cert.certificate.validation_type) || '';
          d.ssl = {
            active: true,
            status: daysLeft <= 0 ? 'expired' : daysLeft <= 30 ? 'expiring' : 'valid',
            daysLeft: daysLeft,
            issuer: (cert.certificate && cert.certificate['issuer.organizationName'])
                 || cert.certificate?.issuer?.organizationName
                 || t('Unknown'),
            expires: expires.toISOString().split('T')[0],
            selfSigned: isSelfSigned,
            validationType: validationType
          };
        }
      });
    }

    // HTTPS redirect status is now loaded in the domains_data call above

    // Map PHP versions to domains
    if (phpResult.data && Array.isArray(phpResult.data)) {
      phpResult.data.forEach(info => {
        const vhost = info.vhost || info.documentroot || '';
        const d = domains.find(d => d.domain === vhost || d.docroot === vhost);
        if (d && info.version) {
          d.phpVersion = info.version.replace(/^ea-php/, '').replace(/(\d)(\d)/, '$1.$2');
        }
      });
    }

    // Map WordPress instances to domains
    if (wpResult.data && Array.isArray(wpResult.data)) {
      wpResult.data.forEach(wp => {
        const wpDomain = wp.domain || wp.site_url || '';
        const d = domains.find(d => wpDomain.includes(d.domain));
        if (d) {
          if (!d.features) d.features = [];
          if (!d.features.includes('wordpress')) d.features.push('wordpress');
          d.wpVersion = wp.version || wp.current_version || '';
          d.wpTheme = wp.active_theme || '';
          d.wpAdminUrl = wp.admin_url || `https://${d.domain}/wp-admin/`;
        }
      });
    }

    // Map Sitejet status to domain features
    // Check sitejetInfo map regardless of hasSitejetFeature — API data is authoritative
    domains.forEach(d => {
      const sj = sitejetInfo[d.domain];
      if (sj && (sj.is_sitejet || sj.has_sitejet_website)) {
        if (!d.features) d.features = [];
        if (!d.features.includes('sitejet')) d.features.push('sitejet');
        d.sitejetPublished = !!sj.has_sitejet_published;
        // If we detected Sitejet on any domain, the feature is available
        if (!hasSitejetFeature) hasSitejetFeature = true;
      }
    });

    // Count email accounts per domain
    if (emailResult.data && Array.isArray(emailResult.data)) {
      const emailCounts = {};
      emailResult.data.forEach(acct => {
        const emailDomain = acct.domain || (acct.email || '').split('@')[1] || '';
        emailCounts[emailDomain] = (emailCounts[emailDomain] || 0) + 1;
      });
      domains.forEach(d => {
        d.emailCount = emailCounts[d.domain] || 0;
      });
    }

    // Map AutoSSL problems to domains
    if (autosslProblemsResult.data && Array.isArray(autosslProblemsResult.data)) {
      autosslProblemsResult.data.forEach(prob => {
        const d = domains.find(d => d.domain === prob.domain);
        if (d) {
          d.autosslProblem = prob.problem || 'AutoSSL issue';
        }
      });
    }

    // Determine PHP outdated status using EasyApache's oldest_supported_version
    // (injected from TT as PHP_OLDEST_SUPPORTED, same source Jupiter uses)
    var phpThreshold = parseInt(String(PHP_OLDEST_SUPPORTED).replace('.', ''), 10) || 81;
    domains.forEach(function(d) {
      if (d.phpVersion) {
        // Compare like Jupiter: "7.4" → 74, threshold "8.2" → 82
        var ver = parseInt(String(d.phpVersion).replace('.', ''), 10) || 0;
        d.phpOutdated = ver > 0 && ver < phpThreshold;
      }
    });

    // Build installed PHP versions list for the settings dropdown
    var rawVersions = (phpInstalledResult.data && phpInstalledResult.data.versions) || [];
    installedPhpVersions = rawVersions.map(function(v) {
      // "ea-php82" → { raw: "ea-php82", display: "8.2" }
      var display = String(v).replace(/^ea-php/, '').replace(/(\d)(\d+)$/, '$1.$2');
      return { raw: v, display: display };
    }).sort(function(a, b) {
      return parseFloat(b.display) - parseFloat(a.display); // newest first
    });
    systemPhpDefault = (phpDefaultResult.data && phpDefaultResult.data.version) || '';

    // Store the raw PHP version (ea-php format) on each domain for setPhpVersion
    if (phpResult.data && Array.isArray(phpResult.data)) {
      phpResult.data.forEach(function(info) {
        var vhost = info.vhost || '';
        var d = domains.find(function(d) { return d.domain === vhost; });
        if (d && info.version) {
          d.phpVersionRaw = info.version; // e.g. "ea-php82"
        }
      });
    }

    isLive = true;
    modernSitesCache = null;
    if (typeof modernRenderList === 'function') {
      var modernSearchEl = document.getElementById('modernSearch');
      modernRenderList(modernSearchEl ? modernSearchEl.value : '');
    }

  } catch (err) {
    console.error('Live data error:', err);
  }
}

// Lightweight refresh: only re-fetch domain list + SSL (skips PHP, WP, email, stats).
// Used after add/remove mutations where the heavy enrichment data hasn't changed.
async function refreshDomainList() {
  if (!isLive) return;

  const [listResult, sslResult] = await Promise.all([
    DomainsAPI.listDomains(),
    DomainsAPI.listSSL().catch(() => ({ data: [] }))
  ]);

  const oldDomains = domains;
  const list = listResult.data;
  domains = [];

  if (list) {
    if (list.main_domain) domains.push({ domain: list.main_domain, type: 'main', docroot: '', ip: '', serveralias: '', ssl: { status: 'none', active: false, daysLeft: null }, features: [] });
    (list.addon_domains || []).forEach(d => domains.push({ domain: d, type: 'addon', docroot: '', ip: '', ssl: { status: 'none', active: false, daysLeft: null }, features: [] }));
    (list.sub_domains || []).forEach(d => domains.push({ domain: d, type: 'subdomain', docroot: '', ip: '', ssl: { status: 'none', active: false, daysLeft: null }, features: [] }));
    (list.parked_domains || []).forEach(d => domains.push({ domain: d, type: 'alias', docroot: '', ip: '', ssl: { status: 'none', active: false, daysLeft: null }, features: [] }));
  }

  // Carry over enrichment data (docroot, IP, PHP, features, email) from previous load
  domains.forEach(d => {
    const old = oldDomains.find(o => o.domain === d.domain);
    if (old) {
      d.docroot = old.docroot || d.docroot;
      d.ip = old.ip || d.ip;
      d.serveralias = old.serveralias || d.serveralias;
      d.phpVersion = old.phpVersion;
      d.phpOutdated = old.phpOutdated;
      d.features = old.features || [];
      d.emailCount = old.emailCount;
      d.wpVersion = old.wpVersion;
      d.wpTheme = old.wpTheme;
      d.wpAdminUrl = old.wpAdminUrl;
      d.httpsRedirect = old.httpsRedirect;
      d.autosslProblem = old.autosslProblem;
    }
  });

  // Enrich new domains with docroot/IP (fast call)
  try {
    const detailResult = await DomainsAPI.domainsData();
    const details = detailResult.data;
    if (Array.isArray(details)) {
      details.forEach(info => {
        const d = domains.find(d => d.domain === info.domain);
        if (d) {
          d.docroot = info.documentroot || info.dir || d.docroot;
          d.ip = info.ip || d.ip;
          d.serveralias = info.serveralias || d.serveralias || '';
        }
      });
    }
  } catch (e) { /* non-critical */ }

  // Map SSL
  if (sslResult.data && Array.isArray(sslResult.data)) {
    sslResult.data.forEach(cert => {
      const d = domains.find(d => d.domain === (cert.servername || cert.domain || ''));
      if (d) {
        const notAfter = cert.certificate?.not_after || cert.not_after || 0;
        const expires = new Date(notAfter * 1000);
        const daysLeft = Math.floor((expires - new Date()) / 86400000);
        d.ssl = {
          active: true,
          status: daysLeft <= 0 ? 'expired' : daysLeft <= 30 ? 'expiring' : 'valid',
          daysLeft: daysLeft,
          issuer: (cert.certificate && cert.certificate['issuer.organizationName']) || cert.certificate?.issuer?.organizationName || t('Unknown'),
          expires: expires.toISOString().split('T')[0]
        };
      }
    });
  }

  modernSitesCache = null;
  if (typeof modernRenderList === 'function') {
    var modernSearchEl = document.getElementById('modernSearch');
    modernRenderList(modernSearchEl ? modernSearchEl.value : '');
  }

}


// ═══════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════

async function renderAccountResources() {
  var container = document.getElementById('accountResources');
  if (!container) return;
  // Use the same shared ResourceUsage API + renderer as the dashboard
  try {
    var items = await CpanelAPI.getResourceUsage();
    CpanelAPI.renderUsageCards(container, items);
  } catch(e) {}
}

function getFilteredDomains() {
  return domains.filter(d => {
    if (currentFilter !== 'all' && d.type !== currentFilter) return false;
    if (searchQuery && !d.domain.toLowerCase().includes(searchQuery.toLowerCase())) return false;
    return true;
  });
}

// Get the Sitejet state for a domain.
// Based on the Sitejet plugin's list-domains.component detection logic:
//   'disabled'   → redirection_enabled || shared_doc_root → no buttons
//   'published'  → is_sitejet (index.html contains "ed-element class) → "Edit Site"
//   'editing'    → has_sitejet_website but not is_sitejet → "Continue Editing"
//   'available'  → no Sitejet website created yet → "Try Sitejet AI"
//   null         → Sitejet plugin not available or domain is alias
function getSitejetState(domain) {
  if (!hasSitejetFeature) return null;
  const d = domains.find(x => x.domain === domain);
  if (!d || d.type === 'alias') return null;

  const info = sitejetInfo[domain];
  if (!info) return 'available'; // No info from API = not yet used

  // Builder disabled if domain has redirects or shares docroot with another domain
  if (info.redirection_enabled || info.shared_doc_root) return 'disabled';

  // is_sitejet = index.html on disk contains Sitejet HTML (class "ed-element")
  if (info.is_sitejet) return 'published';

  // has_sitejet_website = websiteId exists in metadata (created but not published, or unpublished)
  if (info.has_sitejet_website) return 'editing';

  return 'available';
}

function renderDomains() {
  const list = document.getElementById('domainList');
  if (!list) return;
  const filtered = getFilteredDomains();

  if (filtered.length === 0) {
    list.innerHTML = `
      <div style="padding: var(--space-12) var(--space-8); text-align: center;">
        <i class="ri-global-line" style="font-size: var(--text-2xl); color: var(--text-disabled); margin-bottom: var(--space-3); display: block;" aria-hidden="true"></i>
        <div class="t-body-sm t-muted" style="margin-bottom: var(--space-2);">${t('No websites found')}</div>
        <div class="t-caption t-dimmed">${searchQuery ? t('Try a different search term') : t('Add your first domain to get started')}</div>
      </div>`;
    var paginationEl = document.getElementById('pagination');
    if (paginationEl) paginationEl.innerHTML = '';
    return;
  }

  // Build hierarchical groups
  // Aliases are parked on the main domain, so they group under it alongside subdomains
  const allParents = domains.filter(d => d.type === 'main' || d.type === 'addon');
  const mainDomain = domains.find(d => d.type === 'main');
  const filteredSubdomains = filtered.filter(d => d.type === 'subdomain');
  const filteredParents = filtered.filter(d => d.type === 'main' || d.type === 'addon');
  const filteredAliases = filtered.filter(d => d.type === 'alias');

  const childMap = new Map();
  const orphans = [];
  const parentDomainsNeeded = new Set();

  // Group subdomains under their parent (main or addon)
  filteredSubdomains.forEach(sub => {
    const parent = allParents.find(p => sub.domain.endsWith('.' + p.domain));
    if (parent) {
      if (!childMap.has(parent.domain)) childMap.set(parent.domain, []);
      childMap.get(parent.domain).push(sub);
      parentDomainsNeeded.add(parent.domain);
    } else {
      orphans.push(sub);
    }
  });

  // Group aliases under the main domain (they're parked on it)
  filteredAliases.forEach(alias => {
    if (mainDomain) {
      if (!childMap.has(mainDomain.domain)) childMap.set(mainDomain.domain, []);
      childMap.get(mainDomain.domain).push(alias);
      parentDomainsNeeded.add(mainDomain.domain);
    } else {
      orphans.push(alias);
    }
  });

  filteredParents.forEach(p => {
    const allChildren = domains.filter(d =>
      (d.type === 'subdomain' && d.domain.endsWith('.' + p.domain)) ||
      (d.type === 'alias' && p.type === 'main')
    );
    if (allChildren.length > 0 && !childMap.has(p.domain)) {
      childMap.set(p.domain, []);
    }
  });

  if (searchQuery) {
    childMap.forEach((children, parent) => {
      if (children.length > 0) expandedGroups.add(parent);
    });
  }

  // Build the flat list of "top-level items" for pagination
  // Each parent group counts as 1 item, orphans each count as 1
  const topLevelItems = [];
  const renderedParents = new Set();

  filteredParents.forEach(p => {
    renderedParents.add(p.domain);
    topLevelItems.push({ type: 'group', parent: p, children: childMap.get(p.domain) || [] });
  });

  parentDomainsNeeded.forEach(parentDomain => {
    if (renderedParents.has(parentDomain)) return;
    const parent = allParents.find(p => p.domain === parentDomain);
    if (!parent) return;
    renderedParents.add(parentDomain);
    topLevelItems.push({ type: 'context-group', parent, children: childMap.get(parentDomain) || [] });
  });

  orphans.forEach(d => topLevelItems.push({ type: 'standalone', domain: d }));

  // Pagination
  const totalItems = topLevelItems.length;
  const totalPages = Math.ceil(totalItems / pageSize);
  if (currentPage > totalPages) currentPage = totalPages || 1;
  const startIdx = (currentPage - 1) * pageSize;
  const pageItems = topLevelItems.slice(startIdx, startIdx + pageSize);

  let html = '';

  pageItems.forEach(item => {
    if (item.type === 'group') {
      const p = item.parent;
      const allChildren = domains.filter(d =>
        (d.type === 'subdomain' && d.domain.endsWith('.' + p.domain)) ||
        (d.type === 'alias' && p.type === 'main')
      );
      const totalChildCount = allChildren.length;
      const isGroupOpen = expandedGroups.has(p.domain);

      if (totalChildCount === 0) {
        html += renderDomainRow(p, false);
      } else {
        html += `<div class="domain-group ${isGroupOpen ? 'group-open' : ''}">`;
        html += renderGroupHeader(p, totalChildCount, isGroupOpen);
        html += `<div class="domain-group-children">`;
        item.children.forEach(child => html += renderDomainRow(child, true));
        html += `</div></div>`;
      }
    } else if (item.type === 'context-group') {
      const allChildren = domains.filter(d =>
        (d.type === 'subdomain' && d.domain.endsWith('.' + item.parent.domain)) ||
        (d.type === 'alias' && item.parent.type === 'main')
      );
      html += `<div class="domain-group group-open">`;
      html += renderGroupHeader(item.parent, allChildren.length, true);
      html += `<div class="domain-group-children">`;
      item.children.forEach(child => html += renderDomainRow(child, true));
      html += `</div></div>`;
    } else {
      html += renderDomainRow(item.domain, false);
    }
  });

  list.innerHTML = html;
  renderPagination(totalItems, totalPages);
}

function renderFeatureTags(d) {
  const features = d.features || [];
  const sjState = getSitejetState(d.domain);
  const tagMap = {
    wordpress: { label: 'WP', css: 'domain-tag-wp', icon: 'ri-wordpress-line' },
    git: { label: 'Git', css: 'domain-tag-git', icon: 'ri-git-branch-line' },
    autossl: { label: 'AutoSSL', css: 'domain-tag-autossl', icon: 'ri-shield-check-line' }
  };
  let tags = features.filter(f => f !== 'sitejet').map(f => {
    const t = tagMap[f];
    return t ? `<span class="domain-tag ${t.css}"><i class="${t.icon}"></i> ${t.label}</span>` : '';
  }).join('');
  // Add Sitejet tag based on detection state
  if (sjState === 'published') {
    tags += `<span class="domain-tag domain-tag-sitejet"><i class="ri-layout-masonry-line" aria-hidden="true"></i> ${t('Sitejet')}</span>`;
  } else if (sjState === 'editing') {
    tags += `<span class="domain-tag domain-tag-sitejet" style="opacity:0.75;"><i class="ri-layout-masonry-line" aria-hidden="true"></i> ${t('Draft')}</span>`;
  }
  return tags ? `<div class="domain-tags">${tags}</div>` : '';
}

function renderGroupHeader(d, childCount, isGroupOpen) {
  const iconMap = { main: 'ri-global-line', addon: 'ri-add-circle-line' };
  const iconClass = d.type === 'addon' ? 'addon' : '';
  const typeLabel = { main: t('Main Domain'), addon: t('Addon') };
  const sslLabel = { valid: t('Valid'), expiring: t('Expiring'), expired: t('Expired'), none: t('None') };

  return `
    <div class="domain-group-header ${isGroupOpen ? 'group-open' : ''}" onclick="toggleGroup('${d.domain}')" tabindex="0" role="row">
      <div class="domain-name">
        <div class="domain-group-toggle" title="${isGroupOpen ? t('Collapse') : t('Expand')} ${t('subdomains')}" aria-label="${t('Toggle subdomains for {0}', escapeHtml(d.domain))}">
          <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
        </div>
        <div class="domain-icon ${iconClass}" aria-hidden="true">
          <i class="${iconMap[d.type] || 'ri-global-line'}"></i>
        </div>
        <div>
          <div class="domain-name-text">${escapeHtml(d.domain)}</div>
          <div class="domain-name-type">${typeLabel[d.type]}<span class="domain-group-children-count">${t('{n} associated domain | {n} associated domains', {n: childCount})}</span></div>
        </div>
      </div>
      <div class="domain-cell">${renderFeatureTags(d)}</div>
      <div class="domain-cell">
        <div class="ssl-status">
          <span class="ssl-dot ${d.ssl.status}" aria-hidden="true"></span>
          ${sslLabel[d.ssl.status]}
        </div>
      </div>
      <div class="domain-cell">
        <span class="badge ${d.type === 'main' ? 'badge-success' : 'badge-neutral'}">${t('Active')}</span>
      </div>
      <div class="domain-actions" onclick="event.stopPropagation()">
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToDomain('${d.domain}')" aria-label="${t('Manage {0}', escapeHtml(d.domain))}">
          <i class="ri-settings-3-line" aria-hidden="true"></i> ${t('Manage')}
        </button>
      </div>
    </div>`;
}

function renderDomainRow(d, isChild) {
  const iconClass = d.type === 'subdomain' ? 'subdomain' : d.type === 'addon' ? 'addon' : d.type === 'alias' ? 'alias' : '';
  const iconMap = { main: 'ri-global-line', subdomain: 'ri-git-branch-line', addon: 'ri-add-circle-line', alias: 'ri-links-line' };
  const typeLabel = { main: t('Main Domain'), subdomain: t('Subdomain'), addon: t('Addon'), alias: t('Alias') };
  const sslLabel = { valid: t('Valid'), expiring: t('Expiring'), expired: t('Expired'), none: t('None') };

  return `
    <div class="domain-row ${!isChild ? 'standalone' : ''}" role="row" tabindex="0">
      <div class="domain-name">
        <div class="domain-icon ${iconClass}" aria-hidden="true">
          <i class="${iconMap[d.type] || 'ri-global-line'}"></i>
        </div>
        <div>
          <div class="domain-name-text">${escapeHtml(d.domain)}</div>
          <div class="domain-name-type">${typeLabel[d.type]}</div>
        </div>
      </div>
      <div class="domain-cell">${renderFeatureTags(d)}</div>
      <div class="domain-cell">
        <div class="ssl-status">
          <span class="ssl-dot ${d.ssl.status}" aria-hidden="true"></span>
          ${sslLabel[d.ssl.status]}
        </div>
      </div>
      <div class="domain-cell">
        <span class="badge ${d.type === 'main' ? 'badge-success' : 'badge-neutral'}">${t('Active')}</span>
      </div>
      <div class="domain-actions">
        <button type="button" class="btn btn-secondary btn-sm" onclick="navigateToDomain('${d.domain}')" aria-label="${t('Manage {0}', escapeHtml(d.domain))}">
          <i class="ri-settings-3-line" aria-hidden="true"></i> ${t('Manage')}
        </button>
      </div>
    </div>`;
}

function renderPagination(totalItems, totalPages) {
  const el = document.getElementById('pagination');
  if (!el) return;
  if (totalPages <= 1) { el.innerHTML = ''; return; }

  const start = (currentPage - 1) * pageSize + 1;
  const end = Math.min(currentPage * pageSize, totalItems);

  let pageButtons = '';
  const maxVisible = 5;
  let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
  let endPage = Math.min(totalPages, startPage + maxVisible - 1);
  if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);

  for (let i = startPage; i <= endPage; i++) {
    pageButtons += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
  }

  el.innerHTML = `
    <div class="pagination-info">
      <span>${t('Showing {0}-{1} of {2}', start, end, totalItems)}</span>
      <select class="form-select-sm" onchange="changePageSize(this.value)" aria-label="${t('Items per page')}">
        ${PAGE_SIZES.map(s => `<option value="${s}" ${s === pageSize ? 'selected' : ''}>${t('{0} per page', s)}</option>`).join('')}
      </select>
    </div>
    <div class="pagination-controls">
      <button class="pagination-btn" onclick="goToPage(${currentPage - 1})" ${currentPage <= 1 ? 'disabled' : ''} aria-label="${t('Previous page')}">
        <i class="ri-arrow-left-s-line" aria-hidden="true"></i>
      </button>
      ${pageButtons}
      <button class="pagination-btn" onclick="goToPage(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''} aria-label="${t('Next page')}">
        <i class="ri-arrow-right-s-line" aria-hidden="true"></i>
      </button>
    </div>`;
}

function goToPage(page) {
  const totalPages = Math.ceil(getFilteredDomains().length / pageSize);
  if (page < 1 || page > totalPages) return;
  currentPage = page;
  renderDomains();
}

function changePageSize(size) {
  pageSize = parseInt(size, 10);
  currentPage = 1;
  renderDomains();
}


// ═══════════════════════════════════════════════════════════════
// SETTINGS PANEL
// ═══════════════════════════════════════════════════════════════

// Deep-link support: #manage/domain.com or #manage/domain.com/tab
function navigateToDomain(domainName, tab) {
  var hash = '#manage/' + encodeURIComponent(domainName);
  if (tab && tab !== 'overview') hash += '/' + tab;
  history.pushState(null, '', hash);
  openSettings(domainName, tab);
}

function navigateToList() {
  history.pushState(null, '', window.location.pathname + window.location.search);
  closeSettings();
}

function handleHashRoute() {
  var hash = window.location.hash;
  var match = hash.match(/^#manage\/([^/]+)(?:\/(.+))?$/);
  if (match) {
    var domain = decodeURIComponent(match[1]);
    var tab = match[2] || 'overview';
    var d = domains.find(function(x) { return x.domain === domain; });
    if (d) {
      openSettings(domain, tab);
      return;
    }
  }
  // No valid hash — show list
  if (settingsDomain) closeSettings();
}

window.addEventListener('popstate', handleHashRoute);

// Build issue banner HTML for a specific tab based on domain data
function getTabIssueBanner(d, tabId) {
  var banners = [];
  var ssl = d.ssl || {};
  var sslStatus = ssl.status || 'none';

  if (tabId === 'ssl') {
    if (sslStatus === 'expired')
      banners.push({ severity: 'error', icon: 'ri-lock-unlock-line', title: t('SSL certificate has expired'), desc: t('Visitors will see a browser security warning when visiting this domain. Renew the certificate or run AutoSSL to resolve this.') });
    else if (sslStatus === 'expiring')
      banners.push({ severity: 'warn', icon: 'ri-lock-line', title: t('SSL certificate expires soon'), desc: t('The certificate expires in {0} days. AutoSSL should renew it automatically. If not, check for AutoSSL issues below.', ssl.expires ? Math.floor((new Date(ssl.expires) - new Date()) / 86400000) : '?') });
    if (ssl.selfSigned)
      banners.push({ severity: 'warn', icon: 'ri-error-warning-line', title: t('Self-signed certificate'), desc: t('This certificate is not trusted by browsers. Visitors will see a security warning. Install a certificate from a trusted authority.') });
    if (sslStatus === 'none')
      banners.push({ severity: 'warn', icon: 'ri-lock-unlock-line', title: t('No SSL certificate installed'), desc: t('This domain has no SSL certificate. HTTP traffic is unencrypted. Run AutoSSL or install a certificate manually.') });
    if (d.autosslProblem)
      banners.push({ severity: 'warn', icon: 'ri-refresh-line', title: t('AutoSSL could not issue a certificate'), desc: escapeHtml(d.autosslProblem) });
  }

  if (tabId === 'settings') {
    if (d.phpOutdated && d.phpVersion)
      banners.push({ severity: 'warn', icon: 'ri-code-s-slash-line', title: t('PHP {0} is no longer supported', d.phpVersion), desc: t('This PHP version has reached end-of-life and no longer receives security updates. Select a newer version below.') });
    if (sslStatus !== 'none' && sslStatus !== 'expired' && !d.httpsRedirect)
      banners.push({ severity: 'info', icon: 'ri-arrow-right-line', title: t('HTTPS redirect is not enabled'), desc: t('You have an active SSL certificate but HTTP traffic is not being redirected. Enable Force HTTPS below to ensure all visitors use a secure connection.') });
  }

  if (tabId === 'overview') {
    // Aggregate — show one summary banner if there are issues
    var allAlerts = [];
    if (sslStatus === 'expired' || sslStatus === 'expiring' || sslStatus === 'none' || ssl.selfSigned || d.autosslProblem)
      allAlerts.push('ssl');
    if (d.phpOutdated || (sslStatus !== 'none' && sslStatus !== 'expired' && !d.httpsRedirect))
      allAlerts.push('settings');
    if (allAlerts.length > 0) {
      var hasCritical = sslStatus === 'expired';
      var tabLinks = allAlerts.map(function(tab) {
        return '<a href="#" onclick="event.preventDefault();switchDetailTab(\'' + tab + '\')" style="font-weight:var(--weight-semibold);color:inherit;text-decoration:underline;">' + { ssl: t('SSL'), settings: t('Settings') }[tab] + '</a>';
      }).join(', ');
      banners.push({
        severity: hasCritical ? 'error' : 'warn',
        icon: hasCritical ? 'ri-error-warning-line' : 'ri-alert-line',
        title: hasCritical ? t('Critical issues need attention') : t('Issues need attention'),
        desc: t('Check the {0} tab for details.', tabLinks)
      });
    }
  }

  if (banners.length === 0) return '';
  var html = '';
  for (var i = 0; i < banners.length; i++) {
    var b = banners[i];
    html += '<div class="tab-issue-banner ' + b.severity + '">';
    html += '<i class="' + b.icon + '" aria-hidden="true"></i>';
    html += '<div class="tab-issue-banner-text"><div class="tab-issue-banner-title">' + b.title + '</div>';
    if (b.desc) html += '<div class="tab-issue-banner-desc">' + b.desc + '</div>';
    html += '</div></div>';
  }
  return html;
}

// Compute dot indicators for detail tabs based on real domain data
function getTabDots(d) {
  var dots = {};
  var ssl = d.ssl || {};
  var sslStatus = ssl.status || 'none';

  // SSL tab: error if expired, warn if expiring/self-signed/missing/autossl issue
  if (sslStatus === 'expired') {
    dots.ssl = 'error';
  } else if (sslStatus === 'expiring' || ssl.selfSigned || sslStatus === 'none' || d.autosslProblem) {
    dots.ssl = 'warn';
  }

  // Settings tab: warn if PHP outdated or HTTPS redirect off (with valid SSL)
  if (d.phpOutdated || (sslStatus !== 'none' && sslStatus !== 'expired' && !d.httpsRedirect)) {
    dots.settings = 'warn';
  }

  // Overview tab: show highest severity dot if any issues exist
  if (dots.ssl === 'error') {
    dots.overview = 'error';
  } else if (dots.ssl === 'warn' || dots.settings === 'warn') {
    dots.overview = 'warn';
  }

  return dots;
}

async function openSettings(domainName, initialTab) {
  const d = domains.find(x => x.domain === domainName);
  if (!d) return;
  settingsDomain = d;

  // Cache for live detail data fetched per-domain
  d._detailCache = d._detailCache || {};

  const typeLabel = { main: t('Main Domain'), subdomain: t('Subdomain'), addon: t('Addon'), alias: t('Alias') };
  const iconClass = d.type === 'subdomain' ? 'subdomain' : d.type === 'addon' ? 'addon' : d.type === 'alias' ? 'alias' : '';
  const iconMap = { main: 'ri-global-line', subdomain: 'ri-git-branch-line', addon: 'ri-add-circle-line', alias: 'ri-links-line' };
  const features = d.features || [];

  // Update hero
  document.getElementById('detailTitle').textContent = d.domain;
  const iconEl = document.getElementById('detailIcon');
  iconEl.className = `domain-icon detail-hero-icon ${iconClass}`;
  iconEl.innerHTML = `<i class="${iconMap[d.type] || 'ri-global-line'}"></i>`;

  // Badges
  let badges = `<span class="badge badge-success">${t('Active')}</span>`;
  if (d.ssl.status === 'valid') badges += `<span class="badge badge-success"><i class="ri-lock-line" aria-hidden="true"></i> ${t('SSL')}</span>`;
  else if (d.ssl.status === 'expiring') badges += `<span class="badge badge-warning"><i class="ri-lock-line" aria-hidden="true"></i> ${t('SSL Expiring')}</span>`;
  else if (d.ssl.status === 'expired') badges += `<span class="badge badge-error"><i class="ri-lock-unlock-line" aria-hidden="true"></i> ${t('SSL Expired')}</span>`;
  if (features.includes('wordpress')) badges += `<span class="badge badge-info"><i class="ri-wordpress-line" aria-hidden="true"></i> ${t('WordPress')}</span>`;
  const sjState = getSitejetState(d.domain);
  if (sjState === 'published') badges += `<span class="badge badge-accent"><i class="ri-layout-masonry-line" aria-hidden="true"></i> ${t('Sitejet')}</span>`;
  else if (sjState === 'editing') badges += `<span class="badge badge-accent" style="opacity:0.8;"><i class="ri-layout-masonry-line" aria-hidden="true"></i> ${t('Sitejet (Draft)')}</span>`;
  document.getElementById('detailBadges').innerHTML = badges;

  // Action buttons
  let actions = `<a href="https://${escapeHtml(d.domain)}" target="_blank" class="btn btn-secondary btn-sm"><i class="ri-external-link-line" aria-hidden="true"></i> ${t('Visit Site')}</a>`;
  if (features.includes('wordpress')) {
    const wpUrl = d.wpAdminUrl || `https://${d.domain}/wp-admin/`;
    actions += `<a href="${escapeHtml(wpUrl)}" target="_blank" class="btn btn-sm" style="background: var(--status-info); color: var(--text-inverse); border-color: var(--status-info);"><i class="ri-wordpress-line" aria-hidden="true"></i> ${t('WP Admin')}</a>`;
  }
  if (sjState === 'published') {
    actions += `<button class="btn btn-secondary btn-sm" style="color: var(--feature-color);" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-edit-line" aria-hidden="true"></i> ${t('Edit Site')}</button>`;
  } else if (sjState === 'editing') {
    actions += `<button class="btn btn-secondary btn-sm" style="color: var(--feature-color);" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-draft-line" aria-hidden="true"></i> ${t('Continue Editing')}</button>`;
  } else if (sjState === 'available' && !features.includes('wordpress')) {
    actions += `<button class="btn btn-secondary btn-sm" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-magic-line" aria-hidden="true"></i> ${t('Try Sitejet AI')}</button>`;
  }
  document.getElementById('detailActions').innerHTML = actions;

  // Tabs — aliases don't have their own vhost, files, or DNS
  const isAlias = d.type === 'alias';

  // Compute tab dot indicators from real data
  const tabDots = getTabDots(d);

  const tabs = [
    { id: 'overview', icon: 'ri-dashboard-line', label: t('Overview') },
    ...(!isAlias ? [{ id: 'files', icon: 'ri-folder-3-line', label: t('Files') }] : []),
    { id: 'dns', icon: 'ri-dns-line', label: t('DNS') },
    { id: 'ssl', icon: 'ri-shield-check-line', label: t('SSL') },
    ...(!isAlias ? [{ id: 'email', icon: 'ri-mail-line', label: t('Email') }] : []),
    ...(!isAlias ? [{ id: 'backups', icon: 'ri-history-line', label: t('Backups') }] : []),
    { id: 'settings', icon: 'ri-settings-3-line', label: t('Settings') }
  ];
  document.getElementById('detailTabsBar').innerHTML = tabs.map((t, i) => {
    var dot = tabDots[t.id] || '';
    var dotHtml = dot ? ` <span class="tab-dot ${dot}"></span>` : '';
    return `<button class="detail-tab ${i === 0 ? 'active' : ''}" onclick="switchDetailTab('${t.id}')" type="button"><i class="${t.icon}"></i> ${t.label}${dotHtml}</button>`;
  }).join('');

  // Render requested tab (default: overview)
  var activeTab = initialTab || 'overview';
  document.querySelectorAll('.detail-tabs-bar .detail-tab').forEach(function(t, i) {
    var tabBtn = tabs[i];
    t.classList.toggle('active', tabBtn && tabBtn.id === activeTab);
  });
  renderDetailTab(activeTab, d);

  // Show detail, hide the data list and filter bar
  document.getElementById('websiteList').style.display = 'none';
  var filterBar = document.getElementById('websiteFilterBar');
  if (filterBar) filterBar.style.display = 'none';
  document.getElementById('detailView').style.display = 'block';

  // Update hash if not already set (for direct calls, not from hash routing)
  var expectedHash = '#manage/' + encodeURIComponent(d.domain);
  if (activeTab !== 'overview') expectedHash += '/' + activeTab;
  if (window.location.hash !== expectedHash) {
    history.replaceState(null, '', expectedHash);
  }
}

function closeSettings() {
  document.getElementById('detailView').style.display = 'none';
  document.getElementById('websiteList').style.display = '';
  var filterBar = document.getElementById('websiteFilterBar');
  if (filterBar) filterBar.style.display = '';
  settingsDomain = null;
  // Clear hash without triggering popstate
  if (window.location.hash) {
    history.replaceState(null, '', window.location.pathname + window.location.search);
  }
}

function switchDetailTab(tabId) {
  var tabs = document.querySelectorAll('.detail-tabs-bar .detail-tab');
  tabs.forEach(function(btn) {
    // Match tab by its onclick attribute containing the tabId
    var isTarget = btn.getAttribute('onclick') && btn.getAttribute('onclick').indexOf("'" + tabId + "'") !== -1;
    btn.classList.toggle('active', isTarget);
  });
  renderDetailTab(tabId, settingsDomain);
  // Update hash to reflect current tab
  if (settingsDomain) {
    var hash = '#manage/' + encodeURIComponent(settingsDomain.domain);
    if (tabId !== 'overview') hash += '/' + tabId;
    history.replaceState(null, '', hash);
  }
}

function renderDetailTab(tabId, d) {
  const el = document.getElementById('detailTabContent');
  const sslLabel = { valid: t('Valid (Let\'s Encrypt)'), expiring: t('Expiring Soon'), expired: t('Expired'), none: t('Not Installed') };
  const features = d.features || [];
  const sjState = getSitejetState(d.domain);

  // Issue banner for this tab (injected at top of content)
  const issueBanner = getTabIssueBanner(d, tabId);

  if (tabId === 'overview') {
    // Use live data if available, otherwise show mock values
    const emailCount = d.emailCount != null ? d.emailCount : 3;
    const wpVersion = d.wpVersion || '6.7';
    const wpTheme = d.wpTheme || 'Astra';

    // Domain type info
    const typeLabels = { main: t('Main Domain'), addon: t('Addon Domain'), subdomain: t('Subdomain'), alias: t('Alias (Parked)') };

    const isAlias = d.type === 'alias';
    const aliasNote = isAlias ? `<div style="padding:var(--space-3) var(--space-4);background:var(--status-info-bg);border:1px solid var(--status-info-border);border-radius:var(--radius-md);margin-bottom:var(--space-5);display:flex;align-items:center;gap:var(--space-3);">
        <i class="ri-links-line" aria-hidden="true" style="color:var(--status-info);font-size:1.1rem;flex-shrink:0;"></i>
        <span class="t-body-sm">${t('This is an alias domain parked on {0}. Visitors to this domain see the same content as the main domain.', '<strong>' + escapeHtml(domains.find(x => x.type === 'main')?.domain || t('main domain')) + '</strong>')}</span>
      </div>` : '';

    el.innerHTML = `${issueBanner}${aliasNote}
      <div class="site-info">
        <div class="site-info-title">${t('Site Information')}</div>
        <div class="site-info-grid">
          <div class="site-info-item">
            <div class="site-info-label">${t('Document Root')}</div>
            <div class="site-info-value mono">${escapeHtml(d.docroot)}</div>
          </div>
          ${d.type !== 'alias' ? `<div class="site-info-item">
            <div class="site-info-label">${t('PHP Version')}</div>
            <div class="site-info-value">${escapeHtml(d.phpVersion || t('N/A'))}</div>
          </div>` : ''}
          <div class="site-info-item">
            <div class="site-info-label">${t('SSL Certificate')}</div>
            <div class="site-info-value ${d.ssl.status === 'valid' ? 'success' : ''}">${d.ssl.status === 'valid' ? t('Valid ({0})', escapeHtml(d.ssl.issuer || t('Unknown'))) : sslLabel[d.ssl.status]}</div>
          </div>
          <div class="site-info-item">
            <div class="site-info-label">${t('SSL Expiry')}</div>
            <div class="site-info-value">${d.ssl.expires ? escapeHtml(d.ssl.expires) : t('N/A')}</div>
          </div>
          ${features.includes('wordpress') ? `
          <div class="site-info-item">
            <div class="site-info-label">${t('WordPress Version')}</div>
            <div class="site-info-value">${escapeHtml(wpVersion)}</div>
          </div>
          <div class="site-info-item">
            <div class="site-info-label">${t('Active Theme')}</div>
            <div class="site-info-value">${escapeHtml(wpTheme)}</div>
          </div>` : ''}
          ${sjState === 'published' ? `
          <div class="site-info-item">
            <div class="site-info-label">${t('Website Builder')}</div>
            <div class="site-info-value" style="color:var(--feature-color);">${t('Sitejet Builder')}</div>
          </div>` : sjState === 'editing' ? `
          <div class="site-info-item">
            <div class="site-info-label">${t('Website Builder')}</div>
            <div class="site-info-value" style="color:var(--feature-color);">${t('Sitejet (Draft)')}</div>
          </div>` : ''}
          <div class="site-info-item">
            <div class="site-info-label">${t('IP Address')}</div>
            <div class="site-info-value mono">${escapeHtml(d.ip || t('N/A'))}</div>
          </div>
          <div class="site-info-item">
            <div class="site-info-label">${t('Domain Type')}</div>
            <div class="site-info-value">${{main:t('Main Domain'),addon:t('Addon Domain'),subdomain:t('Subdomain'),alias:t('Alias (Parked)')}[d.type]}</div>
          </div>
          ${d.type === 'alias' ? `<div class="site-info-item">
            <div class="site-info-label">${t('Parked On')}</div>
            <div class="site-info-value">${escapeHtml(domains.find(x => x.type === 'main')?.domain || t('Main Domain'))}</div>
          </div>` : ''}
          ${d.type === 'main' || d.type === 'subdomain' ? `<div class="site-info-item">
            <div class="site-info-label">${t('HTTPS Redirect')}</div>
            <div class="site-info-value">${d.httpsRedirect ? '<span style="color:var(--status-success);">' + t('Enabled') + '</span>' : t('Disabled')}</div>
          </div>` : d.type === 'addon' || d.type === 'alias' ? `<div class="site-info-item">
            <div class="site-info-label">${t('HTTPS Redirect')}</div>
            <div class="site-info-value t-muted">${t('Inherited from main domain')}</div>
          </div>` : ''}
          <div class="site-info-item">
            <div class="site-info-label">${t('Server Alias')}</div>
            <div class="site-info-value mono">${escapeHtml(d.serveralias || 'www.' + d.domain)}</div>
          </div>
        </div>
      </div>
      ${sjState === 'published' ? `
      <div class="site-info" style="margin-top: var(--space-5);">
        <div class="site-info-title">${t('Website Builder')}</div>
        <div style="border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border-subtle);">
          <div style="display:flex;align-items:center;gap:var(--space-4);padding:var(--space-4);background:var(--feature-bg);">
            <div style="width:44px;height:44px;border-radius:var(--radius-md);background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="ri-layout-masonry-line" aria-hidden="true" style="font-size:1.25rem;color:var(--feature-color);"></i>
            </div>
            <div style="flex:1;min-width:0;">
              <div class="t-body-sm" style="font-weight:var(--weight-semibold);margin-bottom:2px;">${t('Sitejet Builder')}</div>
              <div class="t-body-xs t-muted">${t('Published — live on your site')}</div>
            </div>
            <div style="display:flex;gap:var(--space-2);">
              <button class="btn btn-secondary btn-sm" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')">
                <i class="ri-edit-line" aria-hidden="true"></i> ${t('Edit Site')}
              </button>
            </div>
          </div>
          ${sitejetInfo[d.domain]?.is_restore_point_available ? `
          <div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--bg-surface);border-top:1px solid var(--border-subtle);">
            <i class="ri-history-line" aria-hidden="true" style="color:var(--status-success);font-size:1rem;"></i>
            <div style="flex:1;">
              <span class="t-body-xs" style="color:var(--text-secondary);">${t('Restore point available — managed inside Sitejet Builder')}</span>
            </div>
          </div>` : ''}
        </div>
      </div>
      <div class="site-info" style="margin-top: var(--space-5);">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('Live Preview')}</div>
          <a href="https://${escapeHtml(d.domain)}" target="_blank" class="btn btn-ghost btn-sm"><i class="ri-external-link-line" aria-hidden="true"></i> ${t('Open Site')}</a>
        </div>
        <div id="previewContainer_${escapeHtml(d.domain).replace(/\\./g,'_')}" style="position:relative;border-radius:var(--radius-md);overflow:hidden;border:1px solid var(--border-subtle);background:var(--bg-inset);">
          <div style="position:relative;width:100%;height:0;padding-bottom:56.25%;overflow:hidden;">
            <iframe id="previewFrame_${escapeHtml(d.domain).replace(/\\./g,'_')}" src="https://${escapeHtml(d.domain)}" style="position:absolute;top:0;left:0;width:200%;height:200%;transform:scale(0.5);transform-origin:top left;border:none;pointer-events:none;" loading="lazy" sandbox="allow-scripts allow-same-origin" title="Preview of ${escapeHtml(d.domain)}"></iframe>
          </div>
          <div style="position:absolute;inset:0;cursor:pointer;" onclick="window.open('https://${escapeHtml(d.domain)}','_blank')" title="Click to visit ${escapeHtml(d.domain)}"></div>
        </div>
      </div>` : sjState === 'editing' ? `
      <div class="site-info" style="margin-top: var(--space-5);">
        <div class="site-info-title">${t('Website Builder')}</div>
        <div style="display:flex;align-items:center;gap:var(--space-4);padding:var(--space-4);background:var(--feature-bg);border:1px solid var(--feature-bg);border-radius:var(--radius-md);">
          <div style="width:44px;height:44px;border-radius:var(--radius-md);background:var(--feature-bg);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="ri-layout-masonry-line" aria-hidden="true" style="font-size:1.25rem;color:var(--feature-color);"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="t-body-sm" style="font-weight:var(--weight-semibold);margin-bottom:var(--space-1);">${t('Sitejet Builder')} <span class="badge badge-accent badge-xs" style="vertical-align:middle;">${t('Draft')}</span></div>
            <div class="t-body-xs t-muted">${t('You have an unpublished website in progress. Continue editing or publish when ready.')}</div>
          </div>
          <div style="display:flex;gap:var(--space-2);flex-shrink:0;">
            <button class="btn btn-primary btn-sm" style="background:var(--feature-color);border-color:var(--feature-color);" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')">
              <i class="ri-draft-line" aria-hidden="true"></i> ${t('Continue Editing')}
            </button>
          </div>
        </div>
      </div>` : sjState === 'available' && !features.includes('wordpress') ? `
      <div class="site-info" style="margin-top: var(--space-5);">
        <div class="site-info-title">${t('Website Builder')}</div>
        <div style="display:flex;align-items:center;gap:var(--space-4);padding:var(--space-4);border:1px dashed var(--border-default);border-radius:var(--radius-md);">
          <div style="width:44px;height:44px;border-radius:var(--radius-md);background:var(--bg-muted);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="ri-magic-line" aria-hidden="true" style="font-size:1.25rem;color:var(--text-tertiary);"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="t-body-sm" style="font-weight:var(--weight-semibold);margin-bottom:var(--space-1);">${t('Build a website with Sitejet')}</div>
            <div class="t-body-xs t-muted">${t('Create a professional website with Sitejet AI — no coding required.')}</div>
          </div>
          <button class="btn btn-secondary btn-sm" style="flex-shrink:0;" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')">
            <i class="ri-magic-line" aria-hidden="true"></i> ${t('Try Sitejet AI')}
          </button>
        </div>
      </div>` : ''}`;

    // Set up preview iframe fallback (can't use inline <script> inside template literal)
    if (sjState === 'published') {
      initPreviewFallback(d.domain);
    }

  } else if (tabId === 'dns') {
    el.innerHTML = `
      <div class="site-info" style="margin-bottom: var(--space-4);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4);">
          <div class="site-info-title" style="margin-bottom:0;">${t('DNS Records')}</div>
          <button class="btn btn-secondary btn-sm" onclick="openCpanelPage('zone_editor/index.html')"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Record')}</button>
        </div>
        <div id="detail-dns-loading" style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; color: var(--text-secondary); font-size: var(--text-sm);">
          <div class="spinner"></div> ${t('Loading DNS records...')}
        </div>
        <div id="detail-dns-records"></div>
      </div>`;
    loadDetailDNS(d.domain);

  } else if (tabId === 'ssl') {
    let sslContent = `<div class="site-info-grid" style="margin-bottom: var(--space-5);">
        <div class="site-info-item">
          <div class="site-info-label">${t('Status')}</div>
          <div class="site-info-value"><div class="ssl-status"><span class="ssl-dot ${d.ssl.status}"></span> ${{valid:t('Valid'),expiring:t('Expiring'),expired:t('Expired'),none:t('Not Installed')}[d.ssl.status]}</div></div>
        </div>
        ${d.ssl.issuer ? `<div class="site-info-item"><div class="site-info-label">${t('Issuer')}</div><div class="site-info-value">${escapeHtml(d.ssl.issuer)}</div></div>` : ''}
        ${d.ssl.expires ? `<div class="site-info-item"><div class="site-info-label">${t('Expires')}</div><div class="site-info-value">${d.ssl.expires}</div></div>` : ''}
      </div>`;
    if (d.ssl.status === 'none') {
      sslContent += `<div style="padding:var(--space-4);background:var(--status-info-bg);border:1px solid var(--status-info-border);border-radius:var(--radius-md);">
        <div class="row row-gap-sm" style="margin-bottom:var(--space-2);"><i class="ri-information-line" aria-hidden="true" style="color:var(--status-info);"></i><span class="t-body-sm" style="font-weight:var(--weight-semibold);">${t('No SSL certificate installed')}</span></div>
        <p class="t-body-sm t-muted" style="margin-bottom:var(--space-3);">${t('AutoSSL will provision a free certificate once DNS resolves.')}</p>
        <button class="btn btn-secondary btn-sm" onclick="runAutoSSL()"><i class="ri-refresh-line" aria-hidden="true"></i> ${t('Run AutoSSL')}</button>
      </div>`;
    } else if (d.ssl.status === 'expired') {
      sslContent += `<div style="padding:var(--space-4);background:var(--status-error-bg);border:1px solid var(--status-error-border);border-radius:var(--radius-md);">
        <div class="row row-gap-sm" style="margin-bottom:var(--space-2);"><i class="ri-error-warning-line" aria-hidden="true" style="color:var(--status-error);"></i><span class="t-body-sm" style="font-weight:var(--weight-semibold);">${t('Certificate expired')}</span></div>
        <p class="t-body-sm t-muted" style="margin-bottom:var(--space-3);">${t('Visitors will see a security warning.')}</p>
        <button class="btn btn-primary btn-sm" onclick="runAutoSSL()"><i class="ri-refresh-line" aria-hidden="true"></i> ${t('Renew Certificate')}</button>
      </div>`;
    }
    el.innerHTML = `${issueBanner}<div class="site-info">${sslContent}</div>`;

  } else if (tabId === 'files') {
    const fmUrl = isLive ? DomainsAPI.fileManagerUrl(d.docroot) : '#';
    el.innerHTML = `<div class="site-info">
      <div class="site-info-title">${t('File Manager')}</div>
      <p class="t-body-sm t-muted" style="margin-bottom:var(--space-4);">${t('Manage files in')} <code class="t-mono" style="background:var(--bg-muted);padding:2px 6px;border-radius:var(--radius-xs);">${escapeHtml(d.docroot)}</code></p>
      <a href="${fmUrl}" ${isLive ? '' : 'onclick="event.preventDefault(); showToast(t(\'File Manager not available in mock mode\'), \'info\');"'} class="btn btn-secondary btn-sm"><i class="ri-folder-open-line" aria-hidden="true"></i> ${t('Open File Manager')}</a>
    </div>`;

  } else if (tabId === 'backups') {
    el.innerHTML = `<div class="site-info">
      <div class="site-info-title">${t('Backups')}</div>
      <p class="t-body-sm t-muted" style="margin-bottom:var(--space-4);">${t('Create a full account backup or view existing backups.')}</p>
      <div style="display:flex;gap:var(--space-2); margin-bottom:var(--space-6);">
        <button class="btn btn-primary btn-sm" onclick="createBackup()"><i class="ri-download-line" aria-hidden="true"></i> ${t('Create Full Backup')}</button>
      </div>
      <div class="site-info-title">${t('Available Backups')}</div>
      <div id="backup-list"><div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) 0;color:var(--text-secondary);font-size:var(--text-sm);"><div class="spinner"></div> ${t('Loading backups...')}</div></div>
    </div>`;
    loadBackupList();

  } else if (tabId === 'email') {
    // Show email accounts for this domain
    const domainName = d.domain;
    el.innerHTML = `<div class="site-info">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4);">
        <div class="site-info-title" style="margin-bottom:0;">${t('Email Accounts')}</div>
        <button class="btn btn-primary btn-sm" onclick="window.location.href='email.html'"><i class="ri-add-line" aria-hidden="true"></i> ${t('Create Account')}</button>
      </div>
      <div id="domain-email-list"><div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) 0;color:var(--text-secondary);font-size:var(--text-sm);"><div class="spinner"></div> ${t('Loading email accounts...')}</div></div>
    </div>`;

    // Load email accounts for this domain (live or mock)
    const loadDomainEmails = async () => {
      const listEl = document.getElementById('domain-email-list');
      if (!listEl) return;
      let accounts = [];
      if (isLive) {
        try {
          const result = await CpanelAPI.call('Email', 'list_pops_with_disk', { domain: domainName });
          accounts = (result.data || []).map(a => ({
            email: a.email || `${a.login}@${domainName}`,
            used: parseInt(a._diskused || 0, 10),
            quota: parseInt(a._diskquota || 0, 10),
            isUnlimited: !a._diskquota || a._diskquota === '0' || a._diskquota === 'unlimited'
          }));
        } catch { accounts = []; }
      } else {
        // Mock data
        accounts = [
          { email: `info@${domainName}`, used: 45, quota: 500, isUnlimited: false },
          { email: `admin@${domainName}`, used: 128, quota: 0, isUnlimited: true },
          { email: `support@${domainName}`, used: 12, quota: 250, isUnlimited: false }
        ];
        await new Promise(r => setTimeout(r, 400));
      }

      if (!accounts.length) {
        listEl.innerHTML = `<div style="padding:var(--space-6);text-align:center;border:1px dashed var(--border-default);border-radius:var(--radius-md);">
          <div class="t-body-sm t-muted" style="margin-bottom:var(--space-3);">${t('No email accounts for this domain')}</div>
          <button class="btn btn-secondary btn-sm" onclick="window.location.href='email.html'"><i class="ri-add-line" aria-hidden="true"></i> ${t('Create Account')}</button>
        </div>`;
        return;
      }

      const formatMB = (mb) => mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : mb + ' MB';
      listEl.innerHTML = accounts.map(a => {
        const pct = a.isUnlimited ? 0 : (a.quota > 0 ? Math.min((a.used / a.quota) * 100, 100) : 0);
        const barClass = pct >= 90 ? 'danger' : pct >= 75 ? 'warning' : 'success';
        return `<div style="display:flex;align-items:center;gap:var(--space-4);padding:var(--space-4);border-bottom:1px solid var(--border-subtle);">
          <div style="width:36px;height:36px;border-radius:var(--radius-md);background:var(--feature-bg);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="ri-mail-line" aria-hidden="true" style="color:var(--feature-color);font-size:1rem;"></i>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="t-body-sm" style="font-weight:var(--weight-medium);">${escapeHtml(a.email)}</div>
            <div class="t-body-xs t-muted">${a.isUnlimited ? t('{0} used — Unlimited', formatMB(a.used)) : t('{0} used of {1}', formatMB(a.used), formatMB(a.quota))}</div>
          </div>
          <div style="display:flex;gap:var(--space-2);flex-shrink:0;">
            <button class="btn btn-ghost btn-sm" onclick="window.location.href='../email/#account=${encodeURIComponent(a.email)}'" title="${t('Manage')}"><i class="ri-settings-3-line" aria-hidden="true"></i></button>
          </div>
        </div>`;
      }).join('');
    };
    loadDomainEmails();

  } else if (tabId === 'settings') {
    const isAlias = d.type === 'alias';
    const isMain = d.type === 'main';
    // Aliases don't have their own vhost — they inherit from the main domain.
    // They cannot change document root, PHP version, or HTTPS redirect.
    // Addon/subdomain domains have their own vhost and can change PHP/HTTPS.
    const hasOwnVhost = !isAlias;
    let settingsHtml = '';

    // Domain settings — always shown, but content varies by type
    settingsHtml += `<div class="settings-section">
      <div class="settings-section-title">${t('Domain Settings')}</div>`;

    if (isAlias) {
      const parkedOn = domains.find(x => x.type === 'main');
      settingsHtml += `
        <div style="padding:var(--space-4);background:var(--status-info-bg);border:1px solid var(--status-info-border);border-radius:var(--radius-md);margin-bottom:var(--space-4);">
          <div class="row row-gap-sm" style="margin-bottom:var(--space-2);"><i class="ri-information-line" aria-hidden="true" style="color:var(--status-info);"></i><span class="t-body-sm" style="font-weight:var(--weight-semibold);">${t('Alias Domain')}</span></div>
          <p class="t-body-sm t-muted">${t('This domain is parked on {0}. It shares the same document root, PHP version, and SSL settings. To change these, manage the main domain instead.', '<strong>' + escapeHtml(parkedOn?.domain || t('the main domain')) + '</strong>')}</p>
        </div>`;
    }

    settingsHtml += `<div class="settings-row">
        <span class="settings-row-label"><i class="ri-folder-line" aria-hidden="true"></i> ${t('Document Root')}</span>
        <span class="settings-row-value mono">${escapeHtml(d.docroot || (domains.find(x => x.type === 'main')?.docroot) || '')}</span>
      </div>`;

    // PHP version — only for domains with their own vhost (not aliases)
    if (hasOwnVhost) {
      const currentRaw = d.phpVersionRaw || '';
      const currentDisplay = d.phpVersion || '';
      const sysDefaultDisplay = systemPhpDefault.replace(/^ea-php/, '').replace(/(\d)(\d+)$/, '$1.$2');
      let phpOptions = '';
      if (installedPhpVersions.length > 0) {
        // Inherit option
        phpOptions += `<option value="inherit"${!currentRaw || currentRaw === 'inherit' ? ' selected' : ''}>${t('Inherit')} (${escapeHtml(sysDefaultDisplay)})</option>`;
        for (var pi = 0; pi < installedPhpVersions.length; pi++) {
          var pv = installedPhpVersions[pi];
          var isSelected = pv.raw === currentRaw;
          var label = pv.display;
          if (pv.raw === systemPhpDefault) label += ' (' + t('default') + ')';
          var phpNum = parseInt(String(pv.display).replace('.', ''), 10) || 0;
          var phpThresh = parseInt(String(PHP_OLDEST_SUPPORTED).replace('.', ''), 10) || 81;
          if (phpNum > 0 && phpNum < phpThresh) label += ' [' + t('Outdated') + ']';
          phpOptions += `<option value="${escapeHtml(pv.raw)}"${isSelected ? ' selected' : ''}>${escapeHtml(label)}</option>`;
        }
      } else {
        // Fallback: show only current version
        phpOptions = `<option value="${escapeHtml(currentRaw || currentDisplay)}" selected>${escapeHtml(currentDisplay || t('N/A'))}</option>`;
      }
      settingsHtml += `<div class="settings-row">
        <span class="settings-row-label"><i class="ri-code-s-slash-line" aria-hidden="true"></i> ${t('PHP Version')}</span>
        <span class="settings-row-value">
          <select class="form-select-sm" id="phpVersionSelect" onchange="changePHP('${escapeHtml(d.domain)}', this.value)" style="min-width:140px;">
            ${phpOptions}
          </select>
        </span>
      </div>`;
    }

    // HTTPS redirect — only for domains with their own vhost (not aliases or addons per Jupiter)
    if (d.type === 'main' || d.type === 'subdomain') {
      settingsHtml += `<div class="settings-row">
        <span class="settings-row-label"><i class="ri-lock-line" aria-hidden="true"></i> ${t('Force HTTPS')}</span>
        <span class="settings-row-value">
          <input type="checkbox" class="toggle" ${d.httpsRedirect ? 'checked' : ''} onchange="toggleHTTPS('${d.domain}', this.checked)" role="switch">
        </span>
      </div>`;
    } else if (d.type === 'addon') {
      settingsHtml += `<div class="settings-row">
        <span class="settings-row-label"><i class="ri-lock-line" aria-hidden="true"></i> ${t('Force HTTPS')}</span>
        <span class="settings-row-value t-muted t-body-sm">${t('Inherited from main domain')}</span>
      </div>`;
    }

    settingsHtml += `</div>`;

    // Redirects — only for domains with their own vhost
    if (hasOwnVhost) {
      settingsHtml += `<div class="settings-section">
        <div class="settings-section-title">${t('Redirects')}</div>
        <div id="redirectsList"><div style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) 0;color:var(--text-secondary);font-size:var(--text-sm);"><div class="spinner"></div> ${t('Loading redirects...')}</div></div>
        <button class="btn btn-secondary btn-sm" style="margin-top:var(--space-3);" onclick="showAddRedirectForm('${d.domain}')"><i class="ri-add-line" aria-hidden="true"></i> ${t('Add Redirect')}</button>
        <div id="addRedirectForm" style="display:none; margin-top:var(--space-4); padding:var(--space-4); background:var(--bg-muted); border-radius:var(--radius-md);">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3); margin-bottom:var(--space-3);">
            <div>
              <label class="form-label" style="font-size:var(--text-xs);">${t('Source Path')}</label>
              <input type="text" class="form-input" id="redirectSrc" placeholder="/" style="font-size:var(--text-sm);">
            </div>
            <div>
              <label class="form-label" style="font-size:var(--text-xs);">${t('Destination URL')}</label>
              <input type="text" class="form-input" id="redirectDest" placeholder="https://example.com/new-page" style="font-size:var(--text-sm);">
            </div>
          </div>
          <div style="display:flex; gap:var(--space-2); align-items:center;">
            <select class="form-select-sm" id="redirectType" style="min-width:140px;">
              <option value="permanent">${t('301 (Permanent)')}</option>
              <option value="temp">${t('302 (Temporary)')}</option>
            </select>
            <button class="btn btn-primary btn-sm" onclick="handleAddRedirect('${d.domain}')"><i class="ri-check-line" aria-hidden="true"></i> ${t('Save')}</button>
            <button class="btn btn-ghost btn-sm" onclick="document.getElementById('addRedirectForm').style.display='none'">${t('Cancel')}</button>
          </div>
        </div>
      </div>`;
    }

    // Website features — only for domains with their own vhost
    if (hasOwnVhost) {
      settingsHtml += `<div class="settings-section">
        <div class="settings-section-title">${t('Website Features')}</div>`;

      if (features.includes('wordpress')) {
        settingsHtml += `<div class="feature-card">
          <div class="feature-card-icon wp"><i class="ri-wordpress-line" aria-hidden="true"></i></div>
          <div class="feature-card-body"><div class="feature-card-title">${t('WordPress')}</div><div class="feature-card-desc">${t('WordPress 6.7 installed')}</div></div>
          <div class="feature-card-action"><button class="btn btn-secondary btn-sm">${t('Manage')}</button></div>
        </div>`;
      }
      const settingsSjState = getSitejetState(d.domain);
      if (settingsSjState === 'published') {
        const hasRP = sitejetInfo[d.domain]?.is_restore_point_available;
        settingsHtml += `<div class="feature-card">
          <div class="feature-card-icon sitejet"><i class="ri-layout-masonry-line" aria-hidden="true"></i></div>
          <div class="feature-card-body">
            <div class="feature-card-title">${t('Sitejet Builder')}</div>
            <div class="feature-card-desc">${t('Published — live on your site')}${hasRP ? ' · <span style="color:var(--status-success);"><i class="ri-history-line" aria-hidden="true"></i> ' + t('Restore point available') + '</span>' : ''}</div>
          </div>
          <div class="feature-card-action">
            <button class="btn btn-secondary btn-sm" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-edit-line" aria-hidden="true"></i> ${t('Edit Site')}</button>
          </div>
        </div>`;
      } else if (settingsSjState === 'editing') {
        settingsHtml += `<div class="feature-card">
          <div class="feature-card-icon sitejet"><i class="ri-layout-masonry-line" aria-hidden="true"></i></div>
          <div class="feature-card-body"><div class="feature-card-title">${t('Sitejet Builder')}</div><div class="feature-card-desc">${t('Draft — unpublished site in progress')}</div></div>
          <div class="feature-card-action">
            <button class="btn btn-secondary btn-sm" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-draft-line" aria-hidden="true"></i> ${t('Continue Editing')}</button>
          </div>
        </div>`;
      }
      if (features.includes('git')) {
        settingsHtml += `<div class="feature-card">
          <div class="feature-card-icon git"><i class="ri-git-branch-line" aria-hidden="true"></i></div>
          <div class="feature-card-body"><div class="feature-card-title">${t('Git Version Control')}</div><div class="feature-card-desc">${t('Repository deployed')}</div></div>
          <div class="feature-card-action"><button class="btn btn-secondary btn-sm">${t('View Repo')}</button></div>
        </div>`;
      }
      if (!features.includes('wordpress') && settingsSjState !== 'published' && settingsSjState !== 'editing') {
        settingsHtml += `<div style="padding:var(--space-4);border:1px dashed var(--border-default);border-radius:var(--radius-md);text-align:center;">
          <div class="t-body-sm t-muted" style="margin-bottom:var(--space-3);">${t('No website builder active')}</div>
          <div style="display:flex;gap:var(--space-2);justify-content:center;">
            <button class="btn btn-secondary btn-sm" onclick="openCpanelPage('wp_toolkit/index.html')"><i class="ri-wordpress-line" aria-hidden="true"></i> ${t('Install WordPress')}</button>
            ${settingsSjState === 'available' ? `<button class="btn btn-secondary btn-sm" onclick="launchSitejetBuilder('${escapeHtml(d.domain)}')"><i class="ri-palette-line" aria-hidden="true"></i> ${t('Use Sitejet')}</button>` : ''}
          </div>
        </div>`;
      }
      settingsHtml += `</div>`;
    }

    // Danger zone — not for main domain
    if (!isMain) {
      settingsHtml += `<div class="settings-section" style="border-bottom:none;">
        <div class="settings-section-title" style="color:var(--status-error);">${t('Danger Zone')}</div>
        <button type="button" class="btn btn-danger btn-sm" onclick="handleRemoveDomain('${d.domain}', '${d.type}')">
          <i class="ri-delete-bin-line" aria-hidden="true"></i> ${t('Remove Domain')}
        </button>
      </div>`;
    }

    el.innerHTML = issueBanner + settingsHtml;

    // Enhance native selects into custom dropdowns
    if (typeof MeridianSelect !== 'undefined') {
      el.querySelectorAll('select.form-select-sm, select.form-select').forEach(function(sel) {
        MeridianSelect.enhance(sel);
      });
    }

    // Async-load data for settings sections
    if (hasOwnVhost) loadRedirects(d.domain);
  }
}

async function loadDetailDNS(domain) {
  const loadingEl = document.getElementById('detail-dns-loading');
  const recordsEl = document.getElementById('detail-dns-records');
  if (!loadingEl || !recordsEl) return;

  try {
    let records;
    const result = await DomainsAPI.getZone(domain);
    records = (result.data || [])
      .filter(r => r.type === 'record')
      .map(r => {
        const name = r.dname_raw || (r.dname_b64 ? atob(r.dname_b64) : '') || r.dname || '';
        const fullName = name ? (name.endsWith('.') ? name : name + '.' + domain + '.') : domain + '.';
        let value = '';
        if (Array.isArray(r.data_b64)) {
          value = r.data_b64.map(d => { try { return atob(d); } catch(e) { return d; } }).join(' ');
        } else if (Array.isArray(r.data)) {
          value = r.data.join(' ');
        }
        return { type: r.record_type, name: fullName, ttl: r.ttl, value };
      });
    loadingEl.style.display = 'none';
    if (!records.length) { recordsEl.innerHTML = '<p class="t-body-sm t-muted">' + t('No DNS records found.') + '</p>'; return; }
    recordsEl.innerHTML = `<table class="dns-table">
      <thead><tr><th>${t('Type')}</th><th>${t('Name')}</th><th>${t('TTL')}</th><th>${t('Value')}</th></tr></thead>
      <tbody>${records.map(r => `<tr>
        <td><span class="dns-type">${escapeHtml(r.type)}</span></td>
        <td class="dns-name">${escapeHtml(r.name)}</td>
        <td>${r.ttl}</td>
        <td class="dns-value">${escapeHtml(r.value)}</td>
      </tr>`).join('')}</tbody>
    </table>`;
  } catch (err) {
    loadingEl.innerHTML = `<i class="ri-error-warning-line" aria-hidden="true" style="color:var(--status-error);"></i> ${t('Failed to load DNS:')} ${escapeHtml(err.message)}`;
  }
}

function changePHP(domain, version) {
  const d = domains.find(x => x.domain === domain);
  if (!d) return;

  // version is the raw ea-php format (e.g. "ea-php83") or "inherit"
  const displayVersion = version === 'inherit'
    ? systemPhpDefault.replace(/^ea-php/, '').replace(/(\d)(\d+)$/, '$1.$2')
    : version.replace(/^ea-php/, '').replace(/(\d)(\d+)$/, '$1.$2');

  // Save previous state for rollback
  const prevVersion = d.phpVersion;
  const prevRaw = d.phpVersionRaw;
  const prevOutdated = d.phpOutdated;

  // Optimistic update — apply immediately
  d.phpVersion = displayVersion;
  d.phpVersionRaw = version;
  var verNum = parseInt(String(displayVersion).replace('.', ''), 10) || 0;
  var threshNum = parseInt(String(PHP_OLDEST_SUPPORTED).replace('.', ''), 10) || 81;
  d.phpOutdated = verNum > 0 && verNum < threshNum;
  modernSitesCache = null;
  showToast(t('PHP version set to {0} for {1}', displayVersion, domain));

  // Fire API in background — revert on failure
  if (isLive) {
    DomainsAPI.setPhpVersion(domain, version).catch(function(err) {
      d.phpVersion = prevVersion;
      d.phpVersionRaw = prevRaw;
      d.phpOutdated = prevOutdated;
      modernSitesCache = null;
      showToast(t('Failed to set PHP version: {0}', err.message), 'error');
      // Revert the dropdown if still on this domain's settings
      var sel = document.getElementById('phpVersionSelect');
      if (sel) sel.value = prevRaw || prevVersion;
    });
  }
}

function toggleHTTPS(domain, enabled) {
  const d = domains.find(x => x.domain === domain);
  if (!d) return;

  // Optimistic update
  var prev = d.httpsRedirect;
  d.httpsRedirect = enabled;
  modernSitesCache = null;
  showToast(t('HTTPS redirect {0} for {1}', enabled ? t('enabled') : t('disabled'), domain));

  if (isLive) {
    // For addon domains, Jupiter requires passing both the addon and its subdomain
    var domainList = domain;
    if (d.type === 'addon' && d.servername) {
      domainList = domain + ',' + d.servername;
    }
    DomainsAPI.toggleHttpsRedirect(domainList, enabled).catch(function(err) {
      d.httpsRedirect = prev;
      modernSitesCache = null;
      showToast(t('Failed to toggle HTTPS: {0}', err.message), 'error');
      var toggle = document.querySelector('#detailTabContent .toggle');
      if (toggle) toggle.checked = prev;
    });
  }
}

async function runAutoSSL() {
  try {
    if (isLive) {
      await DomainsAPI.startAutosslCheck();
      showToast(t('AutoSSL check started. Certificates will be provisioned automatically.'));
    } else {
      showToast(t('AutoSSL check started. Certificates will be provisioned automatically.'));
    }
  } catch (err) {
    showToast(t('AutoSSL failed: {0}', err.message), 'error');
  }
}

async function loadBackupList() {
  const el = document.getElementById('backup-list');
  if (!el) return;

  try {
    if (isLive) {
      const result = await DomainsAPI.listBackups();
      const backups = result.data || [];
      if (!backups.length && !Array.isArray(backups)) {
        // list_backups may return an object with keys
        const items = Object.values(backups).flat().filter(Boolean);
        renderBackupItems(el, items);
      } else {
        renderBackupItems(el, Array.isArray(backups) ? backups : []);
      }
    } else {
      await new Promise(r => setTimeout(r, 400));
      renderBackupItems(el, [
        { file: 'backup-2026-03-01.tar.gz', date: '2026-03-01', size: '245 MB' },
        { file: 'backup-2026-02-15.tar.gz', date: '2026-02-15', size: '230 MB' }
      ]);
    }
  } catch (err) {
    el.innerHTML = `<p class="t-body-sm t-muted">${t('Could not load backups: {0}', escapeHtml(err.message))}</p>`;
  }
}

function renderBackupItems(el, backups) {
  if (!backups.length) {
    el.innerHTML = '<p class="t-body-sm t-muted">' + t('No backups found.') + '</p>';
    return;
  }
  el.innerHTML = backups.map(b => {
    const name = b.file || b.backupID || b;
    const date = b.date || b.timestamp || '';
    const size = b.size || '';
    return `<div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-3);border:1px solid var(--border-subtle);border-radius:var(--radius-md);margin-bottom:var(--space-2);">
      <div>
        <div class="t-body-sm" style="font-weight:var(--weight-medium);">${escapeHtml(String(name))}</div>
        ${date ? `<div class="t-caption t-muted">${escapeHtml(String(date))}${size ? ' — ' + escapeHtml(String(size)) : ''}</div>` : ''}
      </div>
      <button class="btn btn-ghost btn-sm"><i class="ri-download-2-line" aria-hidden="true"></i></button>
    </div>`;
  }).join('');
}

async function createBackup() {
  try {
    if (isLive) {
      await DomainsAPI.createFullBackup();
      showToast(t('Full backup started. You will receive an email when it completes.'));
    } else {
      showToast(t('Full backup started. You will receive an email when it completes.'));
    }
  } catch (err) {
    showToast(t('Backup failed: {0}', err.message), 'error');
  }
}

async function loadRedirects(domain) {
  const el = document.getElementById('redirectsList');
  if (!el) return;

  try {
    if (isLive) {
      const result = await DomainsAPI.listRedirects();
      const redirects = (result.data || []).filter(r =>
        r.domain === domain || r.domain === '.' + domain
      );
      renderRedirectItems(el, redirects, domain);
    } else {
      await new Promise(r => setTimeout(r, 300));
      renderRedirectItems(el, [], domain);
    }
  } catch (err) {
    el.innerHTML = `<p class="t-body-sm t-muted">${t('No redirects configured.')}</p>`;
  }
}

function renderRedirectItems(el, redirects, domain) {
  if (!redirects.length) {
    el.innerHTML = '<p class="t-body-sm t-muted">' + t('No redirects configured.') + '</p>';
    return;
  }
  el.innerHTML = redirects.map(r => {
    const src = r.sourceurl || r.src || '/';
    const dest = r.desturl || r.targurl || '';
    const type = r.statuscode || r.redirect || '301';
    return `<div style="display:flex;align-items:center;justify-content:space-between;padding:var(--space-3);border:1px solid var(--border-subtle);border-radius:var(--radius-md);margin-bottom:var(--space-2);">
      <div style="min-width:0;flex:1;">
        <div class="t-body-sm" style="font-weight:var(--weight-medium);">
          <span class="badge badge-neutral">${escapeHtml(String(type))}</span>
          <span class="mono" style="margin-left:var(--space-2);">${escapeHtml(String(src))}</span>
        </div>
        <div class="t-caption t-muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">→ ${escapeHtml(String(dest))}</div>
      </div>
      <button class="btn btn-ghost btn-sm" style="color:var(--status-error);" onclick="handleDeleteRedirect('${escapeHtml(domain)}','${escapeHtml(String(src))}','${escapeHtml(String(type))}')"><i class="ri-delete-bin-line" aria-hidden="true"></i></button>
    </div>`;
  }).join('');
}

function showAddRedirectForm(domain) {
  const form = document.getElementById('addRedirectForm');
  if (form) form.style.display = 'block';
}

async function handleAddRedirect(domain) {
  const src = document.getElementById('redirectSrc').value.trim() || '/';
  const dest = document.getElementById('redirectDest').value.trim();
  const type = document.getElementById('redirectType').value;

  if (!dest) { showToast(t('Please enter a destination URL.'), 'error'); return; }

  try {
    if (isLive) {
      await DomainsAPI.addRedirect(domain, src, type, dest);
    }
    showToast(t('Redirect added: {0} → {1}', src, dest));
    document.getElementById('addRedirectForm').style.display = 'none';
    loadRedirects(domain);
  } catch (err) {
    showToast(t('Failed to add redirect: {0}', err.message), 'error');
  }
}

async function handleDeleteRedirect(domain, src, type) {
  const confirmed = await confirmDangerAction({
    title: t('Remove Redirect'),
    message: t('Remove the redirect for {0}?', '<strong>' + escapeHtml(src) + '</strong>'),
    confirmText: t('Remove'),
    variant: 'warning'
  });
  if (!confirmed) return;
  try {
    if (isLive) {
      await DomainsAPI.deleteRedirect(domain, src, type);
    }
    showToast(t('Redirect removed'));
    loadRedirects(domain);
  } catch (err) {
    showToast(t('Failed to remove redirect: {0}', err.message), 'error');
  }
}

// Load installed PHP versions into the settings dropdown
async function loadPhpVersionOptions(currentVersion) {
  const sel = document.getElementById('phpVersionSelect');
  if (!sel) return;

  if (isLive) {
    try {
      const result = await DomainsAPI.getInstalledPhpVersions();
      const rawVersions = result.data || [];

      // php_get_installed_versions returns an array of strings like "ea-php81", "ea-php82"
      // or objects with a version key. Normalize to display format.
      const versions = (Array.isArray(rawVersions) ? rawVersions : [])
        .map(v => {
          const raw = (v.version || v).toString();
          // Keep the raw ea-phpXX value for the API call, display as X.X
          const display = raw.replace(/^ea-php/, '').replace(/^(\d)(\d)$/, '$1.$2');
          return { raw, display };
        })
        .filter(v => v.display); // filter out empty

      if (versions.length > 0) {
        sel.innerHTML = versions.map(v =>
          `<option value="${escapeHtml(v.raw)}" ${v.display === currentVersion || v.raw === currentVersion ? 'selected' : ''}>${escapeHtml(v.display)}</option>`
        ).join('');
        return;
      }
    } catch (e) {
      console.warn('Could not load PHP versions:', e);
    }

    // Live fallback: only show the current version (don't guess)
    sel.innerHTML = `<option value="${escapeHtml(currentVersion)}" selected>${escapeHtml(currentVersion)}</option>`;
  } else {
    // Mock mode: show common versions
    sel.innerHTML = ['8.1', '8.2', '8.3', '8.4'].map(v =>
      `<option value="${v}" ${v === currentVersion ? 'selected' : ''}>${v}</option>`
    ).join('');
  }
}


// ═══════════════════════════════════════════════════════════════
// INTERACTIONS
// ═══════════════════════════════════════════════════════════════

function toggleGroup(parentDomain) {
  if (expandedGroups.has(parentDomain)) {
    expandedGroups.delete(parentDomain);
  } else {
    expandedGroups.add(parentDomain);
  }
  renderDomains();
}


// ═══════════════════════════════════════════════════════════════
// ADD / REMOVE DOMAIN
// ═══════════════════════════════════════════════════════════════

function openModal() {
  document.getElementById('addDomainModal').classList.add('show');
  document.getElementById('newDomain').focus();
}

function closeModal() {
  document.getElementById('addDomainModal').classList.remove('show');
  document.getElementById('addDomainForm').reset();
  document.getElementById('addDomainProgress').style.display = 'none';
}

async function handleAddDomain(e) {
  e.preventDefault();
  const domain = document.getElementById('newDomain').value.trim();
  const type = document.getElementById('domainType').value;
  const docroot = document.getElementById('docroot').value.trim();
  const btn = document.getElementById('submitDomainBtn');

  if (!domain) return;

  const progressEl = document.getElementById('addDomainProgress');
  const statusEl = document.getElementById('addDomainStatus');
  const cancelBtn = document.getElementById('addDomainCancelBtn');

  btn.disabled = true;
  btn.classList.add('btn-loading');
  cancelBtn.disabled = true;
  progressEl.style.display = 'block';
  statusEl.textContent = t('Creating domain…');

  try {
    if (isLive) {
      if (type === 'addon') await DomainsAPI.addAddonDomain(domain, docroot);
      else if (type === 'subdomain') {
        const parts = domain.split('.');
        const sub = parts[0];
        const root = parts.slice(1).join('.');
        await DomainsAPI.addSubdomain(sub, root, docroot);
      }
      else if (type === 'alias') await DomainsAPI.addAlias(domain);

      // Jupiter pattern: for alias, skip extra API call. For addon/subdomain,
      // fetch single_domain_data to get servername (needed for future deletion).
      if (type === 'alias') {
        const mainDom = domains.find(d => d.type === 'main');
        domains.push({
          domain, type, docroot: mainDom?.docroot || '', ip: mainDom?.ip || '',
          ssl: { status: 'none', active: false, daysLeft: null }, features: []
        });
      } else {
        statusEl.textContent = t('Fetching domain details…');
        try {
          const singleResult = await CpanelAPI.call('DomainInfo', 'single_domain_data', {
            domain, return_https_redirect_status: 1
          });
          const info = singleResult.data || {};
          domains.push({
            domain, type,
            docroot: info.documentroot || info.dir || docroot || '',
            ip: info.ip || '', servername: info.servername || '',
            serveralias: info.serveralias || '',
            ssl: { status: 'none', active: false, daysLeft: null }, features: [],
            httpsRedirect: !!parseInt(info.is_https_redirecting || '0')
          });
        } catch (e) {
          domains.push({ domain, type, docroot: docroot || '', ip: '', ssl: { status: 'none', active: false, daysLeft: null }, features: [] });
        }
      }
    } else {
      await new Promise(r => setTimeout(r, 800));
      domains.push({
        domain, type,
        docroot: docroot || `/home/cpuser/${domain}`,
        ssl: { status: 'none', active: false, daysLeft: null }, ip: '192.168.1.100', features: []
      });
    }

    renderDomains();
    closeModal();
    showToast(t('{0} added successfully', domain));
  } catch (err) {
    showToast(t('Failed to add domain: {0}', err.message), 'error');
  } finally {
    btn.disabled = false;
    btn.classList.remove('btn-loading');
    cancelBtn.disabled = false;
    progressEl.style.display = 'none';
  }
}

async function handleRemoveDomain(domain, type) {
  const confirmed = await confirmDangerAction({
    title: t('Remove Domain'),
    message: t('Are you sure you want to remove {0}? This will delete all associated files, email accounts, and DNS records. This action cannot be undone.', '<strong>' + escapeHtml(domain) + '</strong>'),
    confirmText: t('Remove Domain'),
    variant: 'danger'
  });
  if (!confirmed) return;

  // Show loading on the remove button and busy state on the settings panel
  const removeBtn = document.querySelector(`[onclick*="handleRemoveDomain('${domain}'"]`);
  if (removeBtn) {
    removeBtn.disabled = true;
    removeBtn.classList.add('btn-loading');
  }
  // Show row-level busy overlay on the detail panel
  const detailPanel = document.getElementById('domainDetail');
  if (detailPanel) {
    detailPanel.classList.add('row-busy');
    const busyEl = document.createElement('div');
    busyEl.className = 'row-busy-spinner';
    busyEl.innerHTML = '<div class="spinner"></div> ' + t('Removing domain…');
    detailPanel.appendChild(busyEl);
  }

  try {
    if (isLive) {
      const domObj = domains.find(d => d.domain === domain);
      const mainDom = domains.find(d => d.type === 'main');
      let subPrefix = domain.split('.')[0];
      if (domObj?.servername && mainDom) {
        const suffix = '.' + mainDom.domain;
        if (domObj.servername.endsWith(suffix)) {
          subPrefix = domObj.servername.slice(0, -suffix.length);
        }
      }
      await DomainsAPI.removeDomain(domain, type, subPrefix, mainDom ? mainDom.domain : '');

      domains = domains.filter(d => d.domain !== domain);
      if (type === 'addon' && mainDom) {
        const autoSub = domain.split('.')[0] + '.' + mainDom.domain;
        domains = domains.filter(d => d.domain !== autoSub);
      }
    } else {
      await new Promise(r => setTimeout(r, 800));
      domains = domains.filter(d => d.domain !== domain);
    }

    if (settingsDomain) closeSettings();
    renderDomains();
    showToast(t('{0} removed', domain));
  } catch (err) {
    // Clear busy state on error so user can retry
    if (detailPanel) {
      detailPanel.classList.remove('row-busy');
      const busySpinner = detailPanel.querySelector('.row-busy-spinner');
      if (busySpinner) busySpinner.remove();
    }
    if (removeBtn) {
      removeBtn.disabled = false;
      removeBtn.classList.remove('btn-loading');
    }
    showToast(t('Failed to remove: {0}', err.message), 'error');
  }
}


// ═══════════════════════════════════════════════════════════════
// SITE PREVIEW
// ═══════════════════════════════════════════════════════════════

function initPreviewFallback(domain) {
  var domKey = domain.replace(/\./g, '_');
  var frame = document.getElementById('previewFrame_' + domKey);
  var container = document.getElementById('previewContainer_' + domKey);
  if (!frame || !container) return;

  var loaded = false;
  frame.addEventListener('load', function() { loaded = true; });

  // After 8s, check if the iframe actually rendered content
  setTimeout(function() {
    try {
      var doc = frame.contentDocument || frame.contentWindow.document;
      if (doc && doc.body && doc.body.innerHTML.length > 50) return;
    } catch(e) {
      // Cross-origin = site loaded but we can't inspect — preview is fine
      if (loaded) return;
    }
    // Iframe failed — show fallback placeholder
    container.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--space-8) var(--space-6);text-align:center;min-height:200px;">'
      + '<div style="width:64px;height:64px;border-radius:var(--radius-full);background:var(--bg-muted);display:flex;align-items:center;justify-content:center;margin-bottom:var(--space-4);">'
      + '<i class="ri-image-line" aria-hidden="true" style="font-size:1.75rem;color:var(--text-tertiary);"></i></div>'
      + '<div style="font-size:var(--text-sm);font-weight:var(--weight-medium);color:var(--text-secondary);margin-bottom:var(--space-2);">' + t('Preview unavailable') + '</div>'
      + '<div style="font-size:var(--text-xs);color:var(--text-tertiary);max-width:320px;line-height:1.5;">'
      + t('The site may block iframe embedding, DNS may not be pointed yet, or the site isn\'t publicly accessible.')
      + '</div>'
      + '<a href="https://' + escapeHtml(domain) + '" target="_blank" class="btn btn-secondary btn-sm" style="margin-top:var(--space-4);"><i class="ri-external-link-line" aria-hidden="true"></i> ' + t('Visit Site Directly') + '</a>'
      + '</div>';
  }, 8000);
}

// ═══════════════════════════════════════════════════════════════
// SITEJET BUILDER & PUBLISH MODAL
// ═══════════════════════════════════════════════════════════════

async function launchSitejetBuilder(domain) {
  const sjState = getSitejetState(domain);
  const hasSite = sjState === 'published' || sjState === 'editing';

  if (CpanelAPI.isInsideCpanel()) {
    if (hasSite) {
      try {
        const ssoUrl = await CpanelAPI.sitejetGetSsoLink(domain);
        if (ssoUrl) { window.open(ssoUrl, '_blank'); return; }
      } catch {}
    }
    window.open(DomainsAPI.getSitejetUrl(domain, hasSite), '_blank');
  } else {
    const messages = {
      published: t('Sitejet Builder would open the editor for {0}', domain),
      editing: t('Sitejet Builder would open to continue editing {0}', domain),
      available: t('Sitejet Builder would open "Try Sitejet AI" for {0}', domain)
    };
    showToast(messages[sjState] || messages.available, 'info');
  }
}

// ── Publish Modal ──

function sjShowModal() {
  document.getElementById('sjOverlay').classList.add('show');
}

function sjHideModal() {
  document.getElementById('sjOverlay').classList.remove('show');
}

function sjRender(state, opts) {
  opts = opts || {};
  var modal = document.getElementById('sjModal');
  var iconMap = {
    publishing: '<div class="sj-icon sj-icon-progress"><i class="ri-upload-cloud-2-line" aria-hidden="true"></i></div>',
    success:    '<div class="sj-icon sj-icon-success"><i class="ri-check-line" aria-hidden="true"></i></div>',
    error:      '<div class="sj-icon sj-icon-error"><i class="ri-error-warning-line" aria-hidden="true"></i></div>'
  };
  var html = iconMap[state] || '';
  if (opts.domain) {
    html += '<div class="sj-domain"><i class="ri-global-line" aria-hidden="true"></i> ' + esc(opts.domain) + '</div>';
  }
  html += '<div class="sj-title">' + esc(opts.title || '') + '</div>';
  html += '<div class="sj-desc">' + (opts.desc || '') + '</div>';
  if (state === 'publishing') {
    var pct = opts.percent || 0;
    html += '<div class="sj-progress-track"><div class="sj-progress-fill ' + (pct > 0 ? '' : 'indeterminate') + '" id="sjFill" style="width:' + pct + '%;"></div></div>';
    html += '<div class="sj-status" id="sjStatus">' + esc(opts.status || t('Starting…')) + '</div>';
  }
  if (opts.actions) {
    html += '<div class="sj-actions">' + opts.actions + '</div>';
  }
  modal.innerHTML = html;
}

function sjUpdateProgress(pct, status) {
  var fill = document.getElementById('sjFill');
  var statusEl = document.getElementById('sjStatus');
  if (fill) { fill.classList.remove('indeterminate'); fill.style.width = Math.min(pct, 100) + '%'; }
  if (statusEl && status) statusEl.textContent = status;
}

async function sjStartPublish(domain) {
  sjShowModal();
  sjRender('publishing', {
    domain: domain,
    title: t('Publishing Your Website'),
    desc: t('Downloading your site from Sitejet and deploying it to the server.'),
    status: t('Initiating…'),
    percent: 0
  });

  try {
    var startResult = await CpanelAPI.call('Sitejet', 'start_publish', { domain: domain });
    var startData = startResult.data || startResult;
    var pid = startData.pid;
    var logFile = startData.file_name;
    if (!pid || !logFile) throw new Error(t('start_publish did not return pid/file_name'));

    sjUpdateProgress(5, t('Downloading site files…'));

    // Poll every 3s
    var maxAttempts = 200;
    for (var attempt = 0; attempt < maxAttempts; attempt++) {
      await new Promise(function(r) { setTimeout(r, 3000); });
      var result = await CpanelAPI.call('Sitejet', 'poll_publish', { pid: pid, file_name: logFile });
      var data = result.data || result;
      var pct = Number(data.progress) || 0;
      var isRunning = !!data.is_running;
      var failed = !!data.failed;
      sjUpdateProgress(pct, pct > 0 ? t('Deploying files… {0}%', pct) : t('Downloading…'));

      if (!isRunning) {
        if (failed) {
          var logLines = data.log || [];
          throw new Error(logLines.filter(function(l) { return /error|fail/i.test(l); }).pop() || t('Publish failed'));
        }
        sjUpdateProgress(100, t('Complete!'));
        await new Promise(function(r) { setTimeout(r, 600); });

        // Update domain state optimistically
        var d = domains.find(function(x) { return x.domain === domain; });
        if (d) {
          if (!d.features) d.features = [];
          if (!d.features.includes('sitejet')) d.features.push('sitejet');
          sitejetInfo[domain] = sitejetInfo[domain] || {};
          sitejetInfo[domain].is_sitejet = true;
          sitejetInfo[domain].has_sitejet_website = true;
          sitejetInfo[domain].has_sitejet_published = true;
        }

        sjRender('success', {
          domain: domain,
          title: t('Published Successfully'),
          desc: t('Your website is now live and serving visitors.'),
          actions: '<a href="https://' + esc(domain) + '" target="_blank" class="btn btn-secondary btn-sm"><i class="ri-external-link-line" aria-hidden="true"></i> ' + t('Visit Site') + '</a>'
                + '<button class="btn btn-primary btn-sm" onclick="sjFinishPublish(\'' + esc(domain) + '\')"><i class="ri-arrow-left-line" aria-hidden="true"></i> ' + t('Back to {0}', esc(domain)) + '</button>'
        });
        return;
      }
    }
    throw new Error(t('Publish timed out'));
  } catch (err) {
    sjRender('error', {
      domain: domain,
      title: t('Publish Failed'),
      desc: esc(err.message),
      actions: '<button class="btn btn-secondary btn-sm" onclick="sjStartPublish(\'' + esc(domain) + '\')"><i class="ri-refresh-line" aria-hidden="true"></i> ' + t('Retry') + '</button>'
            + '<button class="btn btn-ghost btn-sm" onclick="sjFinishPublish(\'' + esc(domain) + '\')">' + t('Close') + '</button>'
    });
  }
}

function sjFinishPublish(domain) {
  sjHideModal();
  renderDomains();
  // Navigate directly to the domain's overview tab
  setTimeout(function() { navigateToDomain(domain, 'overview'); }, 200);
}


