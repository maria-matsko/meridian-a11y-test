    e.target.value === 'alias' ? 'none' : '';
});


// ═══════════════════════════════════════════════════════════════
// CONFIRM DIALOG
// ═══════════════════════════════════════════════════════════════

// confirmDangerAction() — adapts page-level opts to shared window.confirmAction from shell.js
// Adapts page-level {variant, confirmText} interface to shared {danger, confirmLabel} interface.
function confirmDangerAction(opts) {
  return window.confirmAction({
    title: opts.title,
    message: opts.message,
    danger: (opts.variant || 'danger') === 'danger',
    confirmLabel: opts.confirmText || t('Confirm')
  });
}


// ═══════════════════════════════════════════════════════════════
// UTILITIES
// ═══════════════════════════════════════════════════════════════

// escapeHtml() provided globally by shell.js


// ═══════════════════════════════════════════════════════════════
// MODERN VIEW — Data List + Hierarchy + Tab Overview
// ═══════════════════════════════════════════════════════════════

/* ═══════ Modern View: Live Data Adapter ═══════ */

var modernSitesCache = null;

function modernGetSites() {
  if (!modernSitesCache) modernSitesCache = modernBuildSites();
  return modernSitesCache;
}

function modernBuildSites() {
  var parents = [];
  var childMap = {};

  for (var i = 0; i < domains.length; i++) {
    var d = domains[i];
    var site = modernAdaptDomain(d);
    if (d.type === 'main' || d.type === 'addon') {
      parents.push(site);
    } else {
      var parentDomain = modernFindParent(d.domain);
      if (!childMap[parentDomain]) childMap[parentDomain] = [];
      childMap[parentDomain].push(site);
    }
  }

  for (var j = 0; j < parents.length; j++) {
    parents[j].children = childMap[parents[j].domain] || [];
  }

  return parents;
}

function modernFindParent(childDomain) {
  for (var i = 0; i < domains.length; i++) {
    var d = domains[i];
    if ((d.type === 'main' || d.type === 'addon') && childDomain !== d.domain && childDomain.endsWith('.' + d.domain)) {
      return d.domain;
    }
  }
  for (var i = 0; i < domains.length; i++) {
    if (domains[i].type === 'main') return domains[i].domain;
  }
  return '';
}

function modernAdaptDomain(d) {
  var sslStatus = d.ssl ? d.ssl.status : 'none';
  var sslActive = sslStatus === 'valid' || sslStatus === 'expiring';
  var sslDaysLeft = null;
  if (d.ssl && d.ssl.expires) {
    var expDate = new Date(d.ssl.expires);
    sslDaysLeft = Math.floor((expDate - new Date()) / 86400000);
  }

  var appType = 'none';
  if (d.features && d.features.indexOf('wordpress') !== -1) appType = 'wordpress';
  else if (d.features && d.features.indexOf('sitejet') !== -1) appType = 'sitejet';

  var features = (d.features || []).slice();
  if (sslActive && features.indexOf('autossl') === -1) features.push('autossl');

  return {
    domain: d.domain,
    domainType: d.type,
    appType: appType,
    wpVersion: d.wpVersion || '',
    status: 'online',
    docroot: d.docroot || '',
    features: features,
    ssl: {
      active: sslActive,
      type: d.ssl && d.ssl.issuer ? 'Custom' : 'AutoSSL',
      issuer: (d.ssl && d.ssl.issuer) || '',
      expiry: (d.ssl && d.ssl.expires) || '',
      daysLeft: sslDaysLeft,
      selfSigned: !!(d.ssl && d.ssl.selfSigned),
      validationType: (d.ssl && d.ssl.validationType) || ''
    },
    autosslProblem: d.autosslProblem || '',
    phpVersion: d.phpVersion || '',
    phpOutdated: !!d.phpOutdated,
    httpsRedirect: !!d.httpsRedirect,
    email: { count: d.emailCount || 0, accounts: [] },
    files: { used: '' },
    database: { count: 0, engine: null, size: null, name: null, users: 0 },
    dns: { records: 0 },
    security: { waf: false, threats: 0, hotlink: false, dirPrivacy: false },
    backup: { lastManual: null, autoEnabled: false },
    overview: { alerts: [], stats: [], quickActions: [] },
    tabs: [
      { id: 'overview', label: 'Overview', icon: 'ri-dashboard-line', dot: null },
      { id: 'email', label: 'Email', icon: 'ri-mail-line', dot: null, count: d.emailCount || 0 },
      { id: 'ssl', label: 'SSL', icon: 'ri-lock-line', dot: sslStatus === 'expired' ? 'error' : sslStatus === 'expiring' ? 'warn' : null },
      { id: 'dns', label: 'DNS', icon: 'ri-earth-line', dot: null },
      { id: 'files', label: 'Files', icon: 'ri-folder-3-line', dot: null },
      { id: 'security', label: 'Security', icon: 'ri-shield-check-line', dot: null }
    ],
    dnsRecords: [],
    filesList: [],
    children: []
  };
}

/* ═══════ Modern View State ═══════ */
var modernCurrentSite = null;
var modernCurrentTab = 'overview';
var modernExpandedGroups = {};
var modernAllExpanded = false;
var modernUserToggled = false;

function modernToggleAllGroups() {
  modernUserToggled = true;
  modernAllExpanded = !modernAllExpanded;
  var sites = modernGetSites();
  for (var i = 0; i < sites.length; i++) {
    if (sites[i].children && sites[i].children.length > 0) {
      modernExpandedGroups[sites[i].domain] = modernAllExpanded;
    }
  }
  var btn = document.getElementById('toggleAllGroups');
  if (btn) {
    var span = btn.querySelector('span');
    var icon = btn.querySelector('i');
    if (span) span.textContent = modernAllExpanded ? 'Minimize All' : 'Expand All';
    if (icon) icon.className = modernAllExpanded ? 'ri-contract-up-down-line' : 'ri-expand-up-down-line';
  }
  var s = document.getElementById('modernSearch');
  modernRenderList(s ? s.value : '');
}

/* ── Modern View Sorting ── */
var modernSortField = 'domain';
var modernSortDir = 'asc';

function modernToggleSort(field) {
  if (modernSortField === field) {
    modernSortDir = modernSortDir === 'asc' ? 'desc' : 'asc';
  } else {
    modernSortField = field;
    modernSortDir = 'asc';
  }
  modernRenderList(document.getElementById('modernSearch') ? document.getElementById('modernSearch').value : '');
}

function modernSortIcon(field) {
  if (modernSortField !== field) return '<i class="ri-arrow-up-down-line sort-icon" aria-hidden="true"></i>';
  var icon = modernSortDir === 'asc' ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line';
  return '<i class="' + icon + ' sort-icon active" aria-hidden="true"></i>';
}

function modernSortSites(sites) {
  return sites.slice().sort(function(a, b) {
    // Main domain always first
    if (a.domainType === 'main' && b.domainType !== 'main') return -1;
    if (b.domainType === 'main' && a.domainType !== 'main') return 1;

    var va, vb;
    if (modernSortField === 'domain') { va = a.domain; vb = b.domain; }
    else if (modernSortField === 'ssl') {
      va = a.ssl.daysLeft !== null ? a.ssl.daysLeft : -9999;
      vb = b.ssl.daysLeft !== null ? b.ssl.daysLeft : -9999;
    }
    else if (modernSortField === 'status') {
      va = modernGetAlerts(a).length; vb = modernGetAlerts(b).length;
    }
    else { va = a.domain; vb = b.domain; }
    if (typeof va === 'string') { va = va.toLowerCase(); vb = vb.toLowerCase(); }
    if (va < vb) return modernSortDir === 'asc' ? -1 : 1;
    if (va > vb) return modernSortDir === 'asc' ? 1 : -1;
    return 0;
  });
}

/* ── Modern View Helpers ── */

function modernGetSiteByDomain(domain) {
  var sites = modernGetSites();
  for (var i = 0; i < sites.length; i++) {
    if (sites[i].domain === domain) return sites[i];
    var children = sites[i].children || [];
    for (var j = 0; j < children.length; j++) {
      if (children[j].domain === domain) return children[j];
    }
  }
  return null;
}

function modernGetAllDomains() {
  var all = [];
  var sites = modernGetSites();
  for (var i = 0; i < sites.length; i++) {
    all.push(sites[i]);
    var children = sites[i].children || [];
    for (var j = 0; j < children.length; j++) {
      all.push(children[j]);
    }
  }
  return all;
}

function modernGetDomainTypeLabel(dt) {
  var labels = { main: 'Main Domain', addon: 'Addon Domain', subdomain: 'Subdomain', alias: 'Alias' };
  return labels[dt] || dt;
}

function modernGetDomainIcon(dt) {
  var icons = { main: 'ri-global-line', addon: 'ri-add-circle-line', subdomain: 'ri-git-branch-line', alias: 'ri-links-line' };
  return icons[dt] || 'ri-earth-line';
}

function modernGetAppTypeLabel(appType) {
  var labels = { wordpress: 'WordPress', sitejet: 'Sitejet', static: 'Static', custom: 'Custom Code', none: 'No Content' };
  return labels[appType] || appType;
}

function modernGetAlerts(site) {
  var alerts = [];

  // SSL: expired (critical)
  if (site.ssl.daysLeft !== null && site.ssl.daysLeft <= 0)
    alerts.push({ text: t('SSL expired'), desc: t('Visitors see a security warning. Renew immediately.'), cls: 'status-error', severity: 'error', icon: 'ri-lock-unlock-line', tab: 'ssl' });

  // SSL: expiring within 30 days (warning — matches Jupiter's threshold)
  else if (site.ssl.daysLeft !== null && site.ssl.daysLeft > 0 && site.ssl.daysLeft <= 30)
    alerts.push({ text: t('SSL expires in {0}d', site.ssl.daysLeft), desc: t('Certificate will expire soon. AutoSSL should renew it automatically.'), cls: 'status-warn', severity: 'warn', icon: 'ri-lock-line', tab: 'ssl' });

  // SSL: self-signed certificate (warning)
  if (site.ssl.selfSigned)
    alerts.push({ text: t('Self-signed SSL'), desc: t('Browsers will show a warning. Use a trusted certificate instead.'), cls: 'status-warn', severity: 'warn', icon: 'ri-error-warning-line', tab: 'ssl' });

  // SSL: no certificate at all (warning)
  if (!site.ssl.active && site.ssl.daysLeft === null)
    alerts.push({ text: t('No SSL'), desc: t('No certificate installed. Run AutoSSL or install one manually.'), cls: 'status-warn', severity: 'warn', icon: 'ri-lock-unlock-line', tab: 'ssl' });

  // AutoSSL problem (warning)
  if (site.autosslProblem)
    alerts.push({ text: t('AutoSSL issue'), desc: escapeHtml(site.autosslProblem), cls: 'status-warn', severity: 'warn', icon: 'ri-refresh-line', tab: 'ssl' });

  // PHP outdated (warning)
  if (site.phpOutdated && site.phpVersion)
    alerts.push({ text: t('PHP {0} outdated', site.phpVersion), desc: t('This version is no longer supported. Update to a newer version.'), cls: 'status-warn', severity: 'warn', icon: 'ri-code-s-slash-line', tab: 'settings' });

  // No HTTPS redirect when SSL is active (info)
  if (site.ssl.active && !site.httpsRedirect)
    alerts.push({ text: t('HTTPS redirect off'), desc: t('HTTP traffic is not redirected to HTTPS.'), cls: 'status-muted', severity: 'muted', icon: 'ri-arrow-right-line', tab: 'settings' });

  return alerts;
}

// Alert data stored in JS — no serialization into HTML attributes
var _alertsByDomain = {};

function modernRenderSummaryCell(site) {
  var alerts = modernGetAlerts(site);
  if (alerts.length === 0) return '<span class="status-ok" title="' + esc(t('No issues detected')) + '"><i class="ri-checkbox-circle-line" aria-hidden="true"></i> ' + t('Healthy') + '</span>';

  // Store alert data in JS, keyed by domain
  _alertsByDomain[site.domain] = alerts.map(function(al) {
    return { text: al.text, icon: al.icon, severity: al.severity };
  });

  var a = alerts[0];
  var html = '<div class="status-cell">';
  html += '<span class="' + a.cls + '">';
  if (a.icon) html += '<i class="' + a.icon + '" aria-hidden="true" style="margin-right:2px;"></i> ';
  html += esc(a.text) + '</span>';
  if (alerts.length > 1) {
    html += '<span class="alert-more">+' + (alerts.length - 1) + '</span>';
  }
  html += '</div>';
  return html;
}

function modernGetSSLBadge(site) {
  var ssl = site.ssl;
  if (!ssl.active) return '<div class="ssl-badge"><span class="ssl-dot none"></span> None</div>';
  if (ssl.daysLeft <= 0) return '<div class="ssl-badge"><span class="ssl-dot expired"></span> Expired</div>';
  if (ssl.daysLeft <= 30) return '<div class="ssl-badge"><span class="ssl-dot expiring"></span> ' + esc(String(ssl.daysLeft)) + 'd</div>';
  return '<div class="ssl-badge"><span class="ssl-dot valid"></span> Valid</div>';
}

function modernRenderFeatureTags(features) {
  if (!features || features.length === 0) return '';
  var html = '<div class="feature-tags">';
  for (var i = 0; i < features.length; i++) {
    var f = features[i];
    if (f === 'wordpress') {
      html += '<span class="feature-tag feature-tag-wp"><i class="ri-wordpress-line" aria-hidden="true"></i> WP</span>';
    } else if (f === 'sitejet') {
      html += '<span class="feature-tag feature-tag-sitejet"><i class="ri-palette-line" aria-hidden="true"></i> Sitejet</span>';
    } else if (f === 'git') {
      html += '<span class="feature-tag feature-tag-git"><i class="ri-git-branch-line" aria-hidden="true"></i> Git</span>';
    } else if (f === 'autossl') {
      html += '<span class="feature-tag feature-tag-autossl"><i class="ri-lock-line" aria-hidden="true"></i> SSL</span>';
    }
  }
  html += '</div>';
  return html;
}

function modernGetCTA(site) {
  if (site.appType === 'wordpress') return { label: t('Manage WordPress'), icon: 'ri-wordpress-line' };
  if (site.appType === 'sitejet') return { label: t('Open Sitejet'), icon: 'ri-palette-line' };
  if (site.appType === 'static' || site.appType === 'custom') return { label: t('Manage Files'), icon: 'ri-folder-open-line' };
  // appType is 'none' or null/undefined — no app installed
  return { label: t('Add Website'), icon: 'ri-add-circle-line' };
}


/* ═══════ Modern View: Render Website List ═══════ */

function modernRenderList(filter) {
  var list = document.getElementById('websiteList');
  var allDomains = modernGetAllDomains();
  var totalCount = allDomains.length;

  // Filter
  var sites = modernGetSites();
  var filteredParents = sites;
  if (filter) {
    var q = filter.toLowerCase();
    filteredParents = [];
    for (var i = 0; i < sites.length; i++) {
      var p = sites[i];
      var parentMatch = p.domain.toLowerCase().indexOf(q) !== -1;
      var childMatches = [];
      var children = p.children || [];
      for (var j = 0; j < children.length; j++) {
        if (children[j].domain.toLowerCase().indexOf(q) !== -1) childMatches.push(children[j]);
      }
      if (parentMatch || childMatches.length > 0) {
        var clone = Object.assign({}, p);
        clone.children = parentMatch ? (p.children || []) : childMatches;
        filteredParents.push(clone);
        if (childMatches.length > 0 && !parentMatch) modernExpandedGroups[p.domain] = true;
      }
    }
  }

  // Sort
  filteredParents = modernSortSites(filteredParents);

  // Count all shown
  var shownCount = 0;
  for (var i = 0; i < filteredParents.length; i++) {
    shownCount += 1 + (filteredParents[i].children || []).length;
  }

  var html = '<div class="data-list-head" role="row">'
    + '<div class="sortable" onclick="modernToggleSort(\'domain\')" role="columnheader" tabindex="0">Website ' + modernSortIcon('domain') + '</div>'
    + '<div role="columnheader">Features</div>'
    + '<div class="sortable" onclick="modernToggleSort(\'ssl\')" role="columnheader" tabindex="0">SSL ' + modernSortIcon('ssl') + '</div>'
    + '<div class="sortable" onclick="modernToggleSort(\'status\')" role="columnheader" tabindex="0">Status ' + modernSortIcon('status') + '</div>'
    + '<div role="columnheader"></div>'
    + '</div>';

  // Count total domains to pick display mode
  var totalDomains = 0;
  for (var i = 0; i < filteredParents.length; i++) {
    totalDomains += 1 + (filteredParents[i].children || []).length;
  }
  var useTreeMode = !modernUserToggled && totalDomains <= 10;

  for (var i = 0; i < filteredParents.length; i++) {
    var s = filteredParents[i];
    var children = s.children || [];
    var hasChildren = children.length > 0;

    html += modernRenderDomainRow(s, hasChildren, useTreeMode, false);

    if (hasChildren) {
      if (useTreeMode) {
        html += '<div class="tree-children" role="rowgroup">';
        for (var j = 0; j < children.length; j++) {
          html += modernRenderDomainRow(children[j], false, true, true);
        }
        html += '</div>';
      } else {
        var isExpanded = !!modernExpandedGroups[s.domain];
        html += '<div class="group-children' + (isExpanded ? ' open' : '') + '" data-parent="' + esc(s.domain) + '" role="rowgroup">';
        for (var j = 0; j < children.length; j++) {
          html += modernRenderDomainRow(children[j], false, false, true);
        }
        html += '</div>';
      }
    }
  }

  list.innerHTML = html;
  modernBindListEvents(list);
}

function modernRenderDomainRow(site, hasChildren, isTreeMode, isChild) {
  var dt = site.domainType;
  var children = site.children || [];

  var rowClass = 'data-list-row';
  if (isChild && isTreeMode) rowClass += ' tree-row';
  else if (isChild) rowClass += ' child-row';
  var html = '<div class="' + rowClass + '" data-domain="' + esc(site.domain) + '" tabindex="0" role="row">';

  // Cell 1: Website
  html += '<div class="cell-name" role="cell">';
  html += '<span class="domain-icon icon-' + esc(dt) + '"><i class="' + esc(modernGetDomainIcon(dt)) + '" aria-hidden="true"></i></span>';
  html += '<span style="display:flex;flex-direction:column;min-width:0;">';
  html += '<span class="domain-name-text">' + esc(site.domain) + '</span>';
  html += '<span class="domain-type-label">' + esc(modernGetDomainTypeLabel(dt));
  if (hasChildren && children.length > 0 && !isTreeMode) {
    html += ' <span class="badge-toggle" data-toggle="' + esc(site.domain) + '">' + children.length + ' <i class="ri-arrow-down-s-line" aria-hidden="true"></i></span>';
  }
  html += '</span></span>';
  html += '</div>';

  // Cell 2: Features
  html += '<div class="cell" role="cell">' + modernRenderFeatureTags(site.features) + '</div>';

  // Cell 3: SSL
  html += '<div class="cell" role="cell">' + modernGetSSLBadge(site) + '</div>';

  // Cell 4: Status
  html += '<div class="cell" role="cell">' + modernRenderSummaryCell(site) + '</div>';

  // Cell 5: Chevron
  html += '<div class="cell-action" role="cell"><i class="ri-arrow-right-s-line" aria-hidden="true"></i></div>';

  html += '</div>';
  return html;
}

/* ── Status tooltip — stores data in JS, uses event delegation ── */
var StatusTooltip = (function() {
  var el = null;
  var timer = null;

  function ensure() {
    if (el) return;
    el = document.createElement('div');
    el.className = 'status-tooltip-popup';
    document.body.appendChild(el);
    el.addEventListener('mouseenter', function() { clearTimeout(timer); });
    el.addEventListener('mouseleave', function() { hide(); });
  }

  function show(cell) {
    var row = cell.closest('[data-domain]');
    if (!row) return;
    var alerts = _alertsByDomain[row.dataset.domain];
    if (!alerts || !alerts.length) return;

    clearTimeout(timer);
    ensure();

    el.innerHTML = alerts.map(function(al) {
      return '<div class="status-tooltip-item">'
        + '<div class="status-tooltip-icon ' + (al.severity || 'warn') + '"><i class="' + al.icon + '" aria-hidden="true"></i></div>'
        + '<div class="status-tooltip-text">' + escapeHtml(al.text) + '</div>'
        + '</div>';
    }).join('');

    el.style.display = 'block';

    var rect = cell.getBoundingClientRect();
    var tipH = el.offsetHeight;
    var tipW = el.offsetWidth;
    var left = rect.right - tipW;
    if (left < 8) left = 8;
    var top = rect.bottom + 6;
    if (top + tipH > window.innerHeight - 8) {
      top = rect.top - tipH - 6;
    }
    el.style.left = left + 'px';
    el.style.top = top + 'px';
  }

  function hide() {
    clearTimeout(timer);
    timer = setTimeout(function() { if (el) el.style.display = 'none'; }, 120);
  }

  return { show: show, hide: hide };
})();

function modernBindListEvents(list) {
  var rows = list.querySelectorAll('.data-list-row');
  for (var j = 0; j < rows.length; j++) {
    rows[j].addEventListener('click', function(e) {
      if (e.target.closest('.status-cell')) return; // let tooltip hover work without navigating
      var toggle = e.target.closest('.badge-toggle');
      if (toggle) {
        e.stopPropagation();
        var parentDomain = toggle.getAttribute('data-toggle');
        modernExpandedGroups[parentDomain] = !modernExpandedGroups[parentDomain];
        toggle.classList.toggle('open');
        var container = list.querySelector('.group-children[data-parent="' + parentDomain + '"]');
        if (container) container.classList.toggle('open');
        return;
      }
      openSettings(this.getAttribute('data-domain'));
    });
    rows[j].addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.click(); }
    });
  }

  // Tooltip hover — delegated to status cells
  var cells = list.querySelectorAll('.status-cell');
  for (var k = 0; k < cells.length; k++) {
    cells[k].addEventListener('mouseenter', function() { StatusTooltip.show(this); });
    cells[k].addEventListener('mouseleave', function() { StatusTooltip.hide(); });
  }
}


// ── Search wiring ──
var modernSearchEl = document.getElementById('modernSearch');
if (modernSearchEl) {
  modernSearchEl.addEventListener('input', function() {
    modernRenderList(this.value);
  });
}

// ── Boot ──
modernRenderList('');

// Set initial toggle label — if tree mode (≤10), items start expanded
(function() {
  var allDomains = modernGetAllDomains();
  if (allDomains.length <= 10) {
    modernAllExpanded = true;
    // Pre-populate expanded state so first toggle click works correctly
    var sites = modernGetSites();
    for (var i = 0; i < sites.length; i++) {
      if (sites[i].children && sites[i].children.length > 0) {
        modernExpandedGroups[sites[i].domain] = true;
      }
    }
    var btn = document.getElementById('toggleAllGroups');
    if (btn) {
      var span = btn.querySelector('span');
      var icon = btn.querySelector('i');
      if (span) span.textContent = 'Minimize All';
      if (icon) icon.className = 'ri-contract-up-down-line';
    }
  }
})();

init();
</script>
[% END %]
