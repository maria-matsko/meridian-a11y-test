[% WRAPPER '_assets/master.html.tt'
    page_title = 'Sitejet Builder'
    page_id    = 'websites'
    asset_path = '../_assets'
%]
<style>
/* ═══════════════════════════════════════════════════════════════
   SITEJET PUBLISH — PAGE-SPECIFIC STYLES
   ═══════════════════════════════════════════════════════════════ */

.sj-container {
  max-width: 520px;
  margin: 10vh auto;
  padding: var(--space-6);
  text-align: center;
}

.sj-icon {
  width: 72px; height: 72px;
  border-radius: var(--radius-full);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto var(--space-5);
  font-size: var(--text-2xl);
}
.sj-icon-progress { background: var(--feature-bg); color: var(--feature-color); }
.sj-icon-success  { background: var(--status-success-bg); color: var(--status-success); }
.sj-icon-error    { background: var(--status-error-bg); color: var(--status-error); }

.sj-title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-tight);
  margin-bottom: var(--space-2);
}

.sj-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-6);
}

.sj-progress-track {
  width: 100%;
  height: 6px;
  background: var(--bg-muted);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: var(--space-3);
}

.sj-progress-fill {
  height: 100%;
  background: var(--feature-color);
  border-radius: var(--radius-full);
  transition: width var(--duration-slow) var(--ease-out);
  width: 0%;
}

.sj-progress-fill.indeterminate {
  width: 30%;
  animation: sjIndeterminate 1.5s var(--ease-out) infinite;
}

@keyframes sjIndeterminate {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(400%); }
}

.sj-status {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
  margin-bottom: var(--space-6);
}

.sj-actions {
  display: flex;
  gap: var(--space-3);
  justify-content: center;
}

.sj-domain {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--bg-muted);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  font-family: var(--font-mono);
  color: var(--text-primary);
  margin-bottom: var(--space-5);
}
</style>

<div class="sj-container" id="sjContainer">
  <!-- Content injected by JS based on state -->
</div>

<script>
// ═══════════════════════════════════════════════════════════════
// SITEJET PUBLISH HANDLER
// ═══════════════════════════════════════════════════════════════
//
// This page handles the post-publish redirect from Sitejet's CMS.
//
// Flow:
//   1. User edits site in Sitejet's external CMS (cms.sitehub.io)
//   2. User clicks "Publish" in the CMS
//   3. Sitejet redirects back to this page (the referrer URL)
//   4. This page calls Sitejet::start_publish to begin downloading
//      the built website files from Sitejet's API to the document root
//   5. Polls Sitejet::poll_publish for progress
//   6. On completion, redirects to the Meridian websites page with success
//
// URL params:
//   ?site_id=domain.com     — domain being published (from Sitejet redirect)
//   ?action=publish         — explicit publish action
//   ?action=edit&domain=x   — launch SSO editor for domain

// shell.js loads after this script — define esc locally if not yet available
if (typeof esc !== 'function') {
  window.esc = function(s) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(s));
    return d.innerHTML;
  };
}

const container = document.getElementById('sjContainer');
const params = new URLSearchParams(window.location.search);
// Read site_id from URL params, with TT-injected fallback
const siteId = params.get('site_id') || params.get('domain') || '[% FORM.item("site_id") | uri %]' || '';
const action = params.get('action') || (siteId ? 'publish' : 'none');

function websitesUrl(queryStr) {
  const token = CpanelAPI.getToken();
  const base = token
    ? '/' + token + '/frontend/meridian/websites/'
    : '/frontend/meridian/websites/';
  return base + (queryStr || '');
}

function render(state, opts) {
  opts = opts || {};
  const iconMap = {
    publishing: '<div class="sj-icon sj-icon-progress"><i class="ri-upload-cloud-2-line" aria-hidden="true"></i></div>',
    success:    '<div class="sj-icon sj-icon-success"><i class="ri-check-line" aria-hidden="true"></i></div>',
    error:      '<div class="sj-icon sj-icon-error"><i class="ri-error-warning-line" aria-hidden="true"></i></div>',
    idle:       '<div class="sj-icon sj-icon-progress"><i class="ri-layout-masonry-line" aria-hidden="true"></i></div>'
  };

  var html = iconMap[state] || iconMap.idle;

  if (siteId) {
    html += '<div class="sj-domain"><i class="ri-global-line" aria-hidden="true"></i> ' + esc(siteId) + '</div>';
  }

  html += '<div class="sj-title">' + esc(opts.title || 'Sitejet Builder') + '</div>';
  html += '<div class="sj-desc">' + (opts.desc || '') + '</div>';

  if (state === 'publishing') {
    var pct = opts.percent || 0;
    var fillClass = pct > 0 ? '' : 'indeterminate';
    html += '<div class="sj-progress-track"><div class="sj-progress-fill ' + fillClass + '" id="sjProgressFill" style="width:' + pct + '%;"></div></div>';
    html += '<div class="sj-status" id="sjStatus">' + esc(opts.status || t('Starting publish…')) + '</div>';
  }

  if (opts.actions) {
    html += '<div class="sj-actions">' + opts.actions + '</div>';
  }

  container.innerHTML = html;
}

// ── Publish Flow ──

async function startPublish() {
  if (!siteId) {
    render('error', {
      title: t('Missing Domain'),
      desc: t('No domain was specified for publishing.'),
      actions: '<a href="' + websitesUrl() + '" class="btn btn-primary btn-sm"><i class="ri-arrow-left-line" aria-hidden="true"></i> ' + t('Back to Websites') + '</a>'
    });
    return;
  }

  render('publishing', {
    title: t('Publishing Your Website'),
    desc: t('Downloading your site from Sitejet and deploying it to <strong>{0}</strong>. This may take a moment.', esc(siteId)),
    status: t('Initiating publish…'),
    percent: 0
  });

  try {
    // Step 1: Start publish — forks a background daemon that downloads
    // the site from Sitejet's API into the document root.
    // Returns { pid, file_name } where file_name is the publish log path.
    var startResult = await CpanelAPI.call('Sitejet', 'start_publish', { domain: siteId });
    var startData = startResult.data || startResult;
    var pid = startData.pid;
    var logFile = startData.file_name;

    if (!pid || !logFile) {
      throw new Error('start_publish did not return pid/file_name');
    }

    updateProgress(5, t('Downloading site files…'));

    // Step 2: Poll every 3s until the daemon finishes
    await pollPublish(pid, logFile);

    // Step 3: Success
    render('success', {
      title: t('Published Successfully'),
      desc: t('Your website has been deployed to <strong>{0}</strong> and is now live.', esc(siteId)),
      actions: '<a href="https://' + esc(siteId) + '" target="_blank" class="btn btn-secondary btn-sm"><i class="ri-external-link-line" aria-hidden="true"></i> ' + t('Visit Site') + '</a>'
            + '<a href="' + websitesUrl('?published=' + encodeURIComponent(siteId)) + '" class="btn btn-primary btn-sm"><i class="ri-arrow-left-line" aria-hidden="true"></i> ' + t('Back to Websites') + '</a>'
    });
  } catch (err) {
    render('error', {
      title: t('Publish Failed'),
      desc: t('Something went wrong while publishing to <strong>{0}</strong>.', esc(siteId)) + '<br><span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--text-tertiary);">' + esc(err.message) + '</span>',
      actions: '<button class="btn btn-secondary btn-sm" onclick="startPublish()"><i class="ri-refresh-line" aria-hidden="true"></i> ' + t('Retry') + '</button>'
            + '<a href="' + websitesUrl() + '" class="btn btn-ghost btn-sm"><i class="ri-arrow-left-line" aria-hidden="true"></i> ' + t('Back to Websites') + '</a>'
    });
  }
}

function updateProgress(pct, status) {
  var fill = document.getElementById('sjProgressFill');
  var statusEl = document.getElementById('sjStatus');
  if (fill) {
    fill.classList.remove('indeterminate');
    fill.style.width = Math.min(pct, 100) + '%';
  }
  if (statusEl && status) statusEl.textContent = status;
}

async function pollPublish(pid, logFile) {
  var maxAttempts = 200; // ~10 minutes max (200 * 3s)

  for (var attempt = 0; attempt < maxAttempts; attempt++) {
    await new Promise(function(r) { setTimeout(r, 3000); });

    var result = await CpanelAPI.call('Sitejet', 'poll_publish', {
      pid: pid,
      file_name: logFile
    });
    var data = result.data || result;

    // Update progress bar from log file progress (0-100)
    var pct = Number(data.progress) || 0;
    var isRunning = !!data.is_running;
    var failed = !!data.failed;

    // Build status message from log lines
    var logLines = data.log || [];
    var lastLine = logLines.length > 0 ? logLines[logLines.length - 1] : '';
    var statusMsg = pct > 0 ? t('Deploying files… {0}%', pct) : t('Downloading site…');

    updateProgress(pct, statusMsg);

    if (!isRunning) {
      if (failed) {
        // Extract error from log
        var errorMsg = logLines.filter(function(l) { return /error|fail/i.test(l); }).pop() || 'Publish process failed';
        throw new Error(errorMsg);
      }
      // Done successfully
      updateProgress(100, t('Complete!'));
      await new Promise(function(r) { setTimeout(r, 500); });
      return;
    }
  }

  throw new Error(t('Publish timed out — the process may still be running in the background'));
}

// ── Route Actions ──

if (action === 'publish') {
  startPublish();
} else {
  // No action — show a landing state (shouldn't normally happen)
  render('idle', {
    title: t('Sitejet Builder'),
    desc: t('Manage your Sitejet-powered websites.'),
    actions: '<a href="' + websitesUrl() + '" class="btn btn-primary btn-sm"><i class="ri-arrow-left-line" aria-hidden="true"></i> ' + t('Back to Websites') + '</a>'
  });
}
</script>
[% END %]
