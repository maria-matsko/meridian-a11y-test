[% WRAPPER '_assets/master.html.tt'
    page_title = 'Security'
    page_id    = 'security'
%]
<style>
/* ===================================================================
   SECURITY PAGE -- SPECIFIC STYLES
   =================================================================== */

/* Security score card */
.score-row {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: var(--space-6);
  margin-bottom: var(--space-6);
}
.score-card {
  background: var(--bg-surface); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); padding: var(--space-6);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: var(--space-3); text-align: center;
}
.score-ring {
  width: 100px; height: 100px; position: relative;
}
.score-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.score-ring-bg { fill: none; stroke: var(--bg-muted); stroke-width: 8; }
.score-ring-fill { fill: none; stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset 1s var(--ease-out), stroke 0.3s; }
.score-ring-text {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: var(--text-xl); font-weight: var(--weight-bold);
}
.score-label { font-size: var(--text-sm); color: var(--text-tertiary); }

.status-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: var(--space-4);
}
.status-card {
  background: var(--bg-surface); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); padding: var(--space-5);
  display: flex; flex-direction: column; gap: var(--space-2);
}
.status-card-header {
  display: flex; align-items: center; gap: var(--space-3);
}
.status-card-icon {
  width: 32px; height: 32px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center; font-size: var(--text-base); flex-shrink: 0;
}
.status-card-icon.ssl { background: var(--status-success-bg); color: var(--status-success); }
.status-card-icon.waf { background: var(--status-info-bg); color: var(--status-info); }
.status-card-icon.twofa { background: var(--feature-bg); color: var(--feature-color); }
.status-card-icon.password { background: var(--accent-subtle); color: var(--text-brand); }
.status-card-title {
  font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--text-secondary);
}
.status-card-value {
  font-size: var(--text-md); font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-tight);
}

/* Tabs */
/* .detail-tabs-bar is in meridian.css */

/* Sub-tabs (pill switcher) */
.tab-switcher {
  display: flex; gap: 0;
  background: var(--bg-muted);
  border-radius: var(--radius-md);
  padding: 3px;
  margin-bottom: var(--space-4);
  width: fit-content;
}
.tab-switcher-btn {
  padding: var(--space-2) var(--space-3);
  border: none; background: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: var(--text-xs); font-weight: var(--weight-medium);
  color: var(--text-secondary); cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out),
              color var(--duration-fast) var(--ease-out);
}
.tab-switcher-btn:hover { color: var(--text-primary); }
.tab-switcher-btn.active {
  background: var(--bg-surface);
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
}

/* Table */
.sec-table {
  width: 100%; border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-surface);
}
.sec-table-head {
  display: grid;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-5);
  background: var(--bg-muted);
  border-bottom: 1px solid var(--border-subtle);
  font-size: var(--text-xs); font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wide);
  color: var(--text-tertiary); text-transform: uppercase;
}
.sec-row {
  display: grid;
  gap: var(--space-4);
  align-items: center;
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-subtle);
  transition: background var(--duration-fast) var(--ease-out);
}
.sec-row:last-child { border-bottom: none; }
.sec-row:hover { background: var(--bg-hover); }

/* SSL table columns */
.ssl-cols { grid-template-columns: 1fr 120px 100px 80px 80px 70px; }

/* ModSecurity table columns */
.modsec-cols { grid-template-columns: 1fr 100px; }

/* IP Blocker table columns */
.ip-cols { grid-template-columns: 180px 1fr 110px 70px; }

/* SSH Keys table columns */
.ssh-cols { grid-template-columns: 1fr 100px 200px 110px 70px; }

/* API Tokens table columns */
.token-cols { grid-template-columns: 1fr 110px 110px 100px 70px; }

.cell { font-size: var(--text-sm); color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cell-bold { font-weight: var(--weight-semibold); color: var(--text-primary); }

/* Site info cards — in meridian.css */

/* Password strength meter */
.password-strength {
  display: flex; gap: 3px;
  margin-top: var(--space-2);
  height: 4px;
}
.password-strength-segment {
  flex: 1;
  border-radius: var(--radius-full);
  background: var(--bg-muted);
  transition: background var(--duration-fast) var(--ease-out);
}
.password-strength-segment.filled { background: var(--bg-muted); }
.password-strength[data-strength="weak"] .filled { background: var(--status-error); }
.password-strength[data-strength="fair"] .filled { background: var(--status-warning); }
.password-strength[data-strength="good"] .filled { background: var(--status-info); }
.password-strength[data-strength="strong"] .filled { background: var(--status-success); }
.password-strength-label {
  font-size: var(--text-xs); margin-top: var(--space-1);
  color: var(--text-tertiary);
}

/* Settings sections, list items — in meridian.css */

/* Spinner */
.spinner {
  width: 20px; height: 20px;
  border: 2px solid var(--border-default);
  border-top-color: var(--accent);
  border-radius: var(--radius-full);
  animation: spin 0.55s linear infinite;
  flex-shrink: 0;
}

/* Confirm dialog — now in meridian.css */

/* Token reveal box */
.token-reveal {
  background: var(--bg-muted); border: 1px solid var(--border-default);
  border-radius: var(--radius-md); padding: var(--space-4);
  display: flex; align-items: center; gap: var(--space-3);
  margin-top: var(--space-4);
}
.token-reveal code {
  font-family: var(--font-mono); font-size: var(--text-sm);
  flex: 1; word-break: break-all; color: var(--status-success);
}

/* Feature checkbox grid for token creation */
.feature-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: var(--space-2);
  margin-top: var(--space-3);
}


/* ===================================================================
   RESPONSIVE
   =================================================================== */

@media (max-width: 1024px) {
  .score-row { grid-template-columns: 1fr; }
  .ssl-cols { grid-template-columns: 1fr 100px 80px 70px; }
  .ssl-cols > *:nth-child(3) { display: none; }
  .ssl-cols > *:nth-child(5) { display: none; }
}

@media (max-width: 768px) {
  .status-grid { grid-template-columns: 1fr 1fr; }
  .ssl-cols { grid-template-columns: 1fr 70px; }
  .ssl-cols > *:nth-child(2),
  .ssl-cols > *:nth-child(3),
  .ssl-cols > *:nth-child(4) { display: none; }
  .ip-cols { grid-template-columns: 1fr 70px; }
  .ip-cols > *:nth-child(2),
  .ip-cols > *:nth-child(3) { display: none; }
  .ssh-cols { grid-template-columns: 1fr 70px; }
  .ssh-cols > *:nth-child(2),
  .ssh-cols > *:nth-child(3),
  .ssh-cols > *:nth-child(4) { display: none; }
  .token-cols { grid-template-columns: 1fr 100px 70px; }
  .token-cols > *:nth-child(3) { display: none; }
}
</style>


<a href="#main-content" class="sr-only" data-t>Skip to main content</a>

<div class="layout-shell">

  <!-- Header -->
  <meridian-header></meridian-header>

  <!-- Sidebar -->
  <meridian-sidebar active="security"></meridian-sidebar>

  <!-- Main Content -->
  <main class="layout-main" id="main-content">
    <div class="main-content">

      <div id="pageContent" style="display:none;">

        <!-- Page header -->
        <div class="page-header animate-in stagger-1">
          <div class="page-header-left">
            <div>
              <h1 class="page-title" data-t>Security</h1>
              <div class="page-subtitle" data-t>SSL certificates, firewall, access control, and API tokens</div>
            </div>
          </div>
        </div>

        <!-- Security Score Overview -->
        <div class="score-row animate-in stagger-2">
          <div class="score-card" id="scoreCard">
            <div class="score-ring" id="scoreRing">
              <svg viewBox="0 0 100 100">
                <circle class="score-ring-bg" cx="50" cy="50" r="42"></circle>
                <circle class="score-ring-fill" id="scoreCircle" cx="50" cy="50" r="42"
                  stroke-dasharray="263.9" stroke-dashoffset="263.9"></circle>
              </svg>
              <div class="score-ring-text" id="scoreValue">--</div>
            </div>
            <div class="score-label" data-t>Security Score</div>
          </div>
          <div class="status-grid" id="statusGrid">
            <div class="status-card">
              <div class="status-card-header">
                <div class="status-card-icon ssl"><i class="ri-lock-line" aria-hidden="true"></i></div>
                <div class="status-card-title" data-t>SSL Status</div>
              </div>
              <div class="status-card-value" id="statusSSL">--</div>
            </div>
            <div class="status-card">
              <div class="status-card-header">
                <div class="status-card-icon waf"><i class="ri-shield-flash-line" aria-hidden="true"></i></div>
                <div class="status-card-title" data-t>WAF Status</div>
              </div>
              <div class="status-card-value" id="statusWAF">--</div>
            </div>
            <div class="status-card">
              <div class="status-card-header">
                <div class="status-card-icon twofa"><i class="ri-smartphone-line" aria-hidden="true"></i></div>
                <div class="status-card-title" data-t>2FA Status</div>
              </div>
              <div class="status-card-value" id="status2FA">--</div>
            </div>
            <div class="status-card">
              <div class="status-card-header">
                <div class="status-card-icon password"><i class="ri-key-2-line" aria-hidden="true"></i></div>
                <div class="status-card-title" data-t>Password Strength</div>
              </div>
              <div class="status-card-value" id="statusPassword">--</div>
            </div>
          </div>
        </div>

        <!-- Main Tabs -->
        <div class="detail-tabs-bar animate-in stagger-3" id="mainTabs" role="tablist">
          <button class="detail-tab active" data-tab="ssl" type="button" role="tab" aria-selected="true">
            <i class="ri-lock-line" aria-hidden="true"></i> <span data-t>SSL/TLS</span>
          </button>
          <button class="detail-tab" data-tab="firewall" type="button" role="tab" aria-selected="false">
            <i class="ri-shield-flash-line" aria-hidden="true"></i> <span data-t>Firewall</span>
          </button>
          <button class="detail-tab" data-tab="access" type="button" role="tab" aria-selected="false">
            <i class="ri-user-settings-line" aria-hidden="true"></i> <span data-t>Access Control</span>
          </button>
          <button class="detail-tab" data-tab="tokens" type="button" role="tab" aria-selected="false">
            <i class="ri-key-line" aria-hidden="true"></i> <span data-t>API Tokens</span>
          </button>
        </div>

        <!-- Tab Content -->
        <div class="animate-in stagger-4" id="tabContent"></div>

      </div><!-- /pageContent -->
    </div>
  </main>
</div>

<!-- Create Token Modal -->
<div class="modal-overlay" id="tokenModal" role="dialog" aria-modal="true" aria-labelledby="tokenModalTitle">
  <div class="modal">
    <div class="modal-header">
      <h2 class="t-heading t-heading-md" id="tokenModalTitle" data-t>Create API Token</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeTokenModal()">
        <i class="ri-close-line" aria-hidden="true"></i>
      </button>
    </div>
    <form id="tokenForm" onsubmit="handleCreateToken(event); return false;">
      <div class="form-group">
        <label class="form-label" data-t>Token Name</label>
        <input type="text" id="tokenName" class="form-input" placeholder="e.g. Backup Script" required>
      </div>
      <div class="form-group">
        <label class="form-label" data-t>Access Level</label>
        <div class="tab-switcher" role="tablist">
          <button type="button" class="tab-switcher-btn active" onclick="setTokenScope('full', this)" role="tab" aria-selected="true" data-t>Full Access</button>
          <button type="button" class="tab-switcher-btn" onclick="setTokenScope('limited', this)" role="tab" aria-selected="false" data-t>Limited</button>
        </div>
      </div>
      <div id="featureSelection" style="display:none;">
        <label class="form-label" data-t>Select Features</label>
        <div class="feature-grid">
          <label class="form-check"><input type="checkbox" name="feat" value="Email" data-t> Email</label>
          <label class="form-check"><input type="checkbox" name="feat" value="DNS" data-t> DNS</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Files" data-t> Files</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Backup" data-t> Backup</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Databases" data-t> Databases</label>
          <label class="form-check"><input type="checkbox" name="feat" value="SSL" data-t> SSL/TLS</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Domains" data-t> Domains</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Metrics" data-t> Metrics</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Cron" data-t> Cron Jobs</label>
          <label class="form-check"><input type="checkbox" name="feat" value="Security" data-t> Security</label>
        </div>
      </div>
      <div id="tokenRevealBox" style="display:none;">
        <div class="token-reveal">
          <code id="tokenRevealValue"></code>
          <button type="button" class="btn btn-ghost btn-sm" onclick="copyToken()"><i class="ri-file-copy-line" aria-hidden="true"></i> <span data-t>Copy</span></button>
        </div>
        <div class="form-hint" style="margin-top: var(--space-2); color: var(--status-warning);">
          <i class="ri-error-warning-line" aria-hidden="true"></i> <span data-t>This token will only be shown once. Copy it now.</span>
        </div>
      </div>
      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-6);">
        <button type="button" class="btn btn-secondary" onclick="closeTokenModal()" data-t>Cancel</button>
        <button type="submit" class="btn btn-primary" id="tokenSubmitBtn">
          <i class="ri-add-line" aria-hidden="true"></i> <span data-t>Generate Token</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- SSH Key Modal -->
<div class="modal-overlay" id="sshModal" role="dialog" aria-modal="true" aria-labelledby="sshModalTitle">
  <div class="modal">
    <div class="modal-header">
      <h2 class="t-heading t-heading-md" id="sshModalTitle" data-t>Generate SSH Key</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeSSHModal()">
        <i class="ri-close-line" aria-hidden="true"></i>
      </button>
    </div>
    <form id="sshForm" onsubmit="handleGenerateKey(event); return false;">
      <div class="form-group">
        <label class="form-label" data-t>Key Name</label>
        <input type="text" id="sshKeyName" class="form-input" placeholder="e.g. deploy-key" required>
      </div>
      <div class="form-group">
        <label class="form-label" data-t>Key Type</label>
        <div class="tab-switcher" role="tablist">
          <button type="button" class="tab-switcher-btn active" data-keytype="ed25519" role="tab" aria-selected="true">ED25519</button>
          <button type="button" class="tab-switcher-btn" data-keytype="rsa" role="tab" aria-selected="false">RSA 4096</button>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" data-t>Passphrase (optional)</label>
        <input type="password" id="sshPassphrase" class="form-input" placeholder="Optional passphrase">
      </div>
      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-6);">
        <button type="button" class="btn btn-secondary" onclick="closeSSHModal()" data-t>Cancel</button>
        <button type="submit" class="btn btn-primary" id="sshSubmitBtn">
          <i class="ri-add-line" aria-hidden="true"></i> <span data-t>Generate Key</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Certificate Details Modal -->
<div class="modal-overlay" id="certDetailOverlay" role="dialog" aria-modal="true" aria-labelledby="certDetailTitle">
  <div class="modal" style="max-width: 560px;">
    <div class="modal-header">
      <h2 class="modal-title" id="certDetailTitle" data-t>Certificate Details</h2>
      <button type="button" class="modal-close" aria-label="Close" onclick="closeCertDetail()">
        <i class="ri-close-line" aria-hidden="true"></i>
      </button>
    </div>
    <div class="modal-body" id="certDetailBody">
      <!-- Filled dynamically -->
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" onclick="closeCertDetail()" data-t>Close</button>
    </div>
  </div>
</div>

<div id="confirmContainer"></div>

<script>
// ===================================================================
// STATE
// ===================================================================

let secData = null;
let isLive = true;
let activeTab = 'ssl';
let activeFirewallSub = 'modsecurity';
let activeAccessSub = 'ssh';
let tokenScope = 'full';
let generatedToken = null;
let sshKeyType = 'ed25519';


// ===================================================================
// HELPERS
// ===================================================================

// escapeHtml() provided globally by shell.js

// confirmAction() — delegates to shared window.confirmAction from shell.js
function confirmAction(opts) {
  return window.confirmAction({
    title: opts.title,
    message: opts.message,
    danger: (opts.variant || 'danger') === 'danger',
    confirmLabel: opts.confirmText || t('Confirm')
  });
}

function maskToken(tok) {
  if (!tok || tok.length < 12) return tok || '';
  return tok.substring(0, 8) + '...' + tok.substring(tok.length - 4);
}

function sslStatusIcon(d) {
  if (!d.valid && !d.cert) return `<i class="ri-shield-cross-line" aria-hidden="true" style="color: var(--status-error); font-size: var(--text-md);"></i>`;
  if (d.daysLeft <= 30) return `<i class="ri-shield-line" aria-hidden="true" style="color: var(--status-warning); font-size: var(--text-md);"></i>`;
  return `<i class="ri-shield-check-line" aria-hidden="true" style="color: var(--status-success); font-size: var(--text-md);"></i>`;
}

function sslBadge(cert) {
  if (!cert) return `<span class="badge badge-error">${t('No SSL')}</span>`;
  const map = {
    'AutoSSL': 'badge-info',
    "Let's Encrypt": 'badge-success',
    'Comodo': 'badge-accent',
    'Self-Signed': 'badge-warning'
  };
  return `<span class="badge ${map[cert] || 'badge-neutral'}">${escapeHtml(cert)}</span>`;
}

function validateIP(val) {
  val = val.trim();
  // Basic IPv4, IPv6, or CIDR
  const ipv4 = /^(\d{1,3}\.){3}\d{1,3}(\/\d{1,2})?$/;
  const ipv6 = /^([0-9a-fA-F:]+)(\/\d{1,3})?$/;
  return ipv4.test(val) || ipv6.test(val);
}


// ===================================================================
// CONNECTION & INIT
// ===================================================================

async function init() {
  await CpanelAPI.loadFeatures();
  if (typeof applyFeatureGating === 'function') applyFeatureGating();

  try {
    await loadLiveData();
  } catch (err) {
    console.error('Failed to load security data:', err);
  }

  // Feature-gate security tabs
  var mainTabs = document.getElementById('mainTabs');
  if (mainTabs) {
    var tabFeatureMap = {
      'ssl': 'sslmanager',
      'firewall': 'modsecurity',
      'access': 'ssh'
    };
    Object.keys(tabFeatureMap).forEach(function(tabId) {
      if (!CpanelAPI.hasFeature(tabFeatureMap[tabId])) {
        var tab = mainTabs.querySelector('[data-tab="' + tabId + '"]');
        if (tab) tab.style.display = 'none';
        // If the hidden tab was active, switch to first visible tab
        if (activeTab === tabId) {
          var firstVisible = mainTabs.querySelector('.detail-tab:not([style*="display: none"])');
          if (firstVisible) {
            activeTab = firstVisible.dataset.tab;
            firstVisible.classList.add('active');
            firstVisible.setAttribute('aria-selected', 'true');
          }
        }
      }
    });
  }

  updateScoreDisplay();
  updateStatusCards();
  renderTab();
  bindEvents();

  document.getElementById('pageContent').style.display = '';
}

async function loadLiveData() {
  try {
    const [sslResult, modsecResult, ipResult, tokenResult, sshResult, tfaResult] = await Promise.all([
      CpanelAPI.call('SSL', 'installed_hosts').catch(() => ({ data: [] })),
      CpanelAPI.call('ModSecurity', 'list_domains').catch(() => ({ data: [] })),
      CpanelAPI.call('DenyIp', 'listdenyips').catch(() => ({ data: [] })),
      CpanelAPI.call('Tokens', 'list').catch(() => ({ data: [] })),
      CpanelAPI.call2('SSH', 'listkeys').catch(() => ({ data: [] })),
      CpanelAPI.call('TwoFactorAuth', 'get_user_configuration').catch(() => null),
    ]);

    secData = {
      score: 0,
      ssl: { domains: [], autosslLastRun: '', autosslStatus: 'idle' },
      modsecurity: { domains: [] },
      blockedIps: [],
      sshKeys: [],
      apiTokens: [],
      twoFactor: { enabled: false, method: '' },
      passwordStrength: 0
    };

    // Map live SSL data
    if (sslResult.data && sslResult.data.length) {
      secData.ssl.domains = sslResult.data.map(h => {
        const exp = h.certificate?.not_after ? new Date(h.certificate.not_after * 1000) : null;
        const daysLeft = exp ? Math.max(0, Math.ceil((exp - Date.now()) / 86400000)) : 0;
        // issuer.organizationName = CA name (e.g. "Let's Encrypt")
        // issuer.commonName = CA's CN (e.g. "R3", "E1") — NOT the domain
        // subject.commonName = the domain — don't use for issuer display
        var issuerOrg = (h.certificate && h.certificate['issuer.organizationName']) || h.certificate?.issuer?.organizationName || null;
        return {
          domain: h.servername || h.domain,
          issuer: issuerOrg || t('Unknown'),
          expires: exp ? exp.toISOString().split('T')[0] : null,
          valid: !!h.certificate && daysLeft > 0,
          autossl: true,
          httpsRedirect: false,
          daysLeft,
          certificate: h.certificate || null,
          domains: h.certificate_domains || [h.servername || h.domain]
        };
      });
    }

    if (modsecResult.data && modsecResult.data.length) {
      secData.modsecurity.domains = modsecResult.data.map(d => ({
        domain: d.domain, enabled: d.enabled === 1 || d.enabled === '1' || d.enabled === true
      }));
    }

    if (ipResult.data && ipResult.data.length) {
      secData.blockedIps = ipResult.data.map(ip => ({
        ip: ip.ip || ip, note: '', added: ''
      }));
    }

    if (tokenResult.data && tokenResult.data.length) {
      secData.apiTokens = tokenResult.data.map(t => ({
        name: t.name, created: t.create_time || '', lastUsed: '', scope: t.full_access ? 'Full' : 'Limited', features: t.features || [], token: t.token || ''
      }));
    }

    // 2FA status from TwoFactorAuth::get_user_configuration
    if (tfaResult && tfaResult.data) {
      secData.twoFactor.enabled = !!(tfaResult.data.is_enabled || tfaResult.data.secret);
    } else if (tfaResult) {
      secData.twoFactor.enabled = false;
    }

    // Map SSH keys from API2 SSH::listkeys
    if (sshResult.data && sshResult.data.length) {
      secData.sshKeys = sshResult.data.map(k => ({
        name: k.file || k.key || 'unknown',
        type: (k.type || 'rsa').toUpperCase(),
        fingerprint: k.fingerprint || '-',
        added: k.modtime || '-',
        authorized: k.authstatus === 'authorized' || k.authstatus === '1'
      }));
    }

    isLive = true;

  } catch (err) {
    console.error('Failed to load live data:', err);
  }
}


// ===================================================================
// SCORE & STATUS DISPLAY
// ===================================================================

function computeSecurityScore() {
  let score = 0;
  let maxScore = 0;

  // SSL certificates (30 points max)
  const sslDomains = secData.ssl.domains;
  if (sslDomains.length > 0) {
    const validPct = sslDomains.filter(d => d.valid).length / sslDomains.length;
    score += Math.round(validPct * 20);
    // HTTPS redirect bonus
    const redirectPct = sslDomains.filter(d => d.httpsRedirect).length / sslDomains.length;
    score += Math.round(redirectPct * 10);
  }
  maxScore += 30;

  // ModSecurity / WAF (20 points max)
  const wafDomains = secData.modsecurity.domains;
  if (wafDomains.length > 0) {
    const enabledPct = wafDomains.filter(d => d.enabled).length / wafDomains.length;
    score += Math.round(enabledPct * 20);
  }
  maxScore += 20;

  // 2FA enabled (20 points)
  if (secData.twoFactor && secData.twoFactor.enabled) score += 20;
  maxScore += 20;

  // SSH keys with authorization (15 points)
  if (secData.sshKeys && secData.sshKeys.length > 0) {
    score += 10;
    if (secData.sshKeys.some(k => k.authorized)) score += 5;
  }
  maxScore += 15;

  // IP blocking active (10 points)
  if (secData.blockedIps && secData.blockedIps.length > 0) score += 10;
  maxScore += 10;

  // API tokens exist (5 points)
  if (secData.apiTokens && secData.apiTokens.length > 0) score += 5;
  maxScore += 5;

  return Math.round((score / maxScore) * 100);
}

function updateScoreDisplay() {
  secData.score = computeSecurityScore();
  const score = secData.score;
  const circumference = 2 * Math.PI * 42;
  const offset = circumference - (score / 100) * circumference;
  const circle = document.getElementById('scoreCircle');
  circle.style.strokeDashoffset = offset;

  let color;
  if (score >= 80) color = 'var(--status-success)';
  else if (score >= 60) color = 'var(--status-warning)';
  else color = 'var(--status-error)';
  circle.style.stroke = color;

  const valEl = document.getElementById('scoreValue');
  valEl.textContent = score;
  valEl.style.color = color;
}

function updateStatusCards() {
  const sslValid = secData.ssl.domains.filter(d => d.valid).length;
  const sslTotal = secData.ssl.domains.length;
  const sslEl = document.getElementById('statusSSL');
  sslEl.innerHTML = `<span style="color: ${sslValid === sslTotal ? 'var(--status-success)' : 'var(--status-warning)'}">${t('{0} of {1} Valid', sslValid, sslTotal)}</span>`;

  const wafEnabled = secData.modsecurity.domains.filter(d => d.enabled).length;
  const wafTotal = secData.modsecurity.domains.length;
  const wafEl = document.getElementById('statusWAF');
  wafEl.innerHTML = `<span style="color: ${wafEnabled === wafTotal ? 'var(--status-success)' : 'var(--status-warning)'}">${t('{0} of {1} Enabled', wafEnabled, wafTotal)}</span>`;

  const tfaEl = document.getElementById('status2FA');
  if (secData.twoFactor.enabled) {
    tfaEl.innerHTML = `<span style="color: var(--status-success)">${t('Enabled (TOTP)')}</span>`;
  } else {
    tfaEl.innerHTML = `<span style="color: var(--status-error)">${t('Disabled')}</span>`;
  }

  const pwEl = document.getElementById('statusPassword');
  const pw = secData.passwordStrength;
  let pwColor = pw >= 80 ? 'var(--status-success)' : pw >= 60 ? 'var(--status-warning)' : 'var(--status-error)';
  let pwLabel = pw >= 80 ? t('Strong') : pw >= 60 ? t('Fair') : t('Weak');
  pwEl.innerHTML = `<span style="color: ${pwColor}">${pwLabel} (${pw}%)</span>`;
}


// ===================================================================
// TAB RENDERING
// ===================================================================

function renderTab() {
  const el = document.getElementById('tabContent');
  switch (activeTab) {
    case 'ssl': renderSSLTab(el); break;
    case 'firewall': renderFirewallTab(el); break;
    case 'access': renderAccessTab(el); break;
    case 'tokens': renderTokensTab(el); break;
  }
}

function renderSSLTab(el) {
  const domains = secData.ssl.domains;
  const rows = domains.map((d, i) => `
    <div class="sec-row ssl-cols">
      <div class="cell cell-bold" style="display:flex; align-items:center; gap: var(--space-2);">
        ${sslStatusIcon(d)} ${escapeHtml(d.domain)}
      </div>
      <div class="cell">${escapeHtml(d.issuer) || '<span class="t-dimmed">--</span>'}</div>
      <div class="cell">${d.expires ? `<span style="color: ${d.daysLeft <= 30 ? 'var(--status-warning)' : 'var(--text-secondary)'};">${escapeHtml(d.expires)}</span>` : '<span class="t-dimmed">--</span>'}</div>
      <div class="cell">${d.autossl ? `<span class="badge badge-success">${t('On')}</span>` : `<span class="badge badge-neutral">${t('Off')}</span>`}</div>
      <div class="cell">
        <label style="display:flex; align-items:center; cursor:pointer;">
          <input type="checkbox" class="toggle" ${d.httpsRedirect ? 'checked' : ''} onchange="toggleHTTPS(${i}, this.checked)" aria-label="${t('HTTPS redirect for {0}', escapeHtml(d.domain))}">
        </label>
      </div>
      <div class="cell" style="display:flex; justify-content:flex-end;">
        <button class="btn btn-ghost btn-sm btn-icon" onclick="showCertDetail(${i})" aria-label="${t('View details')}"><i class="ri-eye-line" aria-hidden="true"></i></button>
      </div>
    </div>
  `).join('');

  el.innerHTML = `
    <div class="site-info" style="margin-bottom: var(--space-4); padding: var(--space-4) var(--space-5);">
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap: var(--space-3);">
        <div style="display:flex; align-items:center; gap: var(--space-3);">
          <i class="ri-refresh-line" aria-hidden="true" style="color: var(--text-tertiary);"></i>
          <span class="t-body-sm t-muted">${t('AutoSSL last run:')} ${escapeHtml(secData.ssl.autosslLastRun)}</span>
          <span class="badge badge-neutral">${t(secData.ssl.autosslStatus)}</span>
        </div>
        <button class="btn btn-primary btn-sm" onclick="runAutoSSL()"><i class="ri-refresh-line" aria-hidden="true"></i> ${t('Run AutoSSL')}</button>
      </div>
    </div>
    <div class="sec-table">
      <div class="sec-table-head ssl-cols">
        <div>${t('Domain')}</div>
        <div>${t('Issuer')}</div>
        <div>${t('Expires')}</div>
        <div>${t('AutoSSL')}</div>
        <div>${t('HTTPS')}</div>
        <div></div>
      </div>
      ${rows}
    </div>`;
}

