        <div style="display:flex; gap: var(--space-2); align-items: flex-start;">
          <div style="flex:1;">
            <input type="text" id="blockIpInput" class="form-input" placeholder="${t('e.g. 192.168.1.0/24')}">
            <div class="form-hint">${t('Supports IPv4, IPv6, and CIDR notation')}</div>
          </div>
          <input type="text" id="blockIpNote" class="form-input" placeholder="${t('Note (optional)')}" style="flex:1;">
          <button class="btn btn-primary" onclick="addBlockedIP()" style="flex-shrink:0;"><i class="ri-add-line" aria-hidden="true"></i> ${t('Block')}</button>
        </div>
      </div>
      <div style="margin-bottom: var(--space-3); font-size: var(--text-sm); color: var(--text-tertiary);">
        ${t('{n} blocked IP | {n} blocked IPs', {n: ips.length})}
