          <div>${t('Key Name')}</div>
          <div>${t('Type')}</div>
          <div>${t('Fingerprint')}</div>
          <div>${t('Added')}</div>
          <div></div>
        </div>
        ${rows.length ? rows : `<div class="sec-row ssh-cols"><div class="cell t-muted" style="grid-column: 1/-1; text-align:center;">${t('No SSH keys configured')}</div></div>`}
      </div>`;
  } else {
    const pw = secData.passwordStrength;
    let pwStrength, pwSegs;
    if (pw >= 80) { pwStrength = 'strong'; pwSegs = 4; }
    else if (pw >= 60) { pwStrength = 'good'; pwSegs = 3; }
    else if (pw >= 40) { pwStrength = 'fair'; pwSegs = 2; }
    else { pwStrength = 'weak'; pwSegs = 1; }
    const pwStrengthLabels = { strong: t('Strong'), good: t('Good'), fair: t('Fair'), weak: t('Weak') };

    // Note: cPanel has no public UAPI for listing active sessions.
    // Show current session info only (from LastLogin if available).
    const sessions = isLive
      ? [{ browser: (navigator.userAgent.match(/Chrome|Firefox|Safari|Edge/)?.[0] || '') + ' ' + t('session'), ip: '', time: t('Current session') }]
      : [
          { browser: 'Chrome on macOS', ip: '73.162.88.42', time: t('Current session') },
          { browser: 'Firefox on Windows', ip: '98.45.12.67', time: t('2 hours ago') },
        ];
    const sessionRows = sessions.map(s => `
      <div class="list-item">
        <div class="list-item-left">
          <div class="list-item-icon"><i class="ri-computer-line" aria-hidden="true"></i></div>
          <div>
            <div class="list-item-text">${escapeHtml(s.browser)}</div>
            <div class="list-item-sub">${t('IP:')} ${escapeHtml(s.ip)} &middot; ${escapeHtml(s.time)}</div>
          </div>
        </div>
        <div class="list-item-right">
          ${s.time === t('Current session') ? `<span class="badge badge-success">${t('Current')}</span>` : `<span class="t-body-sm t-muted">${escapeHtml(s.time)}</span>`}
        </div>
      </div>
    `).join('');

    el.innerHTML = `${subTabsHtml}
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap: var(--space-6);">
        <div class="site-info">
          <div class="site-info-title">${t('Change Password')}</div>
          <div class="form-group">
            <label class="form-label">${t('Current Password')}</label>
            <input type="password" id="currentPassword" class="form-input" placeholder="${t('Enter current password')}">
          </div>
          <div class="form-group">
            <label class="form-label">${t('New Password')}</label>
            <div style="display:flex; gap: var(--space-2);">
              <input type="password" id="newPassword" class="form-input" placeholder="${t('Enter new password')}" oninput="updatePwStrength()">
              <button type="button" class="btn btn-secondary btn-sm" onclick="generatePw()" style="flex-shrink:0;">${t('Generate')}</button>
            </div>
            <div class="password-strength" id="pwMeter" data-strength="${pwStrength}">
              <div class="password-strength-segment ${pwSegs >= 1 ? 'filled' : ''}"></div>
              <div class="password-strength-segment ${pwSegs >= 2 ? 'filled' : ''}"></div>
              <div class="password-strength-segment ${pwSegs >= 3 ? 'filled' : ''}"></div>
              <div class="password-strength-segment ${pwSegs >= 4 ? 'filled' : ''}"></div>
            </div>
            <div class="password-strength-label" id="pwLabel">${t('Current:')} ${pwStrengthLabels[pwStrength]}</div>
          </div>
          <div class="form-group">
            <label class="form-label">${t('Confirm New Password')}</label>
            <input type="password" id="confirmPassword" class="form-input" placeholder="${t('Confirm new password')}">
          </div>
          <button class="btn btn-primary" onclick="changePassword()"><i class="ri-lock-line" aria-hidden="true"></i> ${t('Update Password')}</button>
        </div>

        <div class="stack stack-lg">
          <div class="site-info">
            <div class="site-info-title">${t('Two-Factor Authentication')}</div>
            <div class="settings-row">
              <div class="settings-row-label">
                <i class="ri-smartphone-line" aria-hidden="true"></i> ${t('2FA Status')}
              </div>
              <div>
                ${secData.twoFactor.enabled
                  ? `<span class="badge badge-success"><i class="ri-check-line" aria-hidden="true"></i> ${t('Enabled (TOTP)')}</span>`
                  : `<span class="badge badge-error">${t('Disabled')}</span>`}
              </div>
            </div>
            ${secData.twoFactor.enabled
              ? `<button class="btn btn-danger btn-sm" style="margin-top: var(--space-3);" onclick="toggle2FA(false)"><i class="ri-close-line" aria-hidden="true"></i> ${t('Disable 2FA')}</button>`
              : `<button class="btn btn-primary btn-sm" style="margin-top: var(--space-3);" onclick="toggle2FA(true)"><i class="ri-smartphone-line" aria-hidden="true"></i> ${t('Set Up 2FA')}</button>`}
          </div>

          <div class="site-info">
            <div class="site-info-title">${t('Active Sessions')}</div>
            ${sessionRows}
          </div>
        </div>
      </div>`;
  }
}

