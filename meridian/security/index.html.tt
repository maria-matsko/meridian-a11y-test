        <div class="cell" style="font-family: var(--font-mono); font-size: var(--text-xs);">${escapeHtml(k.fingerprint)}</div>
        <div class="cell">${escapeHtml(k.added)}</div>
        <div class="cell" style="display:flex; justify-content:flex-end;">
          <button class="btn btn-ghost btn-sm btn-icon" onclick="removeSSHKey(${i})" aria-label="${t('Remove key')}"><i class="ri-delete-bin-line" aria-hidden="true" style="color: var(--status-error);"></i></button>
