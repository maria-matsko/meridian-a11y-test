      <div class="cell">${escapeHtml(t.created)}</div>
      <div class="cell">${escapeHtml(t.lastUsed) || `<span class="t-dimmed">${window.t('Never')}</span>`}</div>
      <div class="cell">
        ${t.scope === 'Full'
          ? `<span class="badge badge-accent">${window.t('Full Access')}</span>`
          : `<span class="badge badge-info">${window.t('Limited')}</span>`}
        ${t.features.length ? `<div style="font-size: var(--text-xs); color: var(--text-tertiary); margin-top: 2px;">${t.features.join(', ')}</div>` : ''}
      </div>
      <div class="cell" style="display:flex; justify-content:flex-end;">
        <button class="btn btn-danger btn-sm" onclick="revokeToken(${i})"><i class="ri-close-line" aria-hidden="true"></i> ${window.t('Revoke')}</button>
      </div>
    </div>
  `).join('');

  el.innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: var(--space-4);">
      <div class="t-body-sm t-muted">${t('{n} API token | {n} API tokens', {n: tokens.length})}</div>
      <button class="btn btn-primary btn-sm" onclick="openTokenModal()"><i class="ri-add-line" aria-hidden="true"></i> ${t('Create Token')}</button>
    </div>
    <div class="sec-table">
      <div class="sec-table-head token-cols">
        <div>${t('Name')}</div>
        <div>${t('Created')}</div>
        <div>${t('Last Used')}</div>
        <div>${t('Scope')}</div>
        <div></div>
      </div>
      ${rows.length ? rows : `<div class="sec-row token-cols"><div class="cell t-muted" style="grid-column: 1/-1; text-align:center;">${t('No API tokens')}</div></div>`}
    </div>`;
}


// ===================================================================
// ACTIONS
// ===================================================================

async function toggleHTTPS(idx, checked) {
  const d = secData.ssl.domains[idx];
  try {
    if (isLive) {
      // Jupiter passes domains as comma-separated string
      await CpanelAPI.call('SSL', 'toggle_ssl_redirect_for_domains', {
        state: checked ? 1 : 0,
        domains: d.domain
      });
    }
    d.httpsRedirect = checked;
    showToast(checked ? t('HTTPS redirect enabled for {0}', d.domain) : t('HTTPS redirect disabled for {0}', d.domain));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
    renderTab();
  }
}

async function runAutoSSL() {
  try {
    if (isLive) {
      await CpanelAPI.call('SSL', 'start_autossl_check');
    }
    secData.ssl.autosslStatus = 'running';
    showToast(t('AutoSSL check started'));
    renderTab();
    setTimeout(() => {
      secData.ssl.autosslStatus = 'idle';
      secData.ssl.autosslLastRun = new Date().toISOString().replace('T', ' ').substring(0, 16);
      if (activeTab === 'ssl') renderTab();
    }, 3000);
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
  }
}

// --- Certificate Detail Modal ---
let _certDetailTrap = null;

function showCertDetail(domainIndex) {
  const d = secData.ssl.domains[domainIndex];
  if (!d) return;

  const cert = d.certificate || {};
  const issuerOrg = cert['issuer.organizationName'] || cert.issuer_org || d.issuer || t('Unknown');
  const issuerCN = cert['issuer.commonName'] || cert.issuer_cn || issuerOrg;
  const notAfter = cert.not_after ? new Date(cert.not_after * 1000) : (d.expires ? new Date(d.expires) : null);
  const notBefore = cert.not_before ? new Date(cert.not_before * 1000) : null;
  const daysLeft = d.daysLeft !== undefined ? d.daysLeft : (notAfter ? Math.floor((notAfter - Date.now()) / 86400000) : null);
  const domains = d.domains || [d.domain];
  const keyType = cert.key_algorithm === 'ecPublicKey' ? 'ECDSA' : 'RSA';
  const keySize = cert.modulus_length ? ` ${cert.modulus_length}-bit` : (cert.ecdsa_curve_name ? ` (${cert.ecdsa_curve_name})` : '');

  const statusClass = !notAfter ? 'neutral' : (daysLeft < 0 ? 'error' : (daysLeft < 30 ? 'warning' : 'success'));
  const statusText = !notAfter ? t('Unknown') : (daysLeft < 0 ? t('Expired') : (daysLeft < 30 ? t('Expiring soon') : t('Valid')));

  document.getElementById('certDetailBody').innerHTML = `
    <div style="display:flex; align-items:center; gap:var(--space-3); margin-bottom:var(--space-5);">
      <div style="width:40px;height:40px;border-radius:var(--radius-lg);background:var(--bg-muted);display:flex;align-items:center;justify-content:center;">
        <i class="ri-shield-check-line" style="font-size:20px; color:var(--status-${statusClass});"></i>
      </div>
      <div>
        <div class="t-body-md" style="font-weight:var(--weight-semibold);">${escapeHtml(d.domain)}</div>
        <span class="badge badge-${statusClass}">${statusText}</span>
      </div>
    </div>

    <div class="site-info-grid" style="gap:var(--space-4);">
      <div class="site-info-item">
        <div class="site-info-label">${t('Issuer')}</div>
        <div class="site-info-value">${escapeHtml(issuerOrg)}</div>
      </div>
      <div class="site-info-item">
        <div class="site-info-label">${t('Common Name')}</div>
        <div class="site-info-value">${escapeHtml(issuerCN)}</div>
      </div>
      <div class="site-info-item">
        <div class="site-info-label">${t('Valid From')}</div>
        <div class="site-info-value">${notBefore ? notBefore.toLocaleDateString() : t('Unknown')}</div>
      </div>
      <div class="site-info-item">
        <div class="site-info-label">${t('Expires')}</div>
        <div class="site-info-value">${notAfter ? notAfter.toLocaleDateString() : t('Unknown')}${daysLeft !== null ? ' (' + daysLeft + ' ' + t('days') + ')' : ''}</div>
      </div>
      <div class="site-info-item">
        <div class="site-info-label">${t('Key Type')}</div>
        <div class="site-info-value">${keyType}${keySize}</div>
      </div>
      <div class="site-info-item">
        <div class="site-info-label">${t('Domains Covered')}</div>
        <div class="site-info-value">${Array.isArray(domains) ? domains.length : 1}</div>
      </div>
    </div>

    ${Array.isArray(domains) && domains.length > 1 ? `
      <div style="margin-top:var(--space-4);">
        <div class="site-info-label" style="margin-bottom:var(--space-2);">${t('Subject Alternative Names')}</div>
        <div style="display:flex; flex-wrap:wrap; gap:var(--space-1);">
          ${domains.map(dom => `<span class="badge badge-neutral">${escapeHtml(dom)}</span>`).join('')}
        </div>
      </div>
    ` : ''}
  `;

  const overlay = document.getElementById('certDetailOverlay');
  overlay.classList.add('show');
  if (typeof openModalWithTrap === 'function') {
    _certDetailTrap = openModalWithTrap(overlay, closeCertDetail);
  }
}

function closeCertDetail() {
  const overlay = document.getElementById('certDetailOverlay');
  overlay.classList.remove('show');
  if (_certDetailTrap && typeof _certDetailTrap === 'function') _certDetailTrap();
  _certDetailTrap = null;
}

async function toggleModSec(idx, checked) {
  const d = secData.modsecurity.domains[idx];
  try {
    if (isLive) {
      // API expects 'domains' as indexed array param
      const func = checked ? 'enable_domains' : 'disable_domains';
      await CpanelAPI.call('ModSecurity', func, { 'domains-0': d.domain });
    }
    d.enabled = checked;
    updateStatusCards();
    showToast(checked ? t('ModSecurity enabled for {0}', d.domain) : t('ModSecurity disabled for {0}', d.domain));
  } catch (err) {
    showToast(t('Failed: {0}', err.message), 'error');
    renderTab();
  }
}

async function bulkModSec(enable) {
  if (isLive) {
    try {
      // Build indexed array params for all domains
      const params = {};
      secData.modsecurity.domains.forEach((d, i) => {
        params[`domains-${i}`] = d.domain;
      });
      const func = enable ? 'enable_domains' : 'disable_domains';
      await CpanelAPI.call('ModSecurity', func, params);
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }
  secData.modsecurity.domains.forEach(d => d.enabled = enable);
  updateStatusCards();
  renderTab();
  showToast(enable ? t('ModSecurity enabled for all domains') : t('ModSecurity disabled for all domains'));
}

function addBlockedIP() {
  const ipInput = document.getElementById('blockIpInput');
  const noteInput = document.getElementById('blockIpNote');
  const ip = ipInput.value.trim();
  const note = noteInput.value.trim();

  if (!ip) { showToast(t('Please enter an IP address'), 'error'); return; }
  if (!validateIP(ip)) { showToast(t('Invalid IP address or CIDR notation'), 'error'); return; }

  if (isLive) {
    CpanelAPI.call('BlockIP', 'add_ip', { ip }).catch(err => showToast(t('Failed: {0}', err.message), 'error'));
  }

  secData.blockedIps.push({ ip, note, added: new Date().toISOString().split('T')[0] });
  renderTab();
  showToast(t('IP {0} blocked', ip));
}

async function removeIP(idx) {
  const ip = secData.blockedIps[idx];
  const confirmed = await confirmAction({
    title: t('Remove Blocked IP'),
    message: t('Remove {0} from the block list?', `<strong>${escapeHtml(ip.ip)}</strong>`),
    confirmText: t('Remove'),
    variant: 'danger'
  });
  if (!confirmed) return;

  if (isLive) {
    CpanelAPI.call('BlockIP', 'remove_ip', { ip: ip.ip }).catch(err => showToast(t('Failed: {0}', err.message), 'error'));
  }
  secData.blockedIps.splice(idx, 1);
  renderTab();
  showToast(t('IP removed from block list'));
}

async function loadSSHKeysLive() {
  try {
    // API2 SSH::listkeys returns all keys on the account
    const result = await CpanelAPI.call2('SSH', 'listkeys');
    const keys = result.data || [];
    secData.sshKeys = keys.map(k => ({
      name: k.file || k.key || 'unknown',
      type: (k.type || 'rsa').toUpperCase(),
      fingerprint: k.fingerprint || '-',
      added: k.modtime || '-',
      authorized: k.authstatus === 'authorized' || k.authstatus === '1'
    }));
  } catch (err) {
    console.warn('Failed to load SSH keys:', err);
  }
}

async function removeSSHKey(idx) {
  const key = secData.sshKeys[idx];
  const confirmed = await confirmAction({
    title: t('Remove SSH Key'),
    message: t('Remove key {0}?', `<strong>${escapeHtml(key.name)}</strong>`),
    confirmText: t('Remove'),
    variant: 'danger'
  });
  if (!confirmed) return;

  if (isLive) {
    try {
      // API2 SSH::delkey — removes key pair from server
      await CpanelAPI.call2('SSH', 'delkey', { name: key.name, pub: 1 });
      // Also remove private key
      await CpanelAPI.call2('SSH', 'delkey', { name: key.name, pub: 0 }).catch(() => {});
      await loadSSHKeysLive();
      renderTab();
      showToast(t('SSH key removed'));
      return;
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }

  secData.sshKeys.splice(idx, 1);
  renderTab();
  showToast(t('SSH key removed'));
}

async function importSSHKey() {
  const key = prompt(t('Paste your public SSH key:'));
  if (!key || !key.trim()) return;

  if (isLive) {
    try {
      // API2 SSH::importkey — imports a key to the server
      // Extract key name from comment field or generate one
      const parts = key.trim().split(/\s+/);
      const name = parts.length >= 3 ? parts[2] : 'imported-key-' + Date.now().toString(36);
      await CpanelAPI.call2('SSH', 'importkey', {
        name: name,
        key: key.trim(),
        pass: ''
      });
      await loadSSHKeysLive();
      renderTab();
      showToast(t('SSH key imported'));
      return;
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }

  secData.sshKeys.push({
    name: 'imported-key-' + Date.now().toString(36),
    type: key.startsWith('ssh-ed25519') ? 'ED25519' : 'RSA 4096',
    fingerprint: 'SHA256:' + btoa(key).substring(0, 8) + '...' + btoa(key).substring(btoa(key).length - 4),
    added: new Date().toISOString().split('T')[0],
    authorized: true
  });
  renderTab();
  showToast(t('SSH key imported'));
}

async function revokeToken(idx) {
  const t = secData.apiTokens[idx];
  const confirmed = await confirmAction({
    title: window.t('Revoke API Token'),
    message: window.t('Revoke token {0}? Any integrations using this token will stop working.', `<strong>${escapeHtml(t.name)}</strong>`),
    confirmText: window.t('Revoke'),
    variant: 'danger'
  });
  if (!confirmed) return;

  if (isLive) {
    CpanelAPI.call('Tokens', 'revoke', { name: t.name }).catch(err => showToast(window.t('Failed: {0}', err.message), 'error'));
  }
  secData.apiTokens.splice(idx, 1);
  renderTab();
  showToast(window.t('API token revoked'));
}

async function changePassword() {
  const current = document.getElementById('currentPassword')?.value;
  const newPw = document.getElementById('newPassword')?.value;
  const confirmPw = document.getElementById('confirmPassword')?.value;

  if (!current) { showToast(t('Please enter current password'), 'error'); return; }
  if (!newPw) { showToast(t('Please enter new password'), 'error'); return; }
  if (newPw !== confirmPw) { showToast(t('Passwords do not match'), 'error'); return; }

  if (isLive) {
    try {
      // API2 Passwd::change_password — requires old and new password
      await CpanelAPI.call2('Passwd', 'change_password', {
        oldpass: current,
        newpass: newPw
      });
      // Note: cPanel logs the user out after password change
      showToast(t('Password changed — you may be redirected to login'));
      setTimeout(() => { window.location.href = '/login'; }, 2000);
      return;
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }
  secData.passwordStrength = 95;
  updateStatusCards();
  showToast(t('Password updated successfully'));
}

function generatePw() {
  const pw = window.generatePassword(20);
  const inp = document.getElementById('newPassword');
  inp.type = 'text';
  inp.value = pw;
  updatePwStrength();
}

function updatePwStrength() {
  const pw = document.getElementById('newPassword')?.value || '';
  let score = 0;
  if (pw.length >= 8) score++;
  if (pw.length >= 12) score++;
  if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
  if (/\d/.test(pw)) score++;
  if (/[^a-zA-Z0-9]/.test(pw)) score++;

  const strengths = ['', 'weak', 'fair', 'good', 'strong', 'strong'];
  const strength = strengths[Math.min(score, 5)] || '';
  const meter = document.getElementById('pwMeter');
  const label = document.getElementById('pwLabel');
  if (meter) {
    meter.dataset.strength = strength;
    const segs = meter.querySelectorAll('.password-strength-segment');
    const filled = strength === 'strong' ? 4 : strength === 'good' ? 3 : strength === 'fair' ? 2 : strength === 'weak' ? 1 : 0;
    segs.forEach((s, i) => s.classList.toggle('filled', i < filled));
  }
  if (label) label.textContent = strength ? strength.charAt(0).toUpperCase() + strength.slice(1) : '';
}

async function toggle2FA(enable) {
  if (isLive && enable) {
    // 2FA setup requires the TOTP configuration page — redirect there
    const token = CpanelAPI.getToken();
    window.open(`/${token}/frontend/jupiter/security/twofa/index.html`, '_blank');
    return;
  }
  if (isLive && !enable) {
    try {
      await CpanelAPI.call('TwoFactorAuth', 'remove_user_configuration');
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }
  secData.twoFactor.enabled = enable;
  updateStatusCards();
  renderTab();
  showToast(enable ? t('Two-factor authentication enabled') : t('Two-factor authentication disabled'));
}

function switchFirewallSub(sub) {
  activeFirewallSub = sub;
  renderTab();
}

function switchAccessSub(sub) {
  activeAccessSub = sub;
  renderTab();
}


// ===================================================================
// TOKEN MODAL
// ===================================================================

function openTokenModal() {
  generatedToken = null;
  document.getElementById('tokenModal').classList.add('show');
  document.getElementById('tokenName').value = '';
  document.getElementById('tokenRevealBox').style.display = 'none';
  document.getElementById('tokenSubmitBtn').style.display = '';
  document.getElementById('featureSelection').style.display = 'none';
  tokenScope = 'full';
  const btns = document.querySelectorAll('#tokenForm .tab-switcher-btn');
  btns[0].classList.add('active');
  btns[1].classList.remove('active');
  document.querySelectorAll('#tokenForm input[name="feat"]').forEach(cb => cb.checked = false);
  setTimeout(() => document.getElementById('tokenName').focus(), 100);
}

function closeTokenModal() {
  document.getElementById('tokenModal').classList.remove('show');
}

function setTokenScope(scope, btn) {
  tokenScope = scope;
  btn.parentElement.querySelectorAll('.tab-switcher-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('featureSelection').style.display = scope === 'limited' ? '' : 'none';
}

async function handleCreateToken(e) {
  e.preventDefault();
  if (generatedToken) { closeTokenModal(); return; }

  const name = document.getElementById('tokenName').value.trim();
  if (!name) { showToast(t('Please enter a token name'), 'error'); return; }

  const features = [];
  if (tokenScope === 'limited') {
    document.querySelectorAll('#tokenForm input[name="feat"]:checked').forEach(cb => features.push(cb.value));
    if (!features.length) { showToast(t('Select at least one feature'), 'error'); return; }
  }

  // Generate a mock token
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  let tok = 'tok_';
  for (let i = 0; i < 32; i++) tok += chars[Math.floor(Math.random() * chars.length)];

  if (isLive) {
    try {
      const func = tokenScope === 'full' ? 'create_full_access' : 'create_limited';
      const params = { name };
      // features param uses indexed array format: features-0, features-1, etc.
      if (tokenScope === 'limited') {
        features.forEach((f, i) => { params[`features-${i}`] = f; });
      }
      const result = await CpanelAPI.call('Tokens', func, params);
      // Use server-generated token if available
      if (result.data?.token) tok = result.data.token;
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }

  generatedToken = tok;
  secData.apiTokens.push({
    name,
    created: new Date().toISOString().split('T')[0],
    lastUsed: '',
    scope: tokenScope === 'full' ? 'Full' : 'Limited',
    features,
    token: tok
  });

  document.getElementById('tokenRevealBox').style.display = '';
  document.getElementById('tokenRevealValue').textContent = tok;
  document.getElementById('tokenSubmitBtn').innerHTML = `<i class="ri-check-line" aria-hidden="true"></i> ${t('Done')}`;

  renderTab();
  showToast(t('API token created'));
}

function copyToken() {
  const tok = document.getElementById('tokenRevealValue').textContent;
  navigator.clipboard.writeText(tok)
    .then(() => showToast(t('Token copied to clipboard')))
    .catch(() => showToast(t('Failed to copy — try selecting and copying manually'), 'error'));
}


// ===================================================================
// SSH KEY MODAL
// ===================================================================

function openSSHModal() {
  document.getElementById('sshModal').classList.add('show');
  document.getElementById('sshKeyName').value = '';
  document.getElementById('sshPassphrase').value = '';
  sshKeyType = 'ed25519';
  const btns = document.querySelectorAll('#sshForm .tab-switcher-btn');
  btns.forEach(b => {
    b.classList.toggle('active', b.dataset.keytype === 'ed25519');
    b.onclick = () => {
      sshKeyType = b.dataset.keytype;
      btns.forEach(bb => bb.classList.toggle('active', bb === b));
    };
  });
  setTimeout(() => document.getElementById('sshKeyName').focus(), 100);
}

function closeSSHModal() {
  document.getElementById('sshModal').classList.remove('show');
}

async function handleGenerateKey(e) {
  e.preventDefault();
  const name = document.getElementById('sshKeyName').value.trim();
  const passphrase = document.getElementById('sshKeyPassphrase')?.value || '';
  if (!name) { showToast(t('Please enter a key name'), 'error'); return; }

  // Map UI key type to API2 params
  const keyType = sshKeyType === 'ed25519' ? 'dsa' : 'rsa'; // cPanel API2 supports rsa/dsa
  const bits = sshKeyType === 'ed25519' ? 2048 : 4096;

  if (isLive) {
    try {
      // API2 SSH::genkey — generates key pair on server
      await CpanelAPI.call2('SSH', 'genkey', {
        name: name,
        pass: passphrase,
        type: keyType,
        bits: bits
      });
      // Refresh key list from server
      await loadSSHKeysLive();
      closeSSHModal();
      renderTab();
      showToast(t('SSH key "{0}" generated', name));
      return;
    } catch (err) {
      showToast(t('Failed: {0}', err.message), 'error');
      return;
    }
  }

  const fp = 'SHA256:' + btoa(name + Date.now()).substring(0, 12) + '...' + btoa(name).substring(0, 4);
  secData.sshKeys.push({
    name,
    type: sshKeyType === 'ed25519' ? 'ED25519' : 'RSA 4096',
    fingerprint: fp,
    added: new Date().toISOString().split('T')[0],
    authorized: true
  });

  closeSSHModal();
  renderTab();
  showToast(t('SSH key generated'));
}


// ===================================================================
// EVENT BINDING
// ===================================================================

function bindEvents() {
  document.querySelectorAll('#mainTabs .detail-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#mainTabs .detail-tab').forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      activeTab = tab.dataset.tab;
      renderTab();
    });
  });
}


// Close modals on backdrop click
document.getElementById('tokenModal').addEventListener('click', function(e) { if (e.target === this) closeTokenModal(); });
document.getElementById('sshModal').addEventListener('click', function(e) { if (e.target === this) closeSSHModal(); });

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closeTokenModal(); closeSSHModal(); }
});

// Init
init();
</script>
[% END %]
