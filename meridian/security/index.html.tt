    el.innerHTML = `${subTabsHtml}
      <div style="display:flex; gap: var(--space-2); margin-bottom: var(--space-4);">
        <button class="btn btn-primary btn-sm" onclick="openSSHModal()"><i class="ri-add-line" aria-hidden="true"></i> ${t('Generate Key')}</button>
        <button class="btn btn-secondary btn-sm" onclick="importSSHKey()"><i class="ri-upload-2-line" aria-hidden="true"></i> ${t('Import Key')}</button>
      </div>
