function renderAccessTab(el) {
  const subTabsHtml = `
    <div class="tab-switcher" style="margin-bottom: var(--space-5);">
      <button type="button" class="tab-switcher-btn ${activeAccessSub === 'ssh' ? 'active' : ''}" onclick="switchAccessSub('ssh')">${t('SSH Access')}</button>
      <button type="button" class="tab-switcher-btn ${activeAccessSub === 'password' ? 'active' : ''}" onclick="switchAccessSub('password')">${t('Password & Authentication')}</button>
    </div>`;

  if (activeAccessSub === 'ssh') {
    const keys = secData.sshKeys;
    const rows = keys.map((k, i) => `
      <div class="sec-row ssh-cols">
        <div class="cell cell-bold" style="display:flex; align-items:center; gap: var(--space-2);">
          <i class="ri-key-2-line" aria-hidden="true" style="color: var(--feature-color);"></i> ${escapeHtml(k.name)}
